#!/bin/bash
set -euo pipefail

STATE_FILE="${STATE_FILE:-/run/warpi/state.json}"
CONFIG_FILE="${CONFIG_FILE:-/etc/warpi/kernel.conf}"
KERNEL_SERVICE="${KERNEL_SERVICE:-warpi-kernel.service}"
FIELD_PROFILE="${FIELD_PROFILE:-WARPi-Field}"
FIELD_MARKER="${FIELD_MARKER:-/tmp/warpi_fieldmode}"
NANO_INTERFACE="${NANO_INTERFACE:-eth1}"
NANO_HOST="${NANO_HOST:-172.16.42.1}"
NANO_UI_PORT="${NANO_UI_PORT:-1471}"
TRANSITION_LOCK_FILE="${TRANSITION_LOCK_FILE:-/run/warpi/mode-transition.lock}"
TRANSITION_STATE_FILE="${TRANSITION_STATE_FILE:-/run/warpi/mode-transition-state.json}"
TRANSITION_CURRENT_FILE="${TRANSITION_CURRENT_FILE:-/run/warpi/mode-transition-current.json}"
TRANSITION_RECOVERY_DIR="${TRANSITION_RECOVERY_DIR:-/var/lib/warpi/mode-transitions}"
TRANSITION_ROLLBACK_FILE="${TRANSITION_ROLLBACK_FILE:-/var/lib/warpi/mode-transitions/rollback-plan.json}"
TRANSITION_PENDING_FILE="${TRANSITION_PENDING_FILE:-/var/lib/warpi/mode-transitions/pending-transition.json}"
TRANSITION_LAST_PREFLIGHT_FILE="${TRANSITION_LAST_PREFLIGHT_FILE:-/var/lib/warpi/mode-transitions/last-preflight.json}"
TRANSITION_SIMULATION_LOCK_FILE="${TRANSITION_SIMULATION_LOCK_FILE:-/run/warpi/mode-simulation.lock}"
TRANSITION_LAST_SIMULATION_FILE="${TRANSITION_LAST_SIMULATION_FILE:-/var/lib/warpi/mode-transitions/last-simulation.json}"
TRANSITION_APPLY_GATE="apply mode is disabled until transaction execution, rollback, boot recovery, and staged live tests are approved"
EXECUTOR_BACKEND="simulation"
LIVE_EXECUTOR_ENABLED="NO"
LIVE_EXECUTOR_FEATURE_FLAG="disabled"
EXECUTOR_ARM_FILE="${EXECUTOR_ARM_FILE:-/run/warpi/mode-executor.arm}"
EXECUTOR_RECOVERY_STATUS_FILE="${EXECUTOR_RECOVERY_STATUS_FILE:-/run/warpi/mode-recovery-status.json}"
EXECUTOR_CHECKPOINT_SCHEMA_VERSION="2"
EXECUTOR_WATCHDOG_LOST_THRESHOLD="${EXECUTOR_WATCHDOG_LOST_THRESHOLD:-3}"
ASSESSMENT_RADIO_APPROVED_VIDPID="${ASSESSMENT_RADIO_APPROVED_VIDPID:-0e8d:7612}"
ASSESSMENT_RADIO_APPROVED_DRIVER="${ASSESSMENT_RADIO_APPROVED_DRIVER:-mt76x2u}"
ASSESSMENT_RADIO_APPROVED_MAC="${ASSESSMENT_RADIO_APPROVED_MAC:-9c:ef:d5:f8:98:83}"

config_value() {
    local key="$1"
    local fallback="$2"

    if [[ -r "$CONFIG_FILE" ]]; then
        awk -F= -v key="$key" '
            $1 == key {
                value = $2
                gsub(/^"/, "", value)
                gsub(/"$/, "", value)
                print value
                found = 1
                exit
            }
            END {
                if (!found) {
                    exit 1
                }
            }
        ' "$CONFIG_FILE" 2>/dev/null || printf '%s\n' "$fallback"
    else
        printf '%s\n' "$fallback"
    fi
}

json_value() {
    local expression="$1"
    local fallback="${2:-unknown}"

    jq -r "$expression // \"$fallback\"" "$STATE_FILE"
}

json_bool() {
    local expression="$1"

    if [[ "$(jq -r "$expression // false" "$STATE_FILE")" == "true" ]]; then
        echo "YES"
    else
        echo "NO"
    fi
}

usage() {
    cat <<'EOF'

WARPi command menu

Usage:
  warpi help
  warpi status
  warpi mode status
  warpi mode transition-status
  warpi mode preflight enter-field
  warpi mode preflight return-normal
  warpi mode rollback-plan
	  warpi mode simulate enter-field
	  warpi mode simulate return-normal
	  warpi mode simulate-status
	  warpi mode executor-status
	  warpi mode recovery-status
	  warpi mode watchdog-status
	  warpi mode adapters
	  warpi mode test-fixtures
	  warpi mission status
  warpi mission check-in
  warpi mode enter-field
  warpi mode return-normal
  warpi wireless status
  warpi field health
  warpi field setup
  warpi report
  warpi docs audit

Commands:
  help              Show this menu.
  status            Show full WARPi K.E.R.N.E.L. status.
  mode status       Show current NORMAL/FIELD mode state.
  mode transition-status
                    Show read-only mode-transition state, lock, and rollback status.
  mode preflight enter-field
                    Capture a non-mutating rollback snapshot for a future Field transition.
  mode preflight return-normal
                    Capture a non-mutating rollback snapshot for a future Normal return.
  mode rollback-plan
                    Verify a rollback snapshot and preview recovery actions without executing them.
  mode simulate enter-field
                    Simulate staged NORMAL -> FIELD execution, checkpointing, and rollback.
  mode simulate return-normal
                    Simulate staged FIELD -> NORMAL execution, checkpointing, and rollback.
	  mode simulate-status
	                    Show latest simulation executor checkpoint/status.
	  mode executor-status
	                    Show Milestone E live-gate, arming, hardware, watchdog, and blockers.
	  mode recovery-status
	                    Show boot/interruption recovery recommendation without mutating state.
	  mode recovery-status --record
	                    Record startup recovery recommendation and clear stale live authorization only.
	  mode watchdog-status
	                    Show read-only management-path watchdog state.
	  mode adapters      List staged action adapters and their disabled live-execution status.
	  mode test-fixtures Run non-mutating Milestone E fixture tests.
  mission status   Show Mission Control endpoint/auth/check-in status.
  mission check-in Send a bounded Mission Control heartbeat payload when reachable.
  mode enter-field  Show the Field Mode transition plan without changing state.
  mode return-normal Show the Normal Mode transition plan without changing state.
  wireless status   Show read-only WiFi Pineapple NANO sidecar reachability.
  field health      Show field-mode network and service health.
  field setup       Prepare field-mode networking/firewall support.
  report            Emit kernel-report JSON.
  docs audit        Emit kernel-doc-audit JSON.

Mode switching:
  enter-field and return-normal are dry-run only. Apply mode is intentionally not enabled yet.
  transition-status is read-only and supports --json for machine-readable output.
  preflight commands create rollback-snapshot metadata but do not change network state or mode.
  rollback-plan is preview-only and supports --transaction ID and --json.
	  simulate commands are simulation-only. Milestone E live adapters exist only behind a disabled hard gate.

Mission Control:
  mission status and check-in are bounded best-effort operations. Mission Control
  failure does not block local WARPi operation.

Wireless:
  wireless status is read-only. It does not start scans, change radios, or modify NANO state.
EOF
}

require_state() {
    if [[ ! -r "$STATE_FILE" ]]; then
        echo "WARPi state is unavailable: $STATE_FILE" >&2
        systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true
        exit 1
    fi
}

transition_lock_file() {
    printf '%s\n' "${WARPI_TRANSITION_LOCK_FILE:-$TRANSITION_LOCK_FILE}"
}

transition_state_file() {
    printf '%s\n' "${WARPI_TRANSITION_STATE_FILE:-$TRANSITION_STATE_FILE}"
}

transition_current_file() {
    printf '%s\n' "${WARPI_TRANSITION_CURRENT_FILE:-$TRANSITION_CURRENT_FILE}"
}

transition_rollback_file() {
    printf '%s\n' "${WARPI_TRANSITION_ROLLBACK_FILE:-$TRANSITION_ROLLBACK_FILE}"
}

transition_pending_file() {
    printf '%s\n' "${WARPI_TRANSITION_PENDING_FILE:-$TRANSITION_PENDING_FILE}"
}

transition_last_preflight_file() {
    printf '%s\n' "${WARPI_TRANSITION_LAST_PREFLIGHT_FILE:-$TRANSITION_LAST_PREFLIGHT_FILE}"
}

transition_simulation_lock_file() {
    printf '%s\n' "${WARPI_TRANSITION_SIMULATION_LOCK_FILE:-$TRANSITION_SIMULATION_LOCK_FILE}"
}

transition_last_simulation_file() {
    printf '%s\n' "${WARPI_TRANSITION_LAST_SIMULATION_FILE:-$TRANSITION_LAST_SIMULATION_FILE}"
}

transition_state_allowed() {
    case "$1" in
        IDLE|PREPARING|VALIDATING|READY|APPLYING|VERIFYING|COMPLETED|ROLLING_BACK|ROLLED_BACK|FAILED)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

transition_direction_allowed() {
    case "$1" in
        ""|"none"|"NORMAL_TO_FIELD"|"FIELD_TO_NORMAL"|"NORMAL -> FIELD"|"FIELD -> NORMAL")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

transition_active_state() {
    case "$1" in
        PREPARING|VALIDATING|READY|APPLYING|VERIFYING|ROLLING_BACK)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

transition_file_status() {
    local path="$1"

    if [[ -L "$path" ]]; then
        echo "unsafe-symlink"
    elif [[ -e "$path" ]]; then
        echo "present"
    else
        echo "absent"
    fi
}

transition_json_value() {
    local file="$1"
    local expression="$2"
    local fallback="${3:-none}"

    jq -r "$expression // \"$fallback\"" "$file" 2>/dev/null || printf '%s\n' "$fallback"
}

transition_status_values() {
    require_state

    local lock_file state_file current_file rollback_file pending_file last_preflight_file
    local mode state_file_status current_file_status rollback_status pending_status lock_status
    local transition_state transition_active direction transition_id source_mode target_mode
    local started_at updated_at completed_at failure_reason rollback_available
    local last_attempted last_completed last_result last_event validation_status blockers
    local apply_prereqs apply_eligible unsafe_reasons lock_detail
    local last_preflight_status last_preflight_id last_preflight_direction last_preflight_result
    local last_preflight_snapshot_path last_preflight_snapshot_valid last_preflight_blocker_count
    local last_preflight_warning_count last_preflight_completed_at last_preflight_stale
    local rollback_plan_path rollback_plan_status rollback_plan_result rollback_plan_action_count
    local rollback_plan_blockers rollback_plan_warnings rollback_plan_readiness rollback_plan_generated_at
    local last_simulation_file simulation_status simulation_id simulation_direction simulation_result
    local simulation_checkpoint simulation_rollback_required simulation_rollback_result simulation_backend
    local simulation_warnings simulation_blockers simulation_completed_at simulation_live_enabled

    lock_file="$(transition_lock_file)"
    state_file="$(transition_state_file)"
    current_file="$(transition_current_file)"
    rollback_file="$(transition_rollback_file)"
    pending_file="$(transition_pending_file)"
    last_preflight_file="$(transition_last_preflight_file)"
    last_simulation_file="$(transition_last_simulation_file)"
    mode="$(json_value '.mode')"

    lock_status="$(transition_file_status "$lock_file")"
    state_file_status="$(transition_file_status "$state_file")"
    current_file_status="$(transition_file_status "$current_file")"
    rollback_status="$(transition_file_status "$rollback_file")"
    pending_status="$(transition_file_status "$pending_file")"
    last_preflight_status="$(transition_file_status "$last_preflight_file")"

    transition_state="IDLE"
    transition_active="NO"
    direction="none"
    transition_id="none"
    source_mode="none"
    target_mode="none"
    started_at="none"
    updated_at="none"
    completed_at="none"
    failure_reason="none"
    rollback_available="NO"
    last_attempted="none"
    last_completed="none"
    last_result="none"
    last_event="none"
    validation_status="clean"
    blockers="none"
    unsafe_reasons=""
    lock_detail="none"
    last_preflight_id="none"
    last_preflight_direction="none"
    last_preflight_result="none"
    last_preflight_snapshot_path="none"
    last_preflight_snapshot_valid="NO"
    last_preflight_blocker_count="0"
    last_preflight_warning_count="0"
    last_preflight_completed_at="none"
    last_preflight_stale="unknown"
    rollback_plan_path="none"
    rollback_plan_status="absent"
    rollback_plan_result="none"
    rollback_plan_action_count="0"
    rollback_plan_blockers="0"
    rollback_plan_warnings="0"
    rollback_plan_readiness="none"
    rollback_plan_generated_at="none"
    simulation_status="$(transition_file_status "$last_simulation_file")"
    simulation_id="none"
    simulation_direction="none"
    simulation_result="none"
    simulation_checkpoint="none"
    simulation_rollback_required="false"
    simulation_rollback_result="none"
    simulation_backend="$EXECUTOR_BACKEND"
    simulation_warnings="0"
    simulation_blockers="0"
    simulation_completed_at="none"
    simulation_live_enabled="$LIVE_EXECUTOR_ENABLED"

    if [[ "$lock_status" == "unsafe-symlink" ]]; then
        unsafe_reasons="${unsafe_reasons}lock path is a symlink; "
        lock_detail="unsafe symlink"
    elif [[ "$lock_status" == "present" ]]; then
        lock_detail="$(head -n 1 "$lock_file" 2>/dev/null || echo unreadable)"
    fi

    if [[ "$state_file_status" == "unsafe-symlink" || "$current_file_status" == "unsafe-symlink" ]]; then
        unsafe_reasons="${unsafe_reasons}transition metadata path is a symlink; "
    fi
    if [[ "$simulation_status" == "unsafe-symlink" ]]; then
        unsafe_reasons="${unsafe_reasons}last simulation path is a symlink; "
        validation_status="unsafe"
    elif [[ "$simulation_status" == "present" ]]; then
        if jq -e . "$last_simulation_file" >/dev/null 2>&1; then
            simulation_id="$(transition_json_value "$last_simulation_file" '.simulation_id' 'none')"
            simulation_direction="$(transition_json_value "$last_simulation_file" '.direction' 'none')"
            simulation_result="$(transition_json_value "$last_simulation_file" '.result' 'none')"
            simulation_checkpoint="$(transition_json_value "$last_simulation_file" '.last_checkpoint' 'none')"
            simulation_rollback_required="$(transition_json_value "$last_simulation_file" '.rollback_required' 'false')"
            simulation_rollback_result="$(transition_json_value "$last_simulation_file" '.rollback_result' 'none')"
            simulation_backend="$(transition_json_value "$last_simulation_file" '.backend' "$EXECUTOR_BACKEND")"
            simulation_warnings="$(transition_json_value "$last_simulation_file" '.warning_count' '0')"
            simulation_blockers="$(transition_json_value "$last_simulation_file" '.blocker_count' '0')"
            simulation_completed_at="$(transition_json_value "$last_simulation_file" '.completed_at' 'none')"
        else
            unsafe_reasons="${unsafe_reasons}last simulation JSON is malformed; "
            validation_status="unsafe"
        fi
    fi
    if [[ "$last_preflight_status" == "unsafe-symlink" ]]; then
        unsafe_reasons="${unsafe_reasons}last preflight path is a symlink; "
        validation_status="unsafe"
    elif [[ "$last_preflight_status" == "present" ]]; then
        if jq -e . "$last_preflight_file" >/dev/null 2>&1; then
            last_preflight_id="$(transition_json_value "$last_preflight_file" '.transition_id' 'none')"
            last_preflight_direction="$(transition_json_value "$last_preflight_file" '.transition_direction' 'none')"
            last_preflight_result="$(transition_json_value "$last_preflight_file" '.validation_result' 'none')"
            last_preflight_snapshot_path="$(transition_json_value "$last_preflight_file" '.snapshot_path' 'none')"
            last_preflight_snapshot_valid="$(transition_json_value "$last_preflight_file" '.rollback_snapshot_valid' 'false')"
            last_preflight_blocker_count="$(transition_json_value "$last_preflight_file" '.blocker_count' '0')"
            last_preflight_warning_count="$(transition_json_value "$last_preflight_file" '.warning_count' '0')"
            last_preflight_completed_at="$(transition_json_value "$last_preflight_file" '.completed_at' 'none')"
            last_preflight_stale="$(transition_json_value "$last_preflight_file" '.stale' 'false')"
            if [[ "$last_preflight_id" != "none" ]]; then
                rollback_plan_path="$(transition_preflight_paths "$last_preflight_id")/rollback-plan.json"
                rollback_plan_status="$(transition_file_status "$rollback_plan_path")"
                if [[ "$rollback_plan_status" == "present" ]]; then
                    if jq -e . "$rollback_plan_path" >/dev/null 2>&1; then
                        rollback_plan_result="$(transition_json_value "$rollback_plan_path" '.verifier.result' 'none')"
                        rollback_plan_action_count="$(transition_json_value "$rollback_plan_path" '.recovery_plan.action_count' '0')"
                        rollback_plan_blockers="$(transition_json_value "$rollback_plan_path" '.verifier.blocker_count' '0')"
                        rollback_plan_warnings="$(transition_json_value "$rollback_plan_path" '.verifier.warning_count' '0')"
                        rollback_plan_readiness="$(transition_json_value "$rollback_plan_path" '.recovery_readiness' 'none')"
                        rollback_plan_generated_at="$(transition_json_value "$rollback_plan_path" '.generated_at' 'none')"
                    else
                        unsafe_reasons="${unsafe_reasons}rollback plan JSON is malformed; "
                        validation_status="unsafe"
                    fi
                fi
            fi
        else
            unsafe_reasons="${unsafe_reasons}last preflight JSON is malformed; "
            validation_status="unsafe"
        fi
    fi

    if [[ "$state_file_status" == "present" ]]; then
        if jq -e . "$state_file" >/dev/null 2>&1; then
            transition_state="$(transition_json_value "$state_file" '.state' 'IDLE')"
            direction="$(transition_json_value "$state_file" '.direction' 'none')"
            transition_id="$(transition_json_value "$state_file" '.transition_id' 'none')"
            source_mode="$(transition_json_value "$state_file" '.source_mode' 'none')"
            target_mode="$(transition_json_value "$state_file" '.target_mode' 'none')"
            started_at="$(transition_json_value "$state_file" '.started_at' 'none')"
            updated_at="$(transition_json_value "$state_file" '.updated_at' 'none')"
            completed_at="$(transition_json_value "$state_file" '.completed_at' 'none')"
            failure_reason="$(transition_json_value "$state_file" '.failure_reason' 'none')"
            rollback_available="$(transition_json_value "$state_file" '.rollback_available' 'false')"
            last_attempted="$(transition_json_value "$state_file" '.last_attempted_transition' "$direction")"
            last_completed="$(transition_json_value "$state_file" '.last_completed_transition' 'none')"
            last_result="$(transition_json_value "$state_file" '.last_result' 'none')"
            last_event="$(transition_json_value "$state_file" '.last_event_at' "$updated_at")"
        else
            unsafe_reasons="${unsafe_reasons}transition state JSON is malformed; "
            transition_state="UNKNOWN"
            validation_status="unsafe"
        fi
    fi

    if [[ "$current_file_status" == "present" ]]; then
        if jq -e . "$current_file" >/dev/null 2>&1; then
            if [[ "$transition_id" == "none" ]]; then
                transition_id="$(transition_json_value "$current_file" '.transition_id' 'none')"
            fi
            if [[ "$direction" == "none" ]]; then
                direction="$(transition_json_value "$current_file" '.direction' 'none')"
            fi
        else
            unsafe_reasons="${unsafe_reasons}current transaction JSON is malformed; "
            validation_status="unsafe"
        fi
    fi

    if ! transition_state_allowed "$transition_state"; then
        unsafe_reasons="${unsafe_reasons}unknown transition state '$transition_state'; "
        validation_status="unsafe"
    fi
    if ! transition_direction_allowed "$direction"; then
        unsafe_reasons="${unsafe_reasons}unknown transition direction '$direction'; "
        validation_status="unsafe"
    fi
    if [[ "$direction" == "NORMAL_TO_FIELD" || "$direction" == "NORMAL -> FIELD" ]]; then
        if [[ "$source_mode" != "none" && "$source_mode" != "NORMAL" ]]; then
            unsafe_reasons="${unsafe_reasons}direction/source mode contradiction; "
            validation_status="unsafe"
        fi
        if [[ "$target_mode" != "none" && "$target_mode" != "FIELD" ]]; then
            unsafe_reasons="${unsafe_reasons}direction/target mode contradiction; "
            validation_status="unsafe"
        fi
    fi
    if [[ "$direction" == "FIELD_TO_NORMAL" || "$direction" == "FIELD -> NORMAL" ]]; then
        if [[ "$source_mode" != "none" && "$source_mode" != "FIELD" ]]; then
            unsafe_reasons="${unsafe_reasons}direction/source mode contradiction; "
            validation_status="unsafe"
        fi
        if [[ "$target_mode" != "none" && "$target_mode" != "NORMAL" ]]; then
            unsafe_reasons="${unsafe_reasons}direction/target mode contradiction; "
            validation_status="unsafe"
        fi
    fi

    if transition_active_state "$transition_state" || [[ "$lock_status" == "present" || "$current_file_status" == "present" || "$pending_status" == "present" ]]; then
        transition_active="YES"
    fi

    case "$rollback_available" in
        true|TRUE|yes|YES)
            rollback_available="YES"
            ;;
        *)
            if [[ "$rollback_status" == "present" ]]; then
                rollback_available="YES"
            else
                rollback_available="NO"
            fi
            ;;
    esac

    if [[ "$lock_status" == "present" ]]; then
        blockers="transition lock exists"
    elif [[ "$validation_status" == "unsafe" ]]; then
        blockers="$unsafe_reasons"
    else
        blockers="apply execution not implemented"
    fi

    apply_prereqs="partial: status, lock, transaction, and rollback metadata framework present; mutating executor and staged recovery tests missing"
    apply_eligible="NO"

    jq -n \
        --arg mode "$mode" \
        --arg state "$transition_state" \
        --arg active "$transition_active" \
        --arg direction "$direction" \
        --arg transition_id "$transition_id" \
        --arg source_mode "$source_mode" \
        --arg target_mode "$target_mode" \
        --arg started_at "$started_at" \
        --arg updated_at "$updated_at" \
        --arg completed_at "$completed_at" \
        --arg failure_reason "$failure_reason" \
        --arg last_attempted "$last_attempted" \
        --arg last_completed "$last_completed" \
        --arg last_result "$last_result" \
        --arg last_event "$last_event" \
        --arg lock_status "$lock_status" \
        --arg lock_detail "$lock_detail" \
        --arg lock_file "$lock_file" \
        --arg state_file "$state_file" \
        --arg current_file "$current_file" \
        --arg rollback_status "$rollback_status" \
        --arg rollback_file "$rollback_file" \
        --arg pending_status "$pending_status" \
        --arg pending_file "$pending_file" \
        --arg last_preflight_status "$last_preflight_status" \
        --arg last_preflight_file "$last_preflight_file" \
        --arg last_preflight_id "$last_preflight_id" \
        --arg last_preflight_direction "$last_preflight_direction" \
        --arg last_preflight_result "$last_preflight_result" \
        --arg last_preflight_snapshot_path "$last_preflight_snapshot_path" \
        --arg last_preflight_snapshot_valid "$last_preflight_snapshot_valid" \
        --arg last_preflight_blocker_count "$last_preflight_blocker_count" \
        --arg last_preflight_warning_count "$last_preflight_warning_count" \
        --arg last_preflight_completed_at "$last_preflight_completed_at" \
        --arg last_preflight_stale "$last_preflight_stale" \
        --arg rollback_plan_path "$rollback_plan_path" \
        --arg rollback_plan_status "$rollback_plan_status" \
        --arg rollback_plan_result "$rollback_plan_result" \
        --arg rollback_plan_action_count "$rollback_plan_action_count" \
        --arg rollback_plan_blockers "$rollback_plan_blockers" \
        --arg rollback_plan_warnings "$rollback_plan_warnings" \
        --arg rollback_plan_readiness "$rollback_plan_readiness" \
        --arg rollback_plan_generated_at "$rollback_plan_generated_at" \
        --arg simulation_status "$simulation_status" \
        --arg simulation_file "$last_simulation_file" \
        --arg simulation_id "$simulation_id" \
        --arg simulation_direction "$simulation_direction" \
        --arg simulation_result "$simulation_result" \
        --arg simulation_checkpoint "$simulation_checkpoint" \
        --arg simulation_rollback_required "$simulation_rollback_required" \
        --arg simulation_rollback_result "$simulation_rollback_result" \
        --arg simulation_backend "$simulation_backend" \
        --arg simulation_warnings "$simulation_warnings" \
        --arg simulation_blockers "$simulation_blockers" \
        --arg simulation_completed_at "$simulation_completed_at" \
        --arg simulation_live_enabled "$simulation_live_enabled" \
        --arg rollback_available "$rollback_available" \
        --arg validation_status "$validation_status" \
        --arg blockers "$blockers" \
        --arg apply_gate "$TRANSITION_APPLY_GATE" \
        --arg apply_prereqs "$apply_prereqs" \
        --arg apply_eligible "$apply_eligible" \
        '{
          schema_version: 1,
          mode: $mode,
          transition: {
            state: $state,
            active: $active,
            direction: $direction,
            transition_id: $transition_id,
            source_mode: $source_mode,
            target_mode: $target_mode,
            started_at: $started_at,
            updated_at: $updated_at,
            completed_at: $completed_at,
            failure_reason: $failure_reason,
            last_attempted_transition: $last_attempted,
            last_completed_transition: $last_completed,
            last_result: $last_result,
            last_event_at: $last_event
          },
          lock: {
            status: $lock_status,
            detail: $lock_detail,
            path: $lock_file
          },
          metadata: {
            state_path: $state_file,
            current_transaction_path: $current_file,
            pending_path: $pending_file,
            pending_status: $pending_status
          },
          preflight: {
            status: $last_preflight_status,
            path: $last_preflight_file,
            last_transaction_id: $last_preflight_id,
            last_direction: $last_preflight_direction,
            last_result: $last_preflight_result,
            snapshot_path: $last_preflight_snapshot_path,
            snapshot_valid: $last_preflight_snapshot_valid,
            blocker_count: $last_preflight_blocker_count,
            warning_count: $last_preflight_warning_count,
            completed_at: $last_preflight_completed_at,
            stale: $last_preflight_stale
          },
          rollback: {
            available: $rollback_available,
            status: $rollback_status,
            path: $rollback_file
          },
          rollback_plan: {
            status: $rollback_plan_status,
            path: $rollback_plan_path,
            verifier_result: $rollback_plan_result,
            action_count: $rollback_plan_action_count,
            blocker_count: $rollback_plan_blockers,
            warning_count: $rollback_plan_warnings,
            readiness: $rollback_plan_readiness,
            generated_at: $rollback_plan_generated_at
          },
          executor: {
            backend: $simulation_backend,
            live_enabled: $simulation_live_enabled,
            last_simulation_status: $simulation_status,
            last_simulation_path: $simulation_file,
            last_simulation_id: $simulation_id,
            last_simulation_direction: $simulation_direction,
            last_simulation_result: $simulation_result,
            last_checkpoint: $simulation_checkpoint,
            rollback_required: $simulation_rollback_required,
            rollback_result: $simulation_rollback_result,
            warning_count: $simulation_warnings,
            blocker_count: $simulation_blockers,
            completed_at: $simulation_completed_at
          },
          validation: {
            status: $validation_status,
            blockers: $blockers,
            future_apply_prerequisites: $apply_prereqs,
            future_apply_eligible: $apply_eligible,
            apply_gate: $apply_gate
          }
        }'
}

transition_status_json() {
    transition_status_values
}

transition_status() {
    local status_json="$1"

    echo
    echo "============================================================"
    echo "          WARPi MODE TRANSITION STATUS"
    echo "============================================================"
    echo
    printf "%-32s %s\n" "Current WARPi mode:" "$(jq -r '.mode' <<<"$status_json")"
    printf "%-32s %s\n" "Current transition state:" "$(jq -r '.transition.state' <<<"$status_json")"
    printf "%-32s %s\n" "Transition active:" "$(jq -r '.transition.active' <<<"$status_json")"
    printf "%-32s %s\n" "Direction:" "$(jq -r '.transition.direction' <<<"$status_json")"
    printf "%-32s %s\n" "Transaction ID:" "$(jq -r '.transition.transition_id' <<<"$status_json")"
    printf "%-32s %s\n" "Source mode:" "$(jq -r '.transition.source_mode' <<<"$status_json")"
    printf "%-32s %s\n" "Target mode:" "$(jq -r '.transition.target_mode' <<<"$status_json")"
    printf "%-32s %s\n" "Last attempted:" "$(jq -r '.transition.last_attempted_transition' <<<"$status_json")"
    printf "%-32s %s\n" "Last completed:" "$(jq -r '.transition.last_completed_transition' <<<"$status_json")"
    printf "%-32s %s\n" "Last result:" "$(jq -r '.transition.last_result' <<<"$status_json")"
    printf "%-32s %s\n" "Last event:" "$(jq -r '.transition.last_event_at' <<<"$status_json")"
    echo
    printf "%-32s %s\n" "Lock status:" "$(jq -r '.lock.status' <<<"$status_json")"
    printf "%-32s %s\n" "Lock detail:" "$(jq -r '.lock.detail' <<<"$status_json")"
    printf "%-32s %s\n" "Lock path:" "$(jq -r '.lock.path' <<<"$status_json")"
    printf "%-32s %s\n" "State metadata path:" "$(jq -r '.metadata.state_path' <<<"$status_json")"
    printf "%-32s %s\n" "Current transaction path:" "$(jq -r '.metadata.current_transaction_path' <<<"$status_json")"
    printf "%-32s %s\n" "Pending metadata:" "$(jq -r '.metadata.pending_status' <<<"$status_json")"
    printf "%-32s %s\n" "Pending metadata path:" "$(jq -r '.metadata.pending_path' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback metadata:" "$(jq -r '.rollback.status' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback available:" "$(jq -r '.rollback.available' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback metadata path:" "$(jq -r '.rollback.path' <<<"$status_json")"
    echo
    printf "%-32s %s\n" "Last preflight:" "$(jq -r '.preflight.status' <<<"$status_json")"
    printf "%-32s %s\n" "Last preflight ID:" "$(jq -r '.preflight.last_transaction_id' <<<"$status_json")"
    printf "%-32s %s\n" "Last preflight direction:" "$(jq -r '.preflight.last_direction' <<<"$status_json")"
    printf "%-32s %s\n" "Last preflight result:" "$(jq -r '.preflight.last_result' <<<"$status_json")"
    printf "%-32s %s\n" "Snapshot valid:" "$(jq -r '.preflight.snapshot_valid' <<<"$status_json")"
    printf "%-32s %s\n" "Snapshot path:" "$(jq -r '.preflight.snapshot_path' <<<"$status_json")"
    printf "%-32s %s\n" "Preflight blockers:" "$(jq -r '.preflight.blocker_count' <<<"$status_json")"
    printf "%-32s %s\n" "Preflight warnings:" "$(jq -r '.preflight.warning_count' <<<"$status_json")"
    printf "%-32s %s\n" "Preflight completed:" "$(jq -r '.preflight.completed_at' <<<"$status_json")"
    printf "%-32s %s\n" "Preflight stale:" "$(jq -r '.preflight.stale' <<<"$status_json")"
    echo
    printf "%-32s %s\n" "Rollback plan:" "$(jq -r '.rollback_plan.status' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback plan path:" "$(jq -r '.rollback_plan.path' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback verifier:" "$(jq -r '.rollback_plan.verifier_result' <<<"$status_json")"
    printf "%-32s %s\n" "Recovery action count:" "$(jq -r '.rollback_plan.action_count' <<<"$status_json")"
    printf "%-32s %s\n" "Recovery blockers:" "$(jq -r '.rollback_plan.blocker_count' <<<"$status_json")"
    printf "%-32s %s\n" "Recovery warnings:" "$(jq -r '.rollback_plan.warning_count' <<<"$status_json")"
    printf "%-32s %s\n" "Recovery readiness:" "$(jq -r '.rollback_plan.readiness' <<<"$status_json")"
    printf "%-32s %s\n" "Plan generated:" "$(jq -r '.rollback_plan.generated_at' <<<"$status_json")"
    echo
    printf "%-32s %s\n" "Executor backend:" "$(jq -r '.executor.backend' <<<"$status_json")"
    printf "%-32s %s\n" "Live executor enabled:" "$(jq -r '.executor.live_enabled' <<<"$status_json")"
    printf "%-32s %s\n" "Last simulation:" "$(jq -r '.executor.last_simulation_status' <<<"$status_json")"
    printf "%-32s %s\n" "Last simulation ID:" "$(jq -r '.executor.last_simulation_id' <<<"$status_json")"
    printf "%-32s %s\n" "Last simulation direction:" "$(jq -r '.executor.last_simulation_direction' <<<"$status_json")"
    printf "%-32s %s\n" "Last simulation result:" "$(jq -r '.executor.last_simulation_result' <<<"$status_json")"
    printf "%-32s %s\n" "Last checkpoint:" "$(jq -r '.executor.last_checkpoint' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback required:" "$(jq -r '.executor.rollback_required' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback result:" "$(jq -r '.executor.rollback_result' <<<"$status_json")"
    printf "%-32s %s\n" "Simulation blockers:" "$(jq -r '.executor.blocker_count' <<<"$status_json")"
    printf "%-32s %s\n" "Simulation warnings:" "$(jq -r '.executor.warning_count' <<<"$status_json")"
    echo
    printf "%-32s %s\n" "Validation status:" "$(jq -r '.validation.status' <<<"$status_json")"
    printf "%-32s %s\n" "Future apply eligible:" "$(jq -r '.validation.future_apply_eligible' <<<"$status_json")"
    printf "%-32s %s\n" "Future apply prerequisites:" "$(jq -r '.validation.future_apply_prerequisites' <<<"$status_json")"
    printf "%-32s %s\n" "Apply gate:" "$(jq -r '.validation.apply_gate' <<<"$status_json")"
    printf "%-32s %s\n" "Blockers:" "$(jq -r '.validation.blockers' <<<"$status_json")"
    echo
    echo "============================================================"
}

transition_dry_run_summary() {
    local direction="$1"
    local source_mode="$2"
    local target_mode="$3"
    local status_json lock_status active validation blockers eligible

    status_json="$(transition_status_values)"
    lock_status="$(jq -r '.lock.status' <<<"$status_json")"
    active="$(jq -r '.transition.active' <<<"$status_json")"
    validation="$(jq -r '.validation.status' <<<"$status_json")"
    blockers="$(jq -r '.validation.blockers' <<<"$status_json")"
    eligible="$(jq -r '.validation.future_apply_eligible' <<<"$status_json")"

    echo
    echo "TRANSITION FRAMEWORK"
    echo "------------------------------------------------------------"
    printf "%-22s %s\n" "Direction:" "$direction"
    printf "%-22s %s\n" "Intended source:" "$source_mode"
    printf "%-22s %s\n" "Intended target:" "$target_mode"
    printf "%-22s %s\n" "Current state:" "$(jq -r '.transition.state' <<<"$status_json")"
    printf "%-22s %s\n" "Transition active:" "$active"
    printf "%-22s %s\n" "Lock status:" "$lock_status"
    printf "%-22s %s\n" "Validation:" "$validation"
    printf "%-22s %s\n" "Future apply:" "$eligible"
    printf "%-22s %s\n" "Blockers:" "$blockers"
    echo "Dry run does not create, update, or clear transition metadata."
}

transition_recovery_dir() {
    printf '%s\n' "${WARPI_TRANSITION_RECOVERY_DIR:-$TRANSITION_RECOVERY_DIR}"
}

transition_read_group() {
    if getent group kernel-agent >/dev/null 2>&1; then
        echo "kernel-agent"
    else
        echo "root"
    fi
}

utc_now() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

generate_transition_id() {
    printf 'tx-%s-%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
}

require_json_object_file() {
    local path="$1"

    [[ -f "$path" ]] && jq -e 'type == "object"' "$path" >/dev/null 2>&1
}

ensure_control_path() {
    local path="$1"
    local parent

    parent="$(dirname "$path")"
    if [[ -L "$path" || -L "$parent" ]]; then
        echo "unsafe symlink path: $path" >&2
        return 1
    fi
}

atomic_write_json() {
    local path="$1"
    local mode="${2:-600}"
    local owner="${3:-root}"
    local group="${4:-root}"
    local parent tmp

    parent="$(dirname "$path")"
    ensure_control_path "$path"
    if [[ ! -d "$parent" ]]; then
        install -d -o "$owner" -g "$group" -m 750 "$parent"
    fi
    tmp="$(mktemp "$parent/.${path##*/}.XXXXXX")"
    cat > "$tmp"
    jq -e . "$tmp" >/dev/null
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        install -o "$owner" -g "$group" -m "$mode" "$tmp" "$path"
    else
        install -m "$mode" "$tmp" "$path"
    fi
    rm -f "$tmp"
}

preflight_add_finding() {
    local file="$1"
    local level="$2"
    local code="$3"
    local message="$4"

    jq -nc --arg level "$level" --arg code "$code" --arg message "$message" \
        '{level: $level, code: $code, message: $message}' >> "$file"
}

preflight_count_findings() {
    local file="$1"
    local level="$2"

    if [[ ! -s "$file" ]]; then
        echo 0
        return
    fi
    jq -s --arg level "$level" '[.[] | select(.level == $level)] | length' "$file"
}

preflight_findings_json() {
    local file="$1"

    if [[ ! -s "$file" ]]; then
        echo '[]'
        return
    fi
    jq -s '.' "$file"
}

command_json_or_empty() {
    "$@" 2>/dev/null || true
}

command_text_or_empty() {
    "$@" 2>/dev/null || true
}

transition_preflight_paths() {
    local transition_id="$1"
    local recovery_dir

    recovery_dir="$(transition_recovery_dir)"
    printf '%s/%s\n' "$recovery_dir" "$transition_id"
}

transition_acquire_lock() {
    local transition_id="$1"
    local operation="$2"
    local lock_file

    lock_file="$(transition_lock_file)"
    ensure_control_path "$lock_file"
    if [[ ! -d "$(dirname "$lock_file")" ]]; then
        install -d -o root -g root -m 755 "$(dirname "$lock_file")"
    fi
    if ( set -o noclobber; printf 'transition_id=%s operation=%s pid=%s started_at=%s\n' "$transition_id" "$operation" "$$" "$(utc_now)" > "$lock_file" ) 2>/dev/null; then
        chmod 600 "$lock_file"
        return 0
    fi
    return 1
}

transition_release_lock() {
    local transition_id="$1"
    local lock_file
    lock_file="$(transition_lock_file)"

    if [[ -f "$lock_file" ]] && grep -q "transition_id=$transition_id" "$lock_file" 2>/dev/null; then
        rm -f "$lock_file"
    fi
}

transition_write_state() {
    local state="$1"
    local transition_id="$2"
    local direction="$3"
    local source_mode="$4"
    local target_mode="$5"
    local started_at="$6"
    local completed_at="${7:-none}"
    local result="${8:-in-progress}"
    local state_file current_file

    state_file="$(transition_state_file)"
    current_file="$(transition_current_file)"
    jq -n \
        --arg state "$state" \
        --arg transition_id "$transition_id" \
        --arg direction "$direction" \
        --arg source_mode "$source_mode" \
        --arg target_mode "$target_mode" \
        --arg started_at "$started_at" \
        --arg updated_at "$(utc_now)" \
        --arg completed_at "$completed_at" \
        --arg result "$result" \
        '{
          state: $state,
          direction: $direction,
          transition_id: $transition_id,
          source_mode: $source_mode,
          target_mode: $target_mode,
          started_at: $started_at,
          updated_at: $updated_at,
          completed_at: $completed_at,
          failure_reason: "none",
          rollback_available: false,
          last_attempted_transition: $direction,
          last_completed_transition: (if $state == "IDLE" then $direction else "none" end),
          last_result: $result,
          last_event_at: $updated_at
        }' | atomic_write_json "$state_file" 640 root "$(transition_read_group)"

    if [[ "$state" == "IDLE" ]]; then
        rm -f "$current_file"
    else
        jq -n \
            --arg transition_id "$transition_id" \
            --arg operation_type "preflight" \
            --arg direction "$direction" \
            --arg source_mode "$source_mode" \
            --arg target_mode "$target_mode" \
            --arg state "$state" \
            --arg started_at "$started_at" \
            --arg updated_at "$(utc_now)" \
            '{
              transition_id: $transition_id,
              operation_type: $operation_type,
              direction: $direction,
              source_mode: $source_mode,
              target_mode: $target_mode,
              state: $state,
              started_at: $started_at,
              updated_at: $updated_at
            }' | atomic_write_json "$current_file" 640 root "$(transition_read_group)"
    fi
}

preflight_capture_snapshot() {
    local transition_id="$1"
    local direction="$2"
    local source_mode="$3"
    local target_mode="$4"
    local findings_file="$5"
    local snapshot_path="$6"
    local captured_at hostname os_name kernel_release architecture warpi_mode warpi_state
    local wifi_profile wifi_ssid active_iface default_route default_iface dns_info nm_active
    local tailscale_service tailscale_backend tailscale_ip ts_management
    local nano_ping nano_ui default_uses_sidecar firewall_impl firewall_state
    local root_percent available_kb extra_wifi hardware_json hardware_ready hardware_eligibility hardware_iface hardware_phy hardware_driver hardware_mac hardware_usb hardware_nm_state
    local warpi_kernel_state networkmanager_state ssh_state gpsd_state warpi_ui_state kismet_state
    local field_marker_present addresses_json routes_json

    captured_at="$(utc_now)"
    hostname="$(hostname 2>/dev/null || echo unknown)"
    os_name="$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-unknown}" || echo unknown)"
    kernel_release="$(uname -r 2>/dev/null || echo unknown)"
    architecture="$(uname -m 2>/dev/null || echo unknown)"
    warpi_mode="$(json_value '.mode' 'unknown')"
    warpi_state="$(json_value '.state' 'unknown')"
    wifi_profile="$(json_value '.network.wifi_profile' 'unknown')"
    wifi_ssid="$(json_value '.network.wifi_ssid' 'unknown')"
    active_iface="$(json_value '.network.interface' 'unknown')"
    default_route="$(ip route show default 2>/dev/null | head -n 1 || true)"
    default_iface="$(awk '{for (i = 1; i <= NF; i++) if ($i == "dev") print $(i + 1)}' <<<"$default_route" | head -n 1)"
    dns_info="$(command_text_or_empty resolvectl dns)"
    nm_active="$(command_text_or_empty nmcli -t -f NAME,UUID,TYPE,DEVICE connection show --active)"
    tailscale_service="$(systemctl is-active tailscaled.service 2>/dev/null || true)"
    tailscale_backend="$(command_json_or_empty tailscale status --json | jq -r '.BackendState // "unknown"' 2>/dev/null || echo unknown)"
    tailscale_ip="$(command_json_or_empty tailscale status --json | jq -r '.Self.TailscaleIPs[0] // "unknown"' 2>/dev/null || echo unknown)"
    root_percent="$(df -P / | awk 'NR == 2 {print $5}' 2>/dev/null || echo unknown)"
    available_kb="$(df -Pk / | awk 'NR == 2 {print $4}' 2>/dev/null || echo 0)"
    warpi_kernel_state="$(systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true)"
    networkmanager_state="$(systemctl is-active NetworkManager.service 2>/dev/null || true)"
    ssh_state="$(systemctl is-active ssh.service 2>/dev/null || true)"
    gpsd_state="$(systemctl is-active gpsd.service 2>/dev/null || true)"
    warpi_ui_state="$(systemctl is-active warpi-ui.service 2>/dev/null || true)"
    kismet_state="$(systemctl is-active kismet.service 2>/dev/null || true)"
    field_marker_present="$([[ -e "$FIELD_MARKER" ]] && echo true || echo false)"
    addresses_json="$(command_json_or_empty ip -j addr show | jq -c . 2>/dev/null || echo '[]')"
    routes_json="$(command_json_or_empty ip -j route show | jq -c . 2>/dev/null || echo '[]')"
    extra_wifi="$(find /sys/class/net -maxdepth 1 -type l -printf '%f\n' 2>/dev/null | grep -E '^(wl|wlan)' | grep -v '^wlan0$' | head -n 1 || true)"
    hardware_json="$(executor_gate_json 2>/dev/null | jq -c '.hardware // {}' 2>/dev/null || echo '{}')"
    if ! jq -e . >/dev/null 2>&1 <<<"$hardware_json"; then
        hardware_json="$(sed 's/}}$/}/' <<<"$hardware_json" | jq -c . 2>/dev/null || echo '{}')"
    fi
    hardware_ready="$(jq -r '.ready // false' <<<"$hardware_json" 2>/dev/null || echo false)"
    hardware_eligibility="$(jq -r '.eligibility // "unknown"' <<<"$hardware_json" 2>/dev/null || echo unknown)"
    hardware_iface="$(jq -r '.assessment_radio.interface // "none"' <<<"$hardware_json" 2>/dev/null || echo none)"
    hardware_phy="$(jq -r '.assessment_radio.phy // "none"' <<<"$hardware_json" 2>/dev/null || echo none)"
    hardware_driver="$(jq -r '.assessment_radio.driver // "none"' <<<"$hardware_json" 2>/dev/null || echo none)"
    hardware_mac="$(jq -r '.assessment_radio.mac // "none"' <<<"$hardware_json" 2>/dev/null || echo none)"
    hardware_usb="$(jq -r '.assessment_radio.usb_id // "none"' <<<"$hardware_json" 2>/dev/null || echo none)"
    hardware_nm_state="$(jq -r '.assessment_radio.networkmanager_state // "none"' <<<"$hardware_json" 2>/dev/null || echo none)"

    if ping -c 1 -W 2 "$NANO_HOST" >/dev/null 2>&1; then
        nano_ping="true"
    else
        nano_ping="false"
    fi
    if timeout 4 bash -c ":</dev/tcp/$NANO_HOST/$NANO_UI_PORT" >/dev/null 2>&1; then
        nano_ui="true"
    else
        nano_ui="false"
    fi
    if [[ "$default_iface" == "$NANO_INTERFACE" ]]; then
        default_uses_sidecar="true"
    else
        default_uses_sidecar="false"
    fi
    if command -v nft >/dev/null 2>&1; then
        firewall_impl="nftables"
        firewall_state="$(command_text_or_empty nft list tables)"
    elif command -v iptables-save >/dev/null 2>&1; then
        firewall_impl="iptables"
        firewall_state="$(command_text_or_empty iptables-save -t filter | sed -n '1,80p')"
    else
        firewall_impl="unknown"
        firewall_state=""
    fi
    if [[ "$tailscale_backend" == "Running" && "$tailscale_ip" != "unknown" ]]; then
        ts_management="true"
    else
        ts_management="false"
    fi

    [[ "$warpi_mode" == "$source_mode" ]] || preflight_add_finding "$findings_file" "BLOCK" "source-mode-mismatch" "Live mode is $warpi_mode but requested source is $source_mode."
    [[ -n "$default_route" ]] || preflight_add_finding "$findings_file" "BLOCK" "missing-default-route" "Default route is unavailable."
    [[ -n "$default_iface" ]] || preflight_add_finding "$findings_file" "BLOCK" "missing-default-interface" "Default route interface could not be identified."
    [[ "$ts_management" == "true" ]] || preflight_add_finding "$findings_file" "BLOCK" "tailscale-unavailable" "Tailscale management path is not visibly running."
    [[ "$tailscale_service" == "active" ]] || preflight_add_finding "$findings_file" "BLOCK" "tailscale-service-inactive" "tailscaled.service is not active."
    [[ "$warpi_kernel_state" == "active" ]] || preflight_add_finding "$findings_file" "BLOCK" "warpi-kernel-inactive" "$KERNEL_SERVICE is not active."
    [[ "$networkmanager_state" == "active" ]] || preflight_add_finding "$findings_file" "BLOCK" "networkmanager-inactive" "NetworkManager.service is not active."
    [[ "$ssh_state" == "active" ]] || preflight_add_finding "$findings_file" "BLOCK" "ssh-inactive" "ssh.service is not active."
    [[ "$default_uses_sidecar" == "false" ]] || preflight_add_finding "$findings_file" "BLOCK" "sidecar-default-route" "Default route uses the sidecar interface."
    [[ "$nano_ping" == "true" ]] || preflight_add_finding "$findings_file" "WARN" "nano-ping-unreachable" "NANO sidecar ping is not reachable."
    [[ "$nano_ui" == "true" ]] || preflight_add_finding "$findings_file" "WARN" "nano-ui-unreachable" "NANO UI TCP port is not reachable."
    [[ -e /sys/class/net/"$NANO_INTERFACE" ]] || preflight_add_finding "$findings_file" "WARN" "nano-interface-missing" "Configured NANO interface is not present."
    [[ "$hardware_ready" == "true" ]] || preflight_add_finding "$findings_file" "WARN" "external-wifi-not-validated" "Approved external assessment Wi-Fi radio is not positively validated."
    [[ "${available_kb:-0}" -gt 102400 ]] || preflight_add_finding "$findings_file" "BLOCK" "low-root-disk-space" "Root filesystem has less than 100 MB available."

    jq -n \
        --arg schema_version "1" \
        --arg transition_id "$transition_id" \
        --arg captured_at "$captured_at" \
        --arg source_mode "$source_mode" \
        --arg target_mode "$target_mode" \
        --arg direction "$direction" \
        --arg hostname "$hostname" \
        --arg os_name "$os_name" \
        --arg kernel_release "$kernel_release" \
        --arg architecture "$architecture" \
        --arg warpi_mode "$warpi_mode" \
        --arg warpi_state "$warpi_state" \
        --arg field_marker "$FIELD_MARKER" \
        --arg wifi_profile "$wifi_profile" \
        --arg wifi_ssid "$wifi_ssid" \
        --arg active_iface "$active_iface" \
        --arg default_route "$default_route" \
        --arg default_iface "$default_iface" \
        --arg dns_info "$dns_info" \
        --arg nm_active "$nm_active" \
        --arg tailscale_service "$tailscale_service" \
        --arg tailscale_backend "$tailscale_backend" \
        --arg tailscale_ip "$tailscale_ip" \
        --arg ts_management "$ts_management" \
        --arg firewall_impl "$firewall_impl" \
        --arg firewall_state "$firewall_state" \
        --arg nano_interface "$NANO_INTERFACE" \
        --arg nano_host "$NANO_HOST" \
        --arg nano_port "$NANO_UI_PORT" \
        --arg nano_ping "$nano_ping" \
        --arg nano_ui "$nano_ui" \
        --arg default_uses_sidecar "$default_uses_sidecar" \
        --arg root_percent "$root_percent" \
        --arg state_file "$STATE_FILE" \
        --arg warpi_kernel_state "$warpi_kernel_state" \
        --arg networkmanager_state "$networkmanager_state" \
        --arg ssh_state "$ssh_state" \
        --arg gpsd_state "$gpsd_state" \
        --arg warpi_ui_state "$warpi_ui_state" \
        --arg kismet_state "$kismet_state" \
        --arg field_marker_present "$field_marker_present" \
        --argjson addresses "${addresses_json:-[]}" \
        --argjson routes "${routes_json:-[]}" \
        --arg hardware_ready "$hardware_ready" \
        --arg hardware_eligibility "$hardware_eligibility" \
        --arg hardware_iface "$hardware_iface" \
        --arg hardware_phy "$hardware_phy" \
        --arg hardware_driver "$hardware_driver" \
        --arg hardware_mac "$hardware_mac" \
        --arg hardware_usb "$hardware_usb" \
        --arg hardware_nm_state "$hardware_nm_state" \
        '{
          schema_version: ($schema_version | tonumber),
          transition_id: $transition_id,
          captured_at: $captured_at,
          source_mode: $source_mode,
          target_mode: $target_mode,
          transition_direction: $direction,
          system: {
            hostname: $hostname,
            os: $os_name,
            kernel: $kernel_release,
            architecture: $architecture,
            root_disk_used_percent: $root_percent
          },
          warpi: {
            mode: $warpi_mode,
            state: $warpi_state,
            state_file: $state_file,
            field_marker_path: $field_marker,
            field_marker_present: ($field_marker_present == "true")
          },
          network: {
            manager: "NetworkManager",
            active_connection: $wifi_profile,
            ssid: $wifi_ssid,
            interface: $active_iface,
            addresses: $addresses,
            default_route: $default_route,
            default_interface: $default_iface,
            relevant_routes: $routes,
            dns: $dns_info,
            active_connections: $nm_active
          },
          tailscale: {
            service_state: $tailscale_service,
            backend_state: $tailscale_backend,
            tailnet_ip: $tailscale_ip,
            management_path_present: ($ts_management == "true")
          },
          firewall: {
            implementation: $firewall_impl,
            snapshot_reference_or_safe_state: $firewall_state
          },
          services: {
            warpi_kernel: $warpi_kernel_state,
            tailscaled: $tailscale_service,
            networkmanager: $networkmanager_state,
            ssh: $ssh_state,
            gpsd: $gpsd_state,
            warpi_ui: $warpi_ui_state,
            kismet: $kismet_state
          },
          sidecar: {
            interface: $nano_interface,
            management_path: $nano_host,
            ui_port: ($nano_port | tonumber),
            nano_reachable: ($nano_ping == "true"),
            ui_port_reachable: ($nano_ui == "true"),
            default_route_uses_sidecar: ($default_uses_sidecar == "true")
          },
          hardware: {
            ready: ($hardware_ready == "true"),
            eligibility: $hardware_eligibility,
            approved_identity: {
              usb_id: "0e8d:7612",
              driver: "mt76x2u",
              mac: "9c:ef:d5:f8:98:83"
            },
            assessment_radio: {
              interface: $hardware_iface,
              phy: $hardware_phy,
              driver: $hardware_driver,
              mac: $hardware_mac,
              usb_id: $hardware_usb,
              networkmanager_state: $hardware_nm_state,
              role: "assessment"
            },
            management_radio: {
              interface: "wlan0",
              role: "management"
            },
            nano_sidecar: {
              interface: $nano_interface,
              role: "sidecar"
            }
          },
          validation: {
            snapshot_complete: false,
            missing_fields: [],
            warnings: []
          },
          secret_exclusion: {
            captured_credentials: false,
            excluded: ["wifi_psk", "tailscale_auth_keys", "api_tokens", "private_keys", "pineapple_credentials", "environment_secrets"]
          }
        }' > "$snapshot_path"
}

preflight_validate_snapshot() {
    local snapshot_path="$1"
    local findings_file="$2"
    local missing_file="$3"

    : > "$missing_file"
    require_json_object_file "$snapshot_path" || {
        preflight_add_finding "$findings_file" "BLOCK" "snapshot-malformed" "Rollback snapshot is not valid JSON object."
        return
    }

    local required=(
        '.schema_version'
        '.transition_id'
        '.captured_at'
        '.source_mode'
        '.target_mode'
        '.network.active_connection'
        '.network.interface'
        '.network.default_route'
        '.network.addresses'
        '.tailscale.service_state'
        '.tailscale.tailnet_ip'
        '.services.warpi_kernel'
        '.services.ssh'
        '.sidecar.default_route_uses_sidecar'
        '.hardware.eligibility'
    )
    local expr
    for expr in "${required[@]}"; do
        if ! jq -e "$expr != null and $expr != \"\"" "$snapshot_path" >/dev/null; then
            echo "$expr" >> "$missing_file"
        fi
    done

    if [[ -s "$missing_file" ]]; then
        preflight_add_finding "$findings_file" "BLOCK" "snapshot-incomplete" "Rollback snapshot is missing required fields."
    fi

    if jq -e 'any(.. | strings; test("(?i)(BEGIN .*PRIVATE|PRIVATE KEY|Authorization:|Bearer |password=|psk=|token=|secret=)"))' "$snapshot_path" >/dev/null; then
        preflight_add_finding "$findings_file" "BLOCK" "snapshot-secret-pattern" "Rollback snapshot contains a credential-like pattern."
    fi
}

transition_preflight() {
    local action="$1"
    local output_format="${2:-human}"
    local source_mode target_mode direction live_mode transition_id started_at completed_at tx_dir
    local findings_file missing_file snapshot_tmp snapshot_path summary_path transaction_path
    local blockers warnings validation_result snapshot_valid snapshot_complete apply_eligible stale

    require_state

    case "$action" in
        enter-field)
            source_mode="NORMAL"
            target_mode="FIELD"
            direction="NORMAL_TO_FIELD"
            ;;
        return-normal)
            source_mode="FIELD"
            target_mode="NORMAL"
            direction="FIELD_TO_NORMAL"
            ;;
        *)
            echo "Unknown preflight command: $action" >&2
            echo "Try: warpi mode preflight enter-field" >&2
            exit 2
            ;;
    esac

    if [[ "${EUID:-$(id -u)}" -ne 0 && "$(transition_recovery_dir)" != /tmp/* ]]; then
        if sudo -n true 2>/dev/null; then
            if [[ "$output_format" == "json" || "$output_format" == "--json" ]]; then
                exec sudo -n "$0" mode preflight "$action" --json
            fi
            exec sudo -n "$0" mode preflight "$action"
        fi
        echo "warpi mode preflight requires root or passwordless sudo for protected metadata writes." >&2
        exit 1
    fi

    live_mode="$(json_value '.mode' 'unknown')"
    transition_id="$(generate_transition_id)"
    started_at="$(utc_now)"
    tx_dir="$(transition_preflight_paths "$transition_id")"
    findings_file="$(mktemp)"
    missing_file="$(mktemp)"
    snapshot_tmp="$(mktemp)"
    snapshot_path="$tx_dir/rollback-snapshot.json"
    transaction_path="$tx_dir/transaction.json"
    summary_path="$(transition_last_preflight_file)"
    mkdir -p "$tx_dir"
    chown root:"$(transition_read_group)" "$tx_dir" 2>/dev/null || true
    chmod 750 "$tx_dir"

    if ! transition_acquire_lock "$transition_id" "preflight-$action"; then
        preflight_add_finding "$findings_file" "BLOCK" "transition-lock-present" "A transition lock already exists; refusing conflicting preflight."
        completed_at="$(utc_now)"
        validation_result="BLOCK"
        blockers="$(preflight_count_findings "$findings_file" "BLOCK")"
        warnings="$(preflight_count_findings "$findings_file" "WARN")"
        jq -n \
            --arg transition_id "$transition_id" \
            --arg direction "$direction" \
            --arg source_mode "$source_mode" \
            --arg target_mode "$target_mode" \
            --arg started_at "$started_at" \
            --arg completed_at "$completed_at" \
            --arg validation_result "$validation_result" \
            --arg blockers "$blockers" \
            --arg warnings "$warnings" \
            --argjson findings "$(preflight_findings_json "$findings_file")" \
            '{schema_version: 1, transition_id: $transition_id, operation_type: "preflight", transition_direction: $direction, source_mode: $source_mode, target_mode: $target_mode, state: "FAILED", started_at: $started_at, completed_at: $completed_at, validation_result: $validation_result, blocker_count: ($blockers|tonumber), warning_count: ($warnings|tonumber), rollback_snapshot_present: false, rollback_snapshot_valid: false, apply_eligible: false, failure_reason: "transition lock exists", findings: $findings}' |
            atomic_write_json "$summary_path" 640 root "$(transition_read_group)"
        transition_preflight_report "$summary_path" "$output_format"
        exit 2
    fi
    trap "transition_release_lock '$transition_id'; rm -f '$findings_file' '$missing_file' '$snapshot_tmp'" EXIT

    transition_write_state "PREPARING" "$transition_id" "$direction" "$source_mode" "$target_mode" "$started_at"
    transition_write_state "VALIDATING" "$transition_id" "$direction" "$source_mode" "$target_mode" "$started_at"

    local status_json transition_active transition_validation
    status_json="$(transition_status_values)"
    transition_active="$(jq -r '.transition.active' <<<"$status_json")"
    transition_validation="$(jq -r '.validation.status' <<<"$status_json")"
    [[ "$live_mode" == "$source_mode" ]] || preflight_add_finding "$findings_file" "BLOCK" "live-mode-mismatch" "Live mode is $live_mode but requested source is $source_mode."
    [[ "$transition_validation" != "unsafe" ]] || preflight_add_finding "$findings_file" "BLOCK" "transition-framework-unsafe" "Transition framework reports unsafe metadata."
    [[ "$transition_active" == "YES" ]] || preflight_add_finding "$findings_file" "WARN" "preflight-lock-not-visible" "Preflight lock was not visible during validation."

    transition_write_state "READY" "$transition_id" "$direction" "$source_mode" "$target_mode" "$started_at"
    preflight_capture_snapshot "$transition_id" "$direction" "$source_mode" "$target_mode" "$findings_file" "$snapshot_tmp"
    preflight_validate_snapshot "$snapshot_tmp" "$findings_file" "$missing_file"

    blockers="$(preflight_count_findings "$findings_file" "BLOCK")"
    warnings="$(preflight_count_findings "$findings_file" "WARN")"
    if [[ "$blockers" -eq 0 ]]; then
        validation_result="PASS"
        snapshot_valid="true"
        snapshot_complete="true"
    else
        validation_result="BLOCK"
        snapshot_valid="false"
        snapshot_complete="false"
    fi
    apply_eligible="false"
    stale="false"
    completed_at="$(utc_now)"

    jq \
        --argjson complete "$snapshot_complete" \
        --argjson missing "$(jq -R -s 'split("\n") | map(select(length > 0))' "$missing_file")" \
        --argjson warnings_json "$(jq -s '[.[] | select(.level == "WARN")]' "$findings_file")" \
        '.validation.snapshot_complete = $complete | .validation.missing_fields = $missing | .validation.warnings = $warnings_json' \
        "$snapshot_tmp" | atomic_write_json "$snapshot_path" 640 root "$(transition_read_group)"

    jq -n \
        --arg transition_id "$transition_id" \
        --arg direction "$direction" \
        --arg source_mode "$source_mode" \
        --arg target_mode "$target_mode" \
        --arg started_at "$started_at" \
        --arg completed_at "$completed_at" \
        --arg validation_result "$validation_result" \
        --arg blockers "$blockers" \
        --arg warnings "$warnings" \
        --arg snapshot_path "$snapshot_path" \
        --arg transaction_path "$transaction_path" \
        --arg snapshot_valid "$snapshot_valid" \
        --arg stale "$stale" \
        --arg apply_gate "$TRANSITION_APPLY_GATE" \
        --argjson findings "$(preflight_findings_json "$findings_file")" \
        '{
          schema_version: 1,
          transition_id: $transition_id,
          operation_type: "preflight",
          state: "COMPLETED",
          transition_direction: $direction,
          source_mode: $source_mode,
          target_mode: $target_mode,
          started_at: $started_at,
          updated_at: $completed_at,
          completed_at: $completed_at,
          validation_result: $validation_result,
          blockers: $findings,
          blocker_count: ($blockers | tonumber),
          warning_count: ($warnings | tonumber),
          rollback_snapshot_present: true,
          rollback_snapshot_valid: ($snapshot_valid == "true"),
          snapshot_path: $snapshot_path,
          transaction_path: $transaction_path,
          apply_eligible: false,
          apply_gate: $apply_gate,
          stale: ($stale == "true"),
          failure_reason: (if $validation_result == "PASS" then "none" else "validation blocked" end)
        }' | atomic_write_json "$transaction_path" 640 root "$(transition_read_group)"

    atomic_write_json "$summary_path" 640 root "$(transition_read_group)" < "$transaction_path"
    transition_write_state "IDLE" "$transition_id" "$direction" "$source_mode" "$target_mode" "$started_at" "$completed_at" "preflight-$validation_result"
    transition_release_lock "$transition_id"
    transition_preflight_report "$transaction_path" "$output_format"
}

transition_preflight_report() {
    local transaction_path="$1"
    local output_format="${2:-human}"
    local snapshot_path

    if [[ "$output_format" == "--json" || "$output_format" == "json" ]]; then
        jq '.' "$transaction_path"
        return
    fi

    snapshot_path="$(jq -r '.snapshot_path // "none"' "$transaction_path")"
    echo
    echo "============================================================"
    echo "              WARPi MODE PREFLIGHT"
    echo "============================================================"
    echo
    echo "Non-mutating preflight. No network, route, service, mode, Tailscale, or NANO state was changed."
    echo
    printf "%-28s %s\n" "Transaction ID:" "$(jq -r '.transition_id' "$transaction_path")"
    printf "%-28s %s\n" "Operation:" "$(jq -r '.operation_type' "$transaction_path")"
    printf "%-28s %s\n" "Direction:" "$(jq -r '.transition_direction' "$transaction_path")"
    printf "%-28s %s\n" "Source mode:" "$(jq -r '.source_mode' "$transaction_path")"
    printf "%-28s %s\n" "Target mode:" "$(jq -r '.target_mode' "$transaction_path")"
    printf "%-28s %s\n" "State:" "$(jq -r '.state' "$transaction_path")"
    printf "%-28s %s\n" "Validation result:" "$(jq -r '.validation_result' "$transaction_path")"
    printf "%-28s %s\n" "Blockers:" "$(jq -r '.blocker_count' "$transaction_path")"
    printf "%-28s %s\n" "Warnings:" "$(jq -r '.warning_count' "$transaction_path")"
    printf "%-28s %s\n" "Snapshot present:" "$(jq -r '.rollback_snapshot_present' "$transaction_path")"
    printf "%-28s %s\n" "Snapshot valid:" "$(jq -r '.rollback_snapshot_valid' "$transaction_path")"
    printf "%-28s %s\n" "Snapshot path:" "$snapshot_path"
    printf "%-28s %s\n" "Started:" "$(jq -r '.started_at' "$transaction_path")"
    printf "%-28s %s\n" "Completed:" "$(jq -r '.completed_at' "$transaction_path")"
    printf "%-28s %s\n" "Future apply eligible:" "$(jq -r '.apply_eligible' "$transaction_path")"
    printf "%-28s %s\n" "Apply gate:" "$(jq -r '.apply_gate' "$transaction_path")"
    echo
    echo "FINDINGS"
    echo "------------------------------------------------------------"
    if [[ "$(jq -r '.blockers | length' "$transaction_path")" -eq 0 ]]; then
        echo "No validation findings."
    else
        jq -r '.blockers[] | "- [" + .level + "] " + .code + ": " + .message' "$transaction_path"
    fi
    echo
    echo "SNAPSHOT CATEGORIES"
    echo "------------------------------------------------------------"
    if [[ -f "$snapshot_path" ]]; then
        echo "system, warpi, network, tailscale, firewall, services, sidecar, validation, secret_exclusion"
    else
        echo "none"
    fi
    echo
    echo "============================================================"
}

plan_add_finding() {
    preflight_add_finding "$@"
}

plan_add_drift() {
    local file="$1"
    local classification="$2"
    local component="$3"
    local field="$4"
    local snapshot="$5"
    local current="$6"
    local message="$7"

    jq -nc \
        --arg classification "$classification" \
        --arg component "$component" \
        --arg field "$field" \
        --arg snapshot "$snapshot" \
        --arg current "$current" \
        --arg message "$message" \
        '{classification: $classification, component: $component, field: $field, snapshot: $snapshot, current: $current, message: $message}' >> "$file"
}

plan_add_action() {
    local file="$1"
    local phase="$2"
    local component="$3"
    local current="$4"
    local desired="$5"
    local action="$6"
    local reason="$7"
    local risk="$8"
    local impact="$9"
    local verify="${10}"
    local command_preview="${11:-none}"

    local seq
    seq="$(($(wc -l < "$file" 2>/dev/null || echo 0) + 1))"
    jq -nc \
        --argjson sequence "$seq" \
        --arg phase "$phase" \
        --arg component "$component" \
        --arg current "$current" \
        --arg desired "$desired" \
        --arg action "$action" \
        --arg reason "$reason" \
        --arg risk "$risk" \
        --arg impact "$impact" \
        --arg verify "$verify" \
        --arg command_preview "$command_preview" \
        '{
          sequence: $sequence,
          phase: $phase,
          component: $component,
          current_state: $current,
          desired_state: $desired,
          proposed_action: $action,
          reason: $reason,
          risk_level: $risk,
          connectivity_impact: $impact,
          verification_required: ($verify == "true"),
          command_preview: $command_preview,
          command_status: "NOT EXECUTED"
        }' >> "$file"
}

snapshot_for_transaction() {
    local transaction_id="$1"
    local last_preflight

    if [[ -z "$transaction_id" || "$transaction_id" == "latest" ]]; then
        last_preflight="$(transition_last_preflight_file)"
        require_json_object_file "$last_preflight" || return 1
        jq -r '.snapshot_path // empty' "$last_preflight"
        return
    fi

    if [[ ! "$transaction_id" =~ ^tx-[0-9TZ]+-[0-9a-f]{12}$ ]]; then
        return 1
    fi
    printf '%s/%s/rollback-snapshot.json\n' "$(transition_recovery_dir)" "$transaction_id"
}

transaction_for_snapshot() {
    local snapshot_path="$1"
    printf '%s/transaction.json\n' "$(dirname "$snapshot_path")"
}

rollback_plan_for_snapshot() {
    local snapshot_path="$1"
    printf '%s/rollback-plan.json\n' "$(dirname "$snapshot_path")"
}

safe_file_metadata() {
    local path="$1"
    [[ -e "$path" && ! -L "$path" ]] || return 1
    local mode owner
    owner="$(stat -c '%U' "$path" 2>/dev/null || echo unknown)"
    mode="$(stat -c '%a' "$path" 2>/dev/null || echo 777)"
    if [[ "$(transition_recovery_dir)" == /tmp/* ]]; then
        [[ "$owner" == "$(id -un)" || "$owner" == "root" ]] || return 1
    else
        [[ "$owner" == "root" ]] || return 1
    fi
    [[ ${#mode} -ge 3 ]] || return 1
    local group_digit="${mode: -2:1}"
    local other_digit="${mode: -1}"
    [[ "$group_digit" != "2" && "$group_digit" != "3" && "$group_digit" != "6" && "$group_digit" != "7" ]] || return 1
    [[ "$other_digit" != "2" && "$other_digit" != "3" && "$other_digit" != "6" && "$other_digit" != "7" ]] || return 1
}

rollback_verify_snapshot() {
    local snapshot_path="$1"
    local findings_file="$2"
    local transaction_id_expected="${3:-}"
    local transaction_path

    if [[ -z "$snapshot_path" || ! -e "$snapshot_path" ]]; then
        plan_add_finding "$findings_file" "BLOCK" "snapshot-missing" "Rollback snapshot does not exist."
        return
    fi
    if [[ -L "$snapshot_path" ]]; then
        plan_add_finding "$findings_file" "BLOCK" "snapshot-symlink" "Rollback snapshot path is a symlink."
        return
    fi
    safe_file_metadata "$snapshot_path" || plan_add_finding "$findings_file" "BLOCK" "snapshot-permissions" "Rollback snapshot ownership or permissions are unsafe."
    require_json_object_file "$snapshot_path" || {
        plan_add_finding "$findings_file" "BLOCK" "snapshot-malformed" "Rollback snapshot is not valid JSON object."
        return
    }

    local schema transition_id source_mode target_mode direction host snapshot_valid
    schema="$(jq -r '.schema_version // "missing"' "$snapshot_path")"
    transition_id="$(jq -r '.transition_id // "missing"' "$snapshot_path")"
    source_mode="$(jq -r '.source_mode // "missing"' "$snapshot_path")"
    target_mode="$(jq -r '.target_mode // "missing"' "$snapshot_path")"
    direction="$(jq -r '.transition_direction // "missing"' "$snapshot_path")"
    host="$(jq -r '.system.hostname // "missing"' "$snapshot_path")"
    snapshot_valid="$(jq -r '.validation.snapshot_complete // false' "$snapshot_path")"

    [[ "$schema" == "1" ]] || plan_add_finding "$findings_file" "BLOCK" "unsupported-schema" "Rollback snapshot schema version is unsupported: $schema."
    [[ "$transition_id" =~ ^tx-[0-9TZ]+-[0-9a-f]{12}$ ]] || plan_add_finding "$findings_file" "BLOCK" "invalid-transaction-id" "Snapshot transition ID is invalid."
    [[ -z "$transaction_id_expected" || "$transition_id" == "$transaction_id_expected" ]] || plan_add_finding "$findings_file" "BLOCK" "transaction-id-mismatch" "Requested transaction ID does not match snapshot."
    [[ "$source_mode" == "NORMAL" || "$source_mode" == "FIELD" ]] || plan_add_finding "$findings_file" "BLOCK" "missing-source-mode" "Snapshot source mode is invalid."
    [[ "$target_mode" == "NORMAL" || "$target_mode" == "FIELD" ]] || plan_add_finding "$findings_file" "BLOCK" "missing-target-mode" "Snapshot target mode is invalid."
    [[ "$direction" == "NORMAL_TO_FIELD" || "$direction" == "FIELD_TO_NORMAL" ]] || plan_add_finding "$findings_file" "BLOCK" "invalid-direction" "Snapshot transition direction is invalid."
    [[ "$direction" != "NORMAL_TO_FIELD" || "$source_mode/$target_mode" == "NORMAL/FIELD" ]] || plan_add_finding "$findings_file" "BLOCK" "direction-mode-contradiction" "Snapshot direction contradicts source/target mode."
    [[ "$direction" != "FIELD_TO_NORMAL" || "$source_mode/$target_mode" == "FIELD/NORMAL" ]] || plan_add_finding "$findings_file" "BLOCK" "direction-mode-contradiction" "Snapshot direction contradicts source/target mode."
    [[ "$host" == "$(hostname 2>/dev/null || echo unknown)" ]] || plan_add_finding "$findings_file" "BLOCK" "hostname-mismatch" "Snapshot hostname does not match current host."
    [[ "$snapshot_valid" == "true" ]] || plan_add_finding "$findings_file" "BLOCK" "snapshot-incomplete" "Snapshot is not marked complete."

    local required=(
        '.network.active_connection'
        '.network.interface'
        '.network.default_route'
        '.network.default_interface'
        '.tailscale.service_state'
        '.tailscale.tailnet_ip'
        '.services.warpi_kernel'
        '.services.ssh'
        '.sidecar.interface'
        '.sidecar.management_path'
    )
    local expr
    for expr in "${required[@]}"; do
        jq -e "$expr != null and $expr != \"\"" "$snapshot_path" >/dev/null || plan_add_finding "$findings_file" "BLOCK" "missing-required-field" "Snapshot missing required field: $expr."
    done

    if jq -e 'any(.. | strings; test("(?i)(BEGIN .*PRIVATE|PRIVATE KEY|Authorization:|Bearer |password=|psk=|token=|secret=)"))' "$snapshot_path" >/dev/null; then
        plan_add_finding "$findings_file" "BLOCK" "snapshot-secret-pattern" "Snapshot contains a credential-like pattern."
    fi

    transaction_path="$(transaction_for_snapshot "$snapshot_path")"
    if [[ -f "$transaction_path" ]]; then
        require_json_object_file "$transaction_path" || plan_add_finding "$findings_file" "BLOCK" "transaction-malformed" "Transaction metadata is malformed."
        [[ "$(jq -r '.transition_id // empty' "$transaction_path" 2>/dev/null)" == "$transition_id" ]] || plan_add_finding "$findings_file" "BLOCK" "transaction-snapshot-mismatch" "Transaction metadata ID does not match snapshot."
        [[ "$(jq -r '.validation_result // empty' "$transaction_path" 2>/dev/null)" == "PASS" ]] || plan_add_finding "$findings_file" "BLOCK" "transaction-not-pass" "Transaction metadata does not record a PASS preflight."
    else
        plan_add_finding "$findings_file" "BLOCK" "transaction-missing" "Transaction metadata file is missing."
    fi
}

rollback_capture_current_json() {
    local out="$1"
    local default_route default_iface wifi_profile wifi_ssid active_iface tailscale_service tailscale_backend tailscale_ip nano_ping nano_ui default_uses_sidecar firewall_impl firewall_state
    local warpi_kernel_state networkmanager_state ssh_state gpsd_state warpi_ui_state kismet_state addresses_json routes_json

    default_route="$(ip route show default 2>/dev/null | head -n 1 || true)"
    default_iface="$(awk '{for (i = 1; i <= NF; i++) if ($i == "dev") print $(i + 1)}' <<<"$default_route" | head -n 1)"
    wifi_profile="$(json_value '.network.wifi_profile' 'unknown')"
    wifi_ssid="$(json_value '.network.wifi_ssid' 'unknown')"
    active_iface="$(json_value '.network.interface' 'unknown')"
    tailscale_service="$(systemctl is-active tailscaled.service 2>/dev/null || true)"
    tailscale_backend="$(command_json_or_empty tailscale status --json | jq -r '.BackendState // "unknown"' 2>/dev/null || echo unknown)"
    tailscale_ip="$(command_json_or_empty tailscale status --json | jq -r '.Self.TailscaleIPs[0] // "unknown"' 2>/dev/null || echo unknown)"
    if ping -c 1 -W 2 "$NANO_HOST" >/dev/null 2>&1; then nano_ping="true"; else nano_ping="false"; fi
    if timeout 4 bash -c ":</dev/tcp/$NANO_HOST/$NANO_UI_PORT" >/dev/null 2>&1; then nano_ui="true"; else nano_ui="false"; fi
    if [[ "$default_iface" == "$NANO_INTERFACE" ]]; then default_uses_sidecar="true"; else default_uses_sidecar="false"; fi
    warpi_kernel_state="$(systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true)"
    networkmanager_state="$(systemctl is-active NetworkManager.service 2>/dev/null || true)"
    ssh_state="$(systemctl is-active ssh.service 2>/dev/null || true)"
    gpsd_state="$(systemctl is-active gpsd.service 2>/dev/null || true)"
    warpi_ui_state="$(systemctl is-active warpi-ui.service 2>/dev/null || true)"
    kismet_state="$(systemctl is-active kismet.service 2>/dev/null || true)"
    addresses_json="$(command_json_or_empty ip -j addr show)"
    routes_json="$(command_json_or_empty ip -j route show)"
    if command -v nft >/dev/null 2>&1; then
        firewall_impl="nftables"
        firewall_state="$(command_text_or_empty nft list tables)"
    elif command -v iptables-save >/dev/null 2>&1; then
        firewall_impl="iptables"
        firewall_state="$(command_text_or_empty iptables-save -t filter | sed -n '1,80p')"
    else
        firewall_impl="unknown"
        firewall_state=""
    fi

    jq -n \
        --arg captured_at "$(utc_now)" \
        --arg hostname "$(hostname 2>/dev/null || echo unknown)" \
        --arg mode "$(json_value '.mode' 'unknown')" \
        --arg state "$(json_value '.state' 'unknown')" \
        --arg field_marker_present "$([[ -e "$FIELD_MARKER" ]] && echo true || echo false)" \
        --arg wifi_profile "$wifi_profile" \
        --arg wifi_ssid "$wifi_ssid" \
        --arg active_iface "$active_iface" \
        --arg default_route "$default_route" \
        --arg default_iface "$default_iface" \
        --arg dns_info "$(command_text_or_empty resolvectl dns)" \
        --arg tailscale_service "$tailscale_service" \
        --arg tailscale_backend "$tailscale_backend" \
        --arg tailscale_ip "$tailscale_ip" \
        --arg firewall_impl "$firewall_impl" \
        --arg firewall_state "$firewall_state" \
        --arg nano_interface "$NANO_INTERFACE" \
        --arg nano_host "$NANO_HOST" \
        --arg nano_port "$NANO_UI_PORT" \
        --arg nano_ping "$nano_ping" \
        --arg nano_ui "$nano_ui" \
        --arg default_uses_sidecar "$default_uses_sidecar" \
        --arg warpi_kernel_state "$warpi_kernel_state" \
        --arg networkmanager_state "$networkmanager_state" \
        --arg ssh_state "$ssh_state" \
        --arg gpsd_state "$gpsd_state" \
        --arg warpi_ui_state "$warpi_ui_state" \
        --arg kismet_state "$kismet_state" \
        --argjson addresses "${addresses_json:-[]}" \
        --argjson routes "${routes_json:-[]}" \
        '{
          captured_at: $captured_at,
          system: {hostname: $hostname},
          warpi: {mode: $mode, state: $state, field_marker_present: ($field_marker_present == "true")},
          network: {active_connection: $wifi_profile, ssid: $wifi_ssid, interface: $active_iface, addresses: $addresses, default_route: $default_route, default_interface: $default_iface, relevant_routes: $routes, dns: $dns_info},
          tailscale: {service_state: $tailscale_service, backend_state: $tailscale_backend, tailnet_ip: $tailscale_ip, management_path_present: ($tailscale_backend == "Running")},
          firewall: {implementation: $firewall_impl, snapshot_reference_or_safe_state: $firewall_state},
          services: {
            warpi_kernel: $warpi_kernel_state,
            tailscaled: $tailscale_service,
            networkmanager: $networkmanager_state,
            ssh: $ssh_state,
            gpsd: $gpsd_state,
            warpi_ui: $warpi_ui_state,
            kismet: $kismet_state
          },
          sidecar: {interface: $nano_interface, management_path: $nano_host, ui_port: ($nano_port|tonumber), nano_reachable: ($nano_ping == "true"), ui_port_reachable: ($nano_ui == "true"), default_route_uses_sidecar: ($default_uses_sidecar == "true")}
        }' > "$out"
}

compare_field() {
    local snapshot="$1" current="$2" drifts="$3" actions="$4" component="$5" field="$6" snapshot_expr="$7" current_expr="$8" phase="$9" action="${10}" risk="${11:-LOW}" impact="${12:-none}"
    local old new
    old="$(jq -r "$snapshot_expr // \"unknown\"" "$snapshot")"
    new="$(jq -r "$current_expr // \"unknown\"" "$current")"
    if [[ "$old" != "$new" ]]; then
        plan_add_drift "$drifts" "RESTORE_REQUIRED" "$component" "$field" "$old" "$new" "$component $field differs from rollback snapshot."
        plan_add_action "$actions" "$phase" "$component" "$new" "$old" "$action" "$component $field differs from rollback snapshot." "$risk" "$impact" "true" "preview only; exact command requires executor validation"
    else
        plan_add_drift "$drifts" "UNCHANGED" "$component" "$field" "$old" "$new" "$component $field matches rollback snapshot."
    fi
}

transition_rollback_plan() {
    local transaction_id="latest"
    local output_format="human"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --transaction)
                transaction_id="${2:-}"
                shift 2
                ;;
            --json)
                output_format="json"
                shift
                ;;
            --human)
                output_format="human"
                shift
                ;;
            *)
                echo "Unknown rollback-plan option: $1" >&2
                echo "Try: warpi mode rollback-plan --transaction <transition-id>" >&2
                exit 2
                ;;
        esac
    done

    require_state

    if [[ "${EUID:-$(id -u)}" -ne 0 && "$(transition_recovery_dir)" != /tmp/* ]]; then
        if sudo -n true 2>/dev/null; then
            local sudo_args=(mode rollback-plan)
            if [[ "$transaction_id" != "latest" ]]; then
                sudo_args+=(--transaction "$transaction_id")
            fi
            if [[ "$output_format" == "json" ]]; then
                sudo_args+=(--json)
            fi
            exec sudo -n "$0" "${sudo_args[@]}"
        fi
        echo "warpi mode rollback-plan requires root or passwordless sudo for protected plan metadata writes." >&2
        exit 1
    fi

    local snapshot_path transaction_id_actual plan_path findings drifts actions current_json blockers warnings action_count verifier readiness snapshot_hash generated_at
    snapshot_path="$(snapshot_for_transaction "$transaction_id")" || {
        echo "No valid rollback snapshot selected." >&2
        exit 2
    }
    transaction_id_actual="$(jq -r '.transition_id // empty' "$snapshot_path" 2>/dev/null || true)"
    findings="$(mktemp)"
    drifts="$(mktemp)"
    actions="$(mktemp)"
    current_json="$(mktemp)"
    trap "rm -f '$findings' '$drifts' '$actions' '$current_json'" EXIT

    rollback_verify_snapshot "$snapshot_path" "$findings" "${transaction_id/latest/}"
    rollback_capture_current_json "$current_json"
    snapshot_hash="$(sha256sum "$snapshot_path" 2>/dev/null | awk '{print $1}')"
    generated_at="$(utc_now)"

    if require_json_object_file "$snapshot_path"; then
        plan_add_action "$actions" "PHASE 0 - Validate recovery data" "Verifier" "snapshot selected" "verified snapshot" "Validate snapshot schema, ownership, permissions, transaction metadata, and secret exclusion." "Recovery input must be trustworthy before any future executor can act." "LOW" "none" "true" "warpi mode rollback-plan --transaction $transaction_id_actual"
        compare_field "$snapshot_path" "$current_json" "$drifts" "$actions" "WARPi mode" "mode" '.warpi.mode' '.warpi.mode' "PHASE 7 - Restore WARPi mode/control metadata" "Restore WARPi mode/control metadata to snapshot source state." "MEDIUM" "none until executor applies"
        compare_field "$snapshot_path" "$current_json" "$drifts" "$actions" "Network" "active connection" '.network.active_connection' '.network.active_connection' "PHASE 1 - Establish/confirm target uplink" "Confirm or restore the snapshot NetworkManager connection/profile." "HIGH" "management path sensitive"
        compare_field "$snapshot_path" "$current_json" "$drifts" "$actions" "Network" "default route" '.network.default_route' '.network.default_route' "PHASE 2 - Restore addressing/routes" "Restore default route only after target uplink is confirmed." "HIGH" "could affect management if executed out of order"
        compare_field "$snapshot_path" "$current_json" "$drifts" "$actions" "Tailscale" "backend" '.tailscale.backend_state' '.tailscale.backend_state' "PHASE 3 - Verify management connectivity" "Restore or verify Tailscale backend state." "HIGH" "management path"
        compare_field "$snapshot_path" "$current_json" "$drifts" "$actions" "Tailscale" "tailnet IP" '.tailscale.tailnet_ip' '.tailscale.tailnet_ip' "PHASE 3 - Verify management connectivity" "Verify Tailscale IP matches rollback snapshot or re-establish management path." "HIGH" "management path"
        compare_field "$snapshot_path" "$current_json" "$drifts" "$actions" "Firewall" "implementation" '.firewall.implementation' '.firewall.implementation' "PHASE 4 - Restore firewall policy" "Restore firewall implementation/policy reference." "MEDIUM" "could affect access if executed"
        compare_field "$snapshot_path" "$current_json" "$drifts" "$actions" "Sidecar" "default route isolation" '(.sidecar.default_route_uses_sidecar|tostring)' '(.sidecar.default_route_uses_sidecar|tostring)' "PHASE 5 - Restore sidecar isolation" "Ensure sidecar does not own the default route." "HIGH" "management route safety"
        for svc in warpi_kernel tailscaled networkmanager ssh gpsd warpi_ui kismet; do
            compare_field "$snapshot_path" "$current_json" "$drifts" "$actions" "Service" "$svc" ".services.$svc" ".services.$svc" "PHASE 6 - Restore service state" "Restore service state for $svc if executor later approves." "MEDIUM" "service dependent"
        done
        plan_add_action "$actions" "PHASE 8 - Final health verification" "Health" "not verified by executor" "NORMAL/CONNECTED with management path" "Run final health checks after any future recovery executor." "Recovery must not be marked complete before health verification." "LOW" "none" "true" "warpi mode status; warpi wireless status; warpi report"
    fi

    blockers="$(preflight_count_findings "$findings" "BLOCK")"
    warnings="$(preflight_count_findings "$findings" "WARN")"
    action_count="$(wc -l < "$actions" | tr -d ' ')"
    if [[ "$blockers" -eq 0 ]]; then
        verifier="PASS"
        readiness="READY_FOR_STAGED_EXECUTOR_DEVELOPMENT"
    else
        verifier="BLOCK"
        readiness="BLOCKED"
    fi
    plan_path="$(rollback_plan_for_snapshot "$snapshot_path")"

    jq -n \
        --arg generated_at "$generated_at" \
        --arg transaction_id "$transaction_id_actual" \
        --arg snapshot_path "$snapshot_path" \
        --arg snapshot_hash "$snapshot_hash" \
        --arg verifier "$verifier" \
        --arg blockers "$blockers" \
        --arg warnings "$warnings" \
        --arg action_count "$action_count" \
        --arg readiness "$readiness" \
        --argjson findings "$(preflight_findings_json "$findings")" \
        --argjson drift "$(preflight_findings_json "$drifts")" \
        --argjson actions_json "$(preflight_findings_json "$actions")" \
        '{
          schema_version: 1,
          generated_at: $generated_at,
          transaction_id: $transaction_id,
          snapshot_path: $snapshot_path,
          snapshot_sha256: $snapshot_hash,
          verifier: {
            result: $verifier,
            blocker_count: ($blockers|tonumber),
            warning_count: ($warnings|tonumber),
            findings: $findings
          },
          drift_analysis: $drift,
          recovery_plan: {
            generated: true,
            action_count: ($action_count|tonumber),
            actions: $actions_json,
            execution_status: "NOT EXECUTED"
          },
          recovery_readiness: $readiness,
          apply_gate: "rollback plan is preview-only; live apply remains disabled"
        }' | atomic_write_json "$plan_path" 640 root "$(transition_read_group)"

    if [[ "$output_format" == "json" ]]; then
        jq '.' "$plan_path"
        return
    fi
    rollback_plan_report "$plan_path"
}

rollback_plan_report() {
    local plan_path="$1"
    echo
    echo "============================================================"
    echo "              WARPi ROLLBACK PLAN"
    echo "============================================================"
    echo
    echo "Preview only. No recovery commands were executed."
    echo
    printf "%-28s %s\n" "Transaction ID:" "$(jq -r '.transaction_id' "$plan_path")"
    printf "%-28s %s\n" "Verifier result:" "$(jq -r '.verifier.result' "$plan_path")"
    printf "%-28s %s\n" "Snapshot path:" "$(jq -r '.snapshot_path' "$plan_path")"
    printf "%-28s %s\n" "Action count:" "$(jq -r '.recovery_plan.action_count' "$plan_path")"
    printf "%-28s %s\n" "Blockers:" "$(jq -r '.verifier.blocker_count' "$plan_path")"
    printf "%-28s %s\n" "Warnings:" "$(jq -r '.verifier.warning_count' "$plan_path")"
    printf "%-28s %s\n" "Readiness:" "$(jq -r '.recovery_readiness' "$plan_path")"
    printf "%-28s %s\n" "Plan path:" "$plan_path"
    echo
    echo "DRIFT ANALYSIS"
    echo "------------------------------------------------------------"
    jq -r '.drift_analysis[] | "- [" + .classification + "] " + .component + " " + .field + ": snapshot=" + .snapshot + " current=" + .current' "$plan_path"
    echo
    echo "RECOVERY ACTION PREVIEW - NOT EXECUTED"
    echo "------------------------------------------------------------"
    jq -r '.recovery_plan.actions[] | (.sequence|tostring) + ". " + .phase + " / " + .component + "\n   Current: " + .current_state + "\n   Desired: " + .desired_state + "\n   Action: " + .proposed_action + "\n   Risk: " + .risk_level + " | Connectivity: " + .connectivity_impact + "\n   Preview: " + .command_preview' "$plan_path"
    echo
    echo "============================================================"
}

generate_simulation_id() {
    printf 'sim-%s-%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
}

simulation_id_allowed() {
    [[ "$1" =~ ^sim-[0-9TZ]+-[0-9a-f]{12}$ ]]
}

simulation_paths() {
    local simulation_id="$1"
    printf '%s/%s\n' "$(transition_recovery_dir)" "$simulation_id"
}

simulation_checkpoint_path() {
    local simulation_id="$1"
    printf '%s/executor-checkpoint.json\n' "$(simulation_paths "$simulation_id")"
}

simulation_history_path() {
    local simulation_id="$1"
    printf '%s/simulation.json\n' "$(simulation_paths "$simulation_id")"
}

simulation_lock_acquire() {
    local simulation_id="$1"
    local lock_file
    lock_file="$(transition_simulation_lock_file)"
    ensure_control_path "$lock_file"
    if [[ ! -d "$(dirname "$lock_file")" ]]; then
        install -d -o root -g root -m 755 "$(dirname "$lock_file")"
    fi
    if ( set -o noclobber; printf 'simulation_id=%s backend=%s pid=%s started_at=%s\n' "$simulation_id" "$EXECUTOR_BACKEND" "$$" "$(utc_now)" > "$lock_file" ) 2>/dev/null; then
        chmod 600 "$lock_file"
        return 0
    fi
    return 1
}

simulation_lock_release() {
    local simulation_id="$1"
    local lock_file
    lock_file="$(transition_simulation_lock_file)"
    if [[ -f "$lock_file" ]] && grep -q "simulation_id=$simulation_id" "$lock_file" 2>/dev/null; then
        rm -f "$lock_file"
    fi
}

simulation_find_preflight() {
    local transaction_id="$1"
    if [[ -z "$transaction_id" || "$transaction_id" == "latest" ]]; then
        require_json_object_file "$(transition_last_preflight_file)" || return 1
        jq -r '.transition_id // empty' "$(transition_last_preflight_file)"
        return
    fi
    [[ "$transaction_id" =~ ^tx-[0-9TZ]+-[0-9a-f]{12}$ ]] || return 1
    printf '%s\n' "$transaction_id"
}

simulation_phase_requires_rollback() {
    case "$1" in
        validate|prepare-interface|prepare-profile)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

simulation_phase_json() {
    local direction="$1"
    if [[ "$direction" == "NORMAL_TO_FIELD" ]]; then
        jq -n '[
          {phase:"validate", order:0, component:"Verifier", description:"Validate transaction, snapshot, recovery plan, and safety invariants.", mutation_equivalent:false, risk:"LOW"},
          {phase:"prepare-interface", order:1, component:"Interface", description:"Prepare and select the future FIELD wireless interface.", mutation_equivalent:false, risk:"MEDIUM"},
          {phase:"prepare-profile", order:2, component:"NetworkManager", description:"Prepare the target FIELD NetworkManager profile.", mutation_equivalent:false, risk:"MEDIUM"},
          {phase:"prepare-routing", order:3, component:"Route", description:"Prepare route preference changes without applying them.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"prepare-firewall", order:4, component:"Firewall", description:"Prepare field firewall policy without applying it.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"verify-management", order:5, component:"Tailscale", description:"Verify management/recovery path would remain available.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"prepare-sidecar", order:6, component:"Sidecar", description:"Ensure NANO remains sidecar-only and never default route.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"prepare-services", order:7, component:"Services", description:"Prepare future field service state changes.", mutation_equivalent:true, risk:"MEDIUM"},
          {phase:"prepare-mode-metadata", order:8, component:"WARPi mode", description:"Prepare mode/control metadata update.", mutation_equivalent:true, risk:"MEDIUM"},
          {phase:"verify-target-health", order:9, component:"Health", description:"Verify target FIELD health before commit.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"commit", order:10, component:"Commit", description:"Commit final simulated FIELD transition.", mutation_equivalent:true, risk:"HIGH"}
        ]'
    else
        jq -n '[
          {phase:"validate", order:0, component:"Verifier", description:"Validate transaction, snapshot, recovery plan, and safety invariants.", mutation_equivalent:false, risk:"LOW"},
          {phase:"prepare-uplink", order:1, component:"NetworkManager", description:"Prepare restoration of original uplink/profile.", mutation_equivalent:false, risk:"MEDIUM"},
          {phase:"prepare-addressing", order:2, component:"Addressing", description:"Prepare source interface addressing restoration.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"prepare-routing", order:3, component:"Route", description:"Prepare default route restoration.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"verify-management", order:4, component:"Tailscale", description:"Verify management path remains available.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"prepare-firewall", order:5, component:"Firewall", description:"Prepare firewall policy restoration.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"prepare-sidecar", order:6, component:"Sidecar", description:"Ensure sidecar remains isolated.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"prepare-services", order:7, component:"Services", description:"Prepare service restoration.", mutation_equivalent:true, risk:"MEDIUM"},
          {phase:"prepare-mode-metadata", order:8, component:"WARPi mode", description:"Prepare NORMAL mode metadata restoration.", mutation_equivalent:true, risk:"MEDIUM"},
          {phase:"verify-target-health", order:9, component:"Health", description:"Verify target NORMAL health before commit.", mutation_equivalent:true, risk:"HIGH"},
          {phase:"commit", order:10, component:"Commit", description:"Commit final simulated NORMAL return.", mutation_equivalent:true, risk:"HIGH"}
        ]'
    fi
}

simulation_write_checkpoint() {
    local simulation_id="$1" source_preflight_id="$2" state="$3" phase="$4" last_action="$5" next_action="$6" rollback_required="$7" rollback_position="$8" result="$9"
    local checkpoint_path
    checkpoint_path="$(simulation_checkpoint_path "$simulation_id")"
    jq -n \
        --arg schema_version "1" \
        --arg simulation_id "$simulation_id" \
        --arg source_preflight_id "$source_preflight_id" \
        --arg state "$state" \
        --arg phase "$phase" \
        --arg last_action "$last_action" \
        --arg next_action "$next_action" \
        --arg timestamp "$(utc_now)" \
        --arg rollback_required "$rollback_required" \
        --arg rollback_position "$rollback_position" \
        --arg result "$result" \
        '{
          schema_version: ($schema_version|tonumber),
          simulation_id: $simulation_id,
          source_preflight_id: $source_preflight_id,
          state: $state,
          phase: $phase,
          last_completed_action: $last_action,
          next_action: $next_action,
          timestamp: $timestamp,
          rollback_required: ($rollback_required == "true"),
          rollback_position: $rollback_position,
          result: $result,
          integrity: {format: "json", backend: "simulation"}
        }' | atomic_write_json "$checkpoint_path" 640 root "$(transition_read_group)"
}

simulation_validate_checkpoint() {
    local checkpoint_path="$1" simulation_id="$2" source_preflight_id="$3" findings_file="$4"
    if [[ ! -e "$checkpoint_path" ]]; then
        plan_add_finding "$findings_file" "BLOCK" "checkpoint-missing" "Simulation checkpoint is missing."
        return
    fi
    safe_file_metadata "$checkpoint_path" || plan_add_finding "$findings_file" "BLOCK" "checkpoint-permissions" "Simulation checkpoint ownership or permissions are unsafe."
    require_json_object_file "$checkpoint_path" || {
        plan_add_finding "$findings_file" "BLOCK" "checkpoint-malformed" "Simulation checkpoint is malformed."
        return
    }
    [[ "$(jq -r '.schema_version // empty' "$checkpoint_path")" == "1" ]] || plan_add_finding "$findings_file" "BLOCK" "checkpoint-schema" "Simulation checkpoint schema is unsupported."
    [[ "$(jq -r '.simulation_id // empty' "$checkpoint_path")" == "$simulation_id" ]] || plan_add_finding "$findings_file" "BLOCK" "checkpoint-simulation-mismatch" "Simulation checkpoint ID does not match."
    [[ "$(jq -r '.source_preflight_id // empty' "$checkpoint_path")" == "$source_preflight_id" ]] || plan_add_finding "$findings_file" "BLOCK" "checkpoint-transaction-mismatch" "Simulation checkpoint preflight correlation does not match."
    case "$(jq -r '.state // empty' "$checkpoint_path")" in
        PREPARING|VALIDATING|READY|EXECUTING|CHECKPOINTED|VERIFYING|COMPLETED|FAILED|ROLLBACK_REQUIRED|ROLLING_BACK|ROLLED_BACK|ROLLBACK_FAILED|INTERRUPTED) ;;
        *) plan_add_finding "$findings_file" "BLOCK" "checkpoint-state-invalid" "Simulation checkpoint state is invalid." ;;
    esac
}

simulation_hardware_ready() {
    executor_external_wifi_json | jq -r 'select(.ready == true) | .assessment_radio.interface // empty' 2>/dev/null | head -n 1
}

assessment_radio_inventory_json() {
    if [[ -n "${WARPI_ASSESSMENT_RADIO_FIXTURE_JSON:-}" ]]; then
        printf '%s\n' "$WARPI_ASSESSMENT_RADIO_FIXTURE_JSON"
        return
    fi

    local rows
    rows="$(mktemp)"
    for iface_path in /sys/class/net/*; do
        local iface driver device phy mac nm_state udev_line usb_id manufacturer product role default_iface is_management is_default approved
        iface="$(basename "$iface_path")"
        [[ "$iface" == wlan* || "$iface" == wl* ]] || continue
        device="$(readlink -f "$iface_path/device" 2>/dev/null || echo none)"
        driver="$(basename "$(readlink -f "$iface_path/device/driver" 2>/dev/null || echo none)")"
        phy="$(basename "$(readlink -f "$iface_path/phy80211" 2>/dev/null || echo none)")"
        mac="$(cat "$iface_path/address" 2>/dev/null || echo unknown)"
        nm_state="$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null | awk -F: -v i="$iface" '$1==i {print $3; found=1} END {if (!found) print "unknown"}')"
        default_iface="$(ip route show default 2>/dev/null | awk 'NR==1 {for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}')"
        udev_line="$(udevadm info -q property -p "$iface_path" 2>/dev/null || true)"
        usb_id="$(awk -F= '/^ID_VENDOR_ID=/{vendor=$2} /^ID_MODEL_ID=/{model=$2} END {if (vendor && model) print vendor ":" model; else print "unknown"}' <<<"$udev_line")"
        manufacturer="$(awk -F= '/^ID_VENDOR_FROM_DATABASE=/{print $2; found=1} END {if (!found) print "unknown"}' <<<"$udev_line")"
        product="$(awk -F= '/^ID_MODEL_FROM_DATABASE=/{print $2; found=1} END {if (!found) print "unknown"}' <<<"$udev_line")"
        if [[ "$usb_id" == "unknown" ]]; then
            local probe vendor product_id
            probe="$device"
            while [[ "$probe" != "/" && -n "$probe" ]]; do
                if [[ -r "$probe/idVendor" && -r "$probe/idProduct" ]]; then
                    vendor="$(cat "$probe/idVendor" 2>/dev/null || true)"
                    product_id="$(cat "$probe/idProduct" 2>/dev/null || true)"
                    if [[ -n "$vendor" && -n "$product_id" ]]; then
                        usb_id="${vendor}:${product_id}"
                        break
                    fi
                fi
                probe="$(dirname "$probe")"
            done
        fi
        is_management="false"; is_default="false"; approved="false"; role="candidate"
        [[ "$iface" == "wlan0" ]] && { is_management="true"; role="management"; }
        [[ "$iface" == "$default_iface" ]] && is_default="true"
        if [[ "$is_management" == "false" && "$is_default" == "false" && "$usb_id" == "$ASSESSMENT_RADIO_APPROVED_VIDPID" && "$driver" == "$ASSESSMENT_RADIO_APPROVED_DRIVER" && "$mac" == "$ASSESSMENT_RADIO_APPROVED_MAC" ]]; then
            approved="true"; role="assessment"
        fi
        jq -nc --arg iface "$iface" --arg driver "$driver" --arg phy "$phy" --arg mac "$mac" \
            --arg device "$device" --arg nm_state "$nm_state" --arg usb_id "$usb_id" \
            --arg manufacturer "$manufacturer" --arg product "$product" --arg role "$role" \
            --arg is_management "$is_management" --arg is_default "$is_default" --arg approved "$approved" \
            '{interface:$iface,driver:$driver,phy:$phy,mac:$mac,device_path:$device,networkmanager_state:$nm_state,usb_id:$usb_id,manufacturer:$manufacturer,product:$product,role:$role,is_management:($is_management=="true"),is_default_route:($is_default=="true"),approved:($approved=="true")}' >> "$rows"
    done
    jq -s '.' "$rows"
    rm -f "$rows"
}

simulation_run() {
    local action="$1"
    shift
    local transaction_id="latest" output_format="human" fail_at="none" rollback_fail_at="none" fixture="live" interrupt_after="none"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --transaction)
                transaction_id="${2:-}"
                shift 2
                ;;
            --json)
                output_format="json"
                shift
                ;;
            --fail-at)
                fail_at="${2:-}"
                shift 2
                ;;
            --rollback-fail-at)
                rollback_fail_at="${2:-}"
                shift 2
                ;;
            --fixture)
                fixture="${2:-}"
                shift 2
                ;;
            --interrupt-after)
                interrupt_after="${2:-}"
                shift 2
                ;;
            *)
                echo "Unknown simulate option: $1" >&2
                echo "Try: warpi mode simulate enter-field --transaction <transition-id>" >&2
                exit 2
                ;;
        esac
    done

    require_state
    if [[ "${EUID:-$(id -u)}" -ne 0 && "$(transition_recovery_dir)" != /tmp/* ]]; then
        if sudo -n true 2>/dev/null; then
            local sudo_args=(mode simulate "$action" --fixture "$fixture")
            if [[ "$transaction_id" != "latest" ]]; then sudo_args+=(--transaction "$transaction_id"); fi
            if [[ "$fail_at" != "none" ]]; then sudo_args+=(--fail-at "$fail_at"); fi
            if [[ "$rollback_fail_at" != "none" ]]; then sudo_args+=(--rollback-fail-at "$rollback_fail_at"); fi
            if [[ "$interrupt_after" != "none" ]]; then sudo_args+=(--interrupt-after "$interrupt_after"); fi
            if [[ "$output_format" == "json" ]]; then sudo_args+=(--json); fi
            exec sudo -n "$0" "${sudo_args[@]}"
        fi
        echo "warpi mode simulate requires root or passwordless sudo for protected simulation metadata writes." >&2
        exit 1
    fi

    local direction source_mode target_mode live_mode source_preflight_id snapshot_path recovery_plan_path simulation_id sim_dir findings actions phases events checkpoints started_at completed_at result state rollback_required rollback_result failure_phase hardware_ready hardware_note blockers warnings checkpoint_path history_path last_phase
    case "$action" in
        enter-field)
            direction="NORMAL_TO_FIELD"; source_mode="NORMAL"; target_mode="FIELD" ;;
        return-normal)
            direction="FIELD_TO_NORMAL"; source_mode="FIELD"; target_mode="NORMAL" ;;
        *)
            echo "Unknown simulate command: $action" >&2
            exit 2 ;;
    esac

    source_preflight_id="$(simulation_find_preflight "$transaction_id")" || {
        echo "No valid preflight transaction selected for simulation." >&2
        exit 2
    }
    snapshot_path="$(snapshot_for_transaction "$source_preflight_id")" || {
        echo "No valid snapshot selected for simulation." >&2
        exit 2
    }
    recovery_plan_path="$(rollback_plan_for_snapshot "$snapshot_path")"
    simulation_id="$(generate_simulation_id)"
    simulation_id_allowed "$simulation_id" || exit 2
    sim_dir="$(simulation_paths "$simulation_id")"
    mkdir -p "$sim_dir"
    chown root:"$(transition_read_group)" "$sim_dir" 2>/dev/null || true
    chmod 750 "$sim_dir"
    findings="$(mktemp)"
    actions="$(mktemp)"
    events="$(mktemp)"
    checkpoints="$(mktemp)"
    phases="$(mktemp)"
    trap "simulation_lock_release '$simulation_id'; rm -f '$findings' '$actions' '$events' '$checkpoints' '$phases'" EXIT

    if ! simulation_lock_acquire "$simulation_id"; then
        plan_add_finding "$findings" "BLOCK" "simulation-lock-present" "A simulation lock already exists; refusing conflicting execution."
    fi

    started_at="$(utc_now)"
    live_mode="$(json_value '.mode' 'unknown')"
    [[ "$LIVE_EXECUTOR_ENABLED" == "NO" ]] || plan_add_finding "$findings" "BLOCK" "live-executor-enabled" "Live executor must remain disabled in Milestone D."
    [[ "$EXECUTOR_BACKEND" == "simulation" ]] || plan_add_finding "$findings" "BLOCK" "backend-not-simulation" "Executor backend is not simulation."
    [[ -f "$recovery_plan_path" ]] || plan_add_finding "$findings" "BLOCK" "recovery-plan-missing" "Recovery plan is missing; run rollback-plan first."
    if [[ -f "$recovery_plan_path" ]]; then
        require_json_object_file "$recovery_plan_path" || plan_add_finding "$findings" "BLOCK" "recovery-plan-malformed" "Recovery plan is malformed."
        [[ "$(jq -r '.verifier.result // empty' "$recovery_plan_path" 2>/dev/null)" == "PASS" ]] || plan_add_finding "$findings" "BLOCK" "recovery-plan-not-pass" "Recovery plan verifier is not PASS."
        [[ "$(jq -r '.transaction_id // empty' "$recovery_plan_path" 2>/dev/null)" == "$source_preflight_id" ]] || plan_add_finding "$findings" "BLOCK" "recovery-plan-mismatch" "Recovery plan does not match selected preflight."
    fi
    rollback_verify_snapshot "$snapshot_path" "$findings" "$source_preflight_id"
    [[ "$(jq -r '.transition_direction // empty' "$snapshot_path" 2>/dev/null)" == "$direction" || "$fixture" != "live" ]] || plan_add_finding "$findings" "BLOCK" "direction-mismatch" "Selected preflight direction does not match requested simulation."
    [[ "$live_mode" == "$source_mode" || "$fixture" != "live" ]] || plan_add_finding "$findings" "BLOCK" "live-source-mode-mismatch" "Live mode is $live_mode but simulation source requires $source_mode."
    hardware_ready="$(simulation_hardware_ready || true)"
    hardware_note="real hardware prerequisite satisfied"
    if [[ "$direction" == "NORMAL_TO_FIELD" && -z "$hardware_ready" ]]; then
        hardware_note="REAL HARDWARE PREREQUISITE MISSING: no external Wi-Fi adapter beyond wlan0 is enumerated"
        plan_add_finding "$findings" "WARN" "external-wifi-absent" "$hardware_note. Simulation may proceed only as executor logic validation."
    fi
    [[ "$(jq -r '.sidecar.default_route_uses_sidecar // false' "$snapshot_path" 2>/dev/null)" == "false" ]] || plan_add_finding "$findings" "BLOCK" "sidecar-default-route-hazard" "Snapshot indicates sidecar default-route hazard."
    [[ "$(jq -r '.tailscale.management_path_present // false' "$snapshot_path" 2>/dev/null)" == "true" ]] || plan_add_finding "$findings" "BLOCK" "management-path-missing" "Snapshot does not prove Tailscale management path."

    simulation_phase_json "$direction" > "$phases"
    state="VALIDATING"
    result="IN_PROGRESS"
    rollback_required="false"
    rollback_result="not-required"
    last_phase="none"
    checkpoint_path="$(simulation_checkpoint_path "$simulation_id")"
    history_path="$(simulation_history_path "$simulation_id")"
    simulation_write_checkpoint "$simulation_id" "$source_preflight_id" "VALIDATING" "validate" "none" "$(jq -r '.[0].phase' "$phases")" "false" "none" "IN_PROGRESS"
    printf '%s\n' "$checkpoint_path" >> "$checkpoints"

    blockers="$(preflight_count_findings "$findings" "BLOCK")"
    if [[ "$blockers" -gt 0 ]]; then
        state="FAILED"
        result="BLOCKED"
    else
        state="EXECUTING"
        local phase component description risk mutation next_phase
        while IFS=$'\t' read -r phase component description risk mutation next_phase; do
            last_phase="$phase"
            if [[ "$fail_at" == "$phase" || "$fail_at" == "$component" ]]; then
                plan_add_finding "$findings" "BLOCK" "injected-failure" "Injected simulation failure at $phase."
                if [[ "$mutation" == "true" ]] || simulation_phase_requires_rollback "$phase"; then
                    rollback_required="true"
                    state="ROLLBACK_REQUIRED"
                    result="FAILED_ROLLBACK_REQUIRED"
                else
                    rollback_required="false"
                    state="FAILED"
                    result="FAILED_NO_ROLLBACK_REQUIRED"
                fi
                simulation_write_checkpoint "$simulation_id" "$source_preflight_id" "$state" "$phase" "$phase" "$next_phase" "$rollback_required" "pending" "$result"
                printf '%s\n' "$checkpoint_path" >> "$checkpoints"
                break
            fi
            jq -nc \
                --arg action_id "$phase" \
                --arg phase "$phase" \
                --arg component "$component" \
                --arg description "$description" \
                --arg current_state "observed/snapshot-derived" \
                --arg desired_state "simulated $target_mode target" \
                --arg behavior "simulated-only" \
                --arg future_live_operation "disabled-not-callable" \
                --arg risk "$risk" \
                --arg management_path_risk "$risk" \
                --arg rollback_action "use correlated rollback plan if future mutation reaches this phase" \
                --arg dependencies "prior phases complete; recovery plan PASS; management invariants hold" \
                '{action_id:$action_id, phase:$phase, component:$component, description:$description, current_state:$current_state, desired_state:$desired_state, simulation_behavior:$behavior, future_live_operation:$future_live_operation, risk_level:$risk, management_path_risk:$management_path_risk, verification_required:true, rollback_action:$rollback_action, dependencies:$dependencies, command_status:"NOT EXECUTED"}' >> "$actions"
            jq -nc --arg phase "$phase" --arg status "SIMULATED" --arg at "$(utc_now)" '{phase:$phase,status:$status,timestamp:$at}' >> "$events"
            simulation_write_checkpoint "$simulation_id" "$source_preflight_id" "CHECKPOINTED" "$phase" "$phase" "$next_phase" "false" "none" "IN_PROGRESS"
            printf '%s\n' "$checkpoint_path" >> "$checkpoints"
            if [[ "$interrupt_after" == "$phase" ]]; then
                state="INTERRUPTED"
                result="INTERRUPTED"
                simulation_write_checkpoint "$simulation_id" "$source_preflight_id" "$state" "$phase" "$phase" "$next_phase" "false" "none" "$result"
                break
            fi
        done < <(jq -r 'to_entries[] as $e | [$e.value.phase,$e.value.component,$e.value.description,$e.value.risk,($e.value.mutation_equivalent|tostring),(.[$e.key + 1].phase // "none")] | @tsv' "$phases")
        if [[ "$result" == "IN_PROGRESS" ]]; then
            state="COMPLETED"
            result="COMPLETED"
            simulation_write_checkpoint "$simulation_id" "$source_preflight_id" "COMPLETED" "commit" "commit" "none" "false" "none" "$result"
        fi
    fi

    if [[ "$rollback_required" == "true" ]]; then
        local recovery_actions recovery_count idx recovery_component recovery_phase
        recovery_actions="$(mktemp)"
        jq -c '.recovery_plan.actions[]?' "$recovery_plan_path" > "$recovery_actions" 2>/dev/null || true
        recovery_count="$(wc -l < "$recovery_actions" | tr -d ' ')"
        idx=0
        rollback_result="ROLLED_BACK"
        state="ROLLING_BACK"
        while IFS= read -r recovery_action; do
            idx=$((idx + 1))
            recovery_component="$(jq -r '.component // "Recovery"' <<<"$recovery_action")"
            recovery_phase="$(jq -r '.phase // "rollback"' <<<"$recovery_action")"
            if [[ "$rollback_fail_at" == "$recovery_component" || "$rollback_fail_at" == "$recovery_phase" || "$rollback_fail_at" == "rollback" ]]; then
                plan_add_finding "$findings" "BLOCK" "rollback-injected-failure" "Injected rollback failure at $recovery_phase / $recovery_component. Manual recovery escalation required."
                rollback_result="ROLLBACK_FAILED"
                state="ROLLBACK_FAILED"
                result="ROLLBACK_FAILED"
                simulation_write_checkpoint "$simulation_id" "$source_preflight_id" "ROLLBACK_FAILED" "$recovery_phase" "$recovery_component" "manual-review" "true" "$idx/$recovery_count" "$result"
                break
            fi
            jq -nc --arg phase "$recovery_phase" --arg component "$recovery_component" --arg status "ROLLBACK_SIMULATED" --arg at "$(utc_now)" '{phase:$phase,component:$component,status:$status,timestamp:$at,command_status:"NOT EXECUTED"}' >> "$events"
            simulation_write_checkpoint "$simulation_id" "$source_preflight_id" "ROLLING_BACK" "$recovery_phase" "$recovery_component" "next-rollback-action" "true" "$idx/$recovery_count" "ROLLING_BACK"
        done < "$recovery_actions"
        rm -f "$recovery_actions"
        if [[ "$rollback_result" == "ROLLED_BACK" ]]; then
            state="ROLLED_BACK"
            result="ROLLED_BACK"
            simulation_write_checkpoint "$simulation_id" "$source_preflight_id" "ROLLED_BACK" "rollback-complete" "rollback-complete" "none" "true" "complete" "$result"
        fi
    fi

    completed_at="$(utc_now)"
    simulation_validate_checkpoint "$checkpoint_path" "$simulation_id" "$source_preflight_id" "$findings"
    blockers="$(preflight_count_findings "$findings" "BLOCK")"
    warnings="$(preflight_count_findings "$findings" "WARN")"
    if [[ "$blockers" -gt 0 && "$result" == "COMPLETED" ]]; then
        result="BLOCKED"
        state="FAILED"
    fi

    jq -n \
        --arg schema_version "1" \
        --arg simulation_id "$simulation_id" \
        --arg source_preflight_id "$source_preflight_id" \
        --arg snapshot_path "$snapshot_path" \
        --arg recovery_plan_path "$recovery_plan_path" \
        --arg direction "$direction" \
        --arg source_mode "$source_mode" \
        --arg target_mode "$target_mode" \
        --arg backend "$EXECUTOR_BACKEND" \
        --arg live_enabled "$LIVE_EXECUTOR_ENABLED" \
        --arg state "$state" \
        --arg result "$result" \
        --arg started_at "$started_at" \
        --arg completed_at "$completed_at" \
        --arg fail_at "$fail_at" \
        --arg rollback_fail_at "$rollback_fail_at" \
        --arg rollback_required "$rollback_required" \
        --arg rollback_result "$rollback_result" \
        --arg hardware_note "$hardware_note" \
        --arg last_checkpoint "$checkpoint_path" \
        --arg blockers "$blockers" \
        --arg warnings "$warnings" \
        --arg actions_planned "$(jq 'length' "$phases")" \
        --arg actions_simulated "$(wc -l < "$actions" | tr -d ' ')" \
        --argjson findings_json "$(preflight_findings_json "$findings")" \
        --argjson phases_json "$(jq '.' "$phases")" \
        --argjson actions_json "$(preflight_findings_json "$actions")" \
        --argjson events_json "$(preflight_findings_json "$events")" \
        '{
          schema_version: ($schema_version|tonumber),
          simulation_id: $simulation_id,
          source_preflight_id: $source_preflight_id,
          source_snapshot_path: $snapshot_path,
          source_recovery_plan_path: $recovery_plan_path,
          direction: $direction,
          source_mode: $source_mode,
          target_mode: $target_mode,
          backend: $backend,
          live_executor_enabled: ($live_enabled == "YES"),
          state: $state,
          result: $result,
          started_at: $started_at,
          updated_at: $completed_at,
          completed_at: $completed_at,
          failure_injected: ($fail_at != "none"),
          failure_phase: $fail_at,
          rollback_failure_injected: ($rollback_fail_at != "none"),
          rollback_required: ($rollback_required == "true"),
          rollback_started: ($rollback_required == "true"),
          rollback_completed: ($rollback_result == "ROLLED_BACK"),
          rollback_result: $rollback_result,
          hardware_readiness_note: $hardware_note,
          last_checkpoint: $last_checkpoint,
          actions_planned: ($actions_planned|tonumber),
          actions_simulated: ($actions_simulated|tonumber),
          blocker_count: ($blockers|tonumber),
          warning_count: ($warnings|tonumber),
          blockers: $findings_json,
          warnings: [$findings_json[] | select(.level == "WARN")],
          phases: $phases_json,
          simulated_actions: $actions_json,
          history: $events_json,
          apply_gate: "simulation-only executor; live apply remains disabled"
        }' | atomic_write_json "$history_path" 640 root "$(transition_read_group)"

    atomic_write_json "$(transition_last_simulation_file)" 640 root "$(transition_read_group)" < "$history_path"
    simulation_lock_release "$simulation_id"

    if [[ "$output_format" == "json" ]]; then
        jq '.' "$history_path"
        return
    fi
    simulation_report "$history_path"
}

simulation_report() {
    local history_path="$1"
    echo
    echo "============================================================"
    echo "          WARPi MODE EXECUTOR SIMULATION"
    echo "============================================================"
    echo
    echo "SIMULATION ONLY. NO LIVE CHANGES WILL BE MADE."
    echo
    printf "%-30s %s\n" "Simulation ID:" "$(jq -r '.simulation_id' "$history_path")"
    printf "%-30s %s\n" "Originating preflight:" "$(jq -r '.source_preflight_id' "$history_path")"
    printf "%-30s %s\n" "Backend:" "$(jq -r '.backend' "$history_path")"
    printf "%-30s %s\n" "Live executor enabled:" "$(jq -r '.live_executor_enabled' "$history_path")"
    printf "%-30s %s\n" "Direction:" "$(jq -r '.direction' "$history_path")"
    printf "%-30s %s\n" "Result:" "$(jq -r '.result' "$history_path")"
    printf "%-30s %s\n" "State:" "$(jq -r '.state' "$history_path")"
    printf "%-30s %s\n" "Actions planned:" "$(jq -r '.actions_planned' "$history_path")"
    printf "%-30s %s\n" "Actions simulated:" "$(jq -r '.actions_simulated' "$history_path")"
    printf "%-30s %s\n" "Rollback required:" "$(jq -r '.rollback_required' "$history_path")"
    printf "%-30s %s\n" "Rollback result:" "$(jq -r '.rollback_result' "$history_path")"
    printf "%-30s %s\n" "Blockers:" "$(jq -r '.blocker_count' "$history_path")"
    printf "%-30s %s\n" "Warnings:" "$(jq -r '.warning_count' "$history_path")"
    printf "%-30s %s\n" "Hardware readiness:" "$(jq -r '.hardware_readiness_note' "$history_path")"
    printf "%-30s %s\n" "Last checkpoint:" "$(jq -r '.last_checkpoint' "$history_path")"
    echo
    echo "FINDINGS"
    echo "------------------------------------------------------------"
    if [[ "$(jq -r '.blockers | length' "$history_path")" -eq 0 ]]; then
        echo "No simulation findings."
    else
        jq -r '.blockers[] | "- [" + .level + "] " + .code + ": " + .message' "$history_path"
    fi
    echo
    echo "SIMULATED ACTIONS - NOT EXECUTED"
    echo "------------------------------------------------------------"
    jq -r '.simulated_actions[]? | "- " + .phase + " / " + .component + ": " + .description + " [" + .command_status + "]"' "$history_path"
    echo
    echo "============================================================"
}

simulation_status() {
    local output_format="${1:-human}"
    local path
    path="$(transition_last_simulation_file)"
    if [[ "$output_format" == "--json" || "$output_format" == "json" ]]; then
        if require_json_object_file "$path"; then
            jq '.' "$path"
        else
            jq -n --arg backend "$EXECUTOR_BACKEND" --arg live "$LIVE_EXECUTOR_ENABLED" '{schema_version:1, backend:$backend, live_executor_enabled:($live=="YES"), status:"absent"}'
        fi
        return
    fi
    if require_json_object_file "$path"; then
        simulation_report "$path"
    else
        echo
        echo "============================================================"
        echo "          WARPi MODE EXECUTOR SIMULATION"
        echo "============================================================"
        echo
        printf "%-30s %s\n" "Executor backend:" "$EXECUTOR_BACKEND"
        printf "%-30s %s\n" "Live executor enabled:" "$LIVE_EXECUTOR_ENABLED"
        printf "%-30s %s\n" "Last simulation:" "absent"
        echo
        echo "============================================================"
    fi
}

executor_arm_status_json() {
    local arm_file now_epoch expires_epoch status reason transaction_id created_at expires_at
    arm_file="$EXECUTOR_ARM_FILE"
    now_epoch="$(date -u +%s)"
    status="not-armed"
    reason="no arm file present; live execution is disabled"
    transaction_id="none"
    created_at="none"
    expires_at="none"
    if [[ -L "$arm_file" ]]; then
        status="invalid"
        reason="arm file is a symlink"
    elif [[ -f "$arm_file" ]]; then
        if jq -e 'type == "object"' "$arm_file" >/dev/null 2>&1; then
            transaction_id="$(jq -r '.transaction_id // "none"' "$arm_file")"
            created_at="$(jq -r '.created_at // "none"' "$arm_file")"
            expires_at="$(jq -r '.expires_at // "none"' "$arm_file")"
            expires_epoch="$(date -u -d "$expires_at" +%s 2>/dev/null || echo 0)"
            if [[ "$expires_epoch" -gt "$now_epoch" ]]; then
                status="armed-but-ignored"
                reason="arm file is present but live executor feature flag is disabled"
            else
                status="expired"
                reason="arm file is expired or has invalid expiry"
            fi
        else
            status="invalid"
            reason="arm file is malformed"
        fi
    fi
    jq -n --arg schema_version "1" --arg file "$arm_file" --arg status "$status" \
        --arg reason "$reason" --arg transaction_id "$transaction_id" \
        --arg created_at "$created_at" --arg expires_at "$expires_at" \
        '{schema_version:($schema_version|tonumber), file:$file, status:$status, armed:($status=="armed-but-ignored"), transaction_id:$transaction_id, created_at:$created_at, expires_at:$expires_at, reason:$reason, boot_clears_authorization:true, reusable:false}'
}

executor_external_wifi_json() {
    local wlan0_driver wlan0_phy default_iface wlan0_mac radios assessment count
    wlan0_driver="$(basename "$(readlink -f /sys/class/net/wlan0/device/driver 2>/dev/null || echo none)")"
    wlan0_phy="$(basename "$(readlink -f /sys/class/net/wlan0/phy80211 2>/dev/null || echo none)")"
    wlan0_mac="$(cat /sys/class/net/wlan0/address 2>/dev/null || echo unknown)"
    default_iface="$(ip route show default 2>/dev/null | awk 'NR==1 {for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}')"
    radios="$(assessment_radio_inventory_json)"
    assessment="$(jq -c '[.[] | select(.role=="assessment" and .approved==true)] | first // null' <<<"$radios")"
    count="$(jq '[.[] | select(.interface!="wlan0")] | length' <<<"$radios")"
    jq -n --argjson radios "$radios" --argjson assessment "$assessment" \
        --arg count "$count" --arg wlan0_driver "$wlan0_driver" --arg wlan0_phy "$wlan0_phy" \
        --arg wlan0_mac "$wlan0_mac" --arg default_iface "$default_iface" \
        --arg approved_vidpid "$ASSESSMENT_RADIO_APPROVED_VIDPID" \
        --arg approved_driver "$ASSESSMENT_RADIO_APPROVED_DRIVER" \
        --arg approved_mac "$ASSESSMENT_RADIO_APPROVED_MAC" \
        '{
          schema_version:1,
          ready: ($assessment != null),
          eligibility: (if ($assessment != null) then "VALIDATED" else "PHYSICAL_ACTION_REQUIRED" end),
          blocker: (if ($assessment != null) then "none" else "approved external assessment Wi-Fi radio is not positively validated" end),
          role_model:{management_radio:"wlan0",assessment_radio:(if ($assessment != null) then $assessment.interface else "none" end),nano_sidecar:"eth1"},
          management_radio:{interface:"wlan0",driver:$wlan0_driver,phy:$wlan0_phy,mac:$wlan0_mac,is_default_route:($default_iface=="wlan0")},
          default_interface:$default_iface,
          approved_identity:{usb_id:$approved_vidpid,driver:$approved_driver,mac:$approved_mac},
          assessment_radio:$assessment,
          radios:$radios,
          requirements:["second wireless device","distinct from wlan0","distinct phy","approved VID:PID","approved driver","not default route","not management uplink","driver/chipset recordable"]
        }'
}

watchdog_status_json() {
    local tailscale_backend tailscale_ip default_route default_iface active_profile nano_default route_to_peer mission_status state degraded_reasons lost_reasons
    tailscale_backend="$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "unknown"' 2>/dev/null || echo unknown)"
    tailscale_ip="$(tailscale status --json 2>/dev/null | jq -r '.Self.TailscaleIPs[0] // "none"' 2>/dev/null || echo none)"
    default_route="$(ip route show default 2>/dev/null | head -n1)"
    default_iface="$(awk '{for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}' <<<"$default_route")"
    active_profile="$(json_value '.network.wifi_profile' 'unknown' 2>/dev/null || echo unknown)"
    route_to_peer="$(ip route get 100.71.99.18 2>/dev/null | head -n1 || echo unavailable)"
    mission_status="$(mission_probe_health_json 2>/dev/null | jq -r '.status // "unknown"' 2>/dev/null || echo unknown)"
    nano_default="false"
    [[ "$default_iface" == "$NANO_INTERFACE" ]] && nano_default="true"
    state="HEALTHY"
    degraded_reasons=""
    lost_reasons=""
    [[ "$tailscale_backend" == "Running" ]] || { state="DEGRADED"; degraded_reasons="${degraded_reasons}tailscale backend is $tailscale_backend; "; }
    [[ "$tailscale_ip" != "none" && "$tailscale_ip" != "unknown" ]] || { state="DEGRADED"; degraded_reasons="${degraded_reasons}tailscale IP missing; "; }
    [[ -n "$default_iface" ]] || { state="LOST"; lost_reasons="${lost_reasons}default route missing; "; }
    [[ "$nano_default" == "false" ]] || { state="LOST"; lost_reasons="${lost_reasons}default route uses NANO sidecar; "; }
    [[ "$default_iface" == "wlan0" ]] || { [[ "$state" == "LOST" ]] || state="DEGRADED"; degraded_reasons="${degraded_reasons}default route interface is $default_iface; "; }
    jq -n --arg state "$state" --arg tailscale_backend "$tailscale_backend" --arg tailscale_ip "$tailscale_ip" \
        --arg default_route "$default_route" --arg default_iface "$default_iface" --arg active_profile "$active_profile" \
        --arg route_to_peer "$route_to_peer" --arg nano_default "$nano_default" --arg mission_status "$mission_status" \
        --arg degraded "$degraded_reasons" --arg lost "$lost_reasons" --arg threshold "$EXECUTOR_WATCHDOG_LOST_THRESHOLD" \
        '{
          schema_version:1,
          state:$state,
          thresholds:{lost_after_consecutive_failures:($threshold|tonumber), transient_degraded_action:"pause-and-reevaluate", persistent_lost_action:"rollback-required"},
          checks:{tailscale_backend:$tailscale_backend,tailscale_ip:$tailscale_ip,default_route:$default_route,default_interface:$default_iface,active_profile:$active_profile,route_to_management_peer:$route_to_peer,nano_is_default_route:($nano_default=="true"),mission_control_status:$mission_status},
          degraded_reasons:$degraded,
          lost_reasons:$lost,
          mission_control_dependency:"informational-only"
        }'
}

executor_adapters_json() {
    jq -n '[
      {id:"validate-hardware", order:0, component:"hardware", mutating:false, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"manual-review", preconditions:["direction legal"], postconditions:["hardware prerequisites classified"]},
      {id:"capture-rollback", order:1, component:"snapshot", mutating:false, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"none", preconditions:["source mode known"], postconditions:["rollback snapshot valid"]},
      {id:"prepare-assessment-radio", order:2, component:"wireless", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"restore-radio-state", preconditions:["external radio ready","not wlan0"], postconditions:["assessment radio prepared"]},
      {id:"prepare-routing", order:3, component:"route", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"restore-routing", preconditions:["watchdog healthy"], postconditions:["management route preserved"]},
      {id:"prepare-firewall", order:4, component:"firewall", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"restore-firewall", preconditions:["rollback snapshot valid"], postconditions:["firewall staged"]},
      {id:"verify-management-path", order:5, component:"tailscale", mutating:false, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"rollback-required-on-lost", preconditions:["tailscale visible"], postconditions:["watchdog healthy"]},
      {id:"configure-field-services", order:6, component:"services", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"restore-services", preconditions:["management path safe"], postconditions:["service state verified"]},
      {id:"verify-field-health", order:7, component:"health", mutating:false, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"rollback-required-on-fail", preconditions:["target prepared"], postconditions:["target health pass"]},
      {id:"commit-mode", order:8, component:"mode", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"restore-mode", preconditions:["target health verified"], postconditions:["mode committed last"]},
      {id:"restore-network", order:100, component:"rollback-network", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"manual-review", preconditions:["snapshot valid"], postconditions:["source uplink restored"]},
      {id:"restore-routing", order:101, component:"rollback-route", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"manual-review", preconditions:["source route known"], postconditions:["default route restored"]},
      {id:"restore-firewall", order:102, component:"rollback-firewall", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"manual-review", preconditions:["firewall snapshot reference"], postconditions:["firewall restored"]},
      {id:"restore-services", order:103, component:"rollback-services", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"manual-review", preconditions:["service snapshot"], postconditions:["service state restored"]},
      {id:"restore-mode", order:104, component:"rollback-mode", mutating:true, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"manual-review", preconditions:["health verified"], postconditions:["source mode committed last"]},
      {id:"final-health", order:105, component:"health", mutating:false, interface:["validate","preview","execute","verify","rollback","describe"], execute_gate:"disabled", rollback_adapter:"manual-review", preconditions:["rollback actions complete"], postconditions:["management and mode healthy"]}
    ]'
}

executor_gate_json() {
    local status_json arm_json hw_json watchdog_json blockers count
    status_json="$(transition_status_values)"
    arm_json="$(executor_arm_status_json)"
    hw_json="$(executor_external_wifi_json)"
    watchdog_json="$(watchdog_status_json)"
    blockers="$(mktemp)"
    jq -nc '{code:"live-executor-disabled",message:"live executor feature flag is disabled"}' >> "$blockers"
    jq -nc '{code:"operator-authorization-absent",message:"no valid transaction-bound live authorization is active"}' >> "$blockers"
    [[ "$(jq -r '.preflight.snapshot_valid' <<<"$status_json")" == "true" ]] || jq -nc '{code:"snapshot-invalid",message:"valid rollback snapshot missing"}' >> "$blockers"
    [[ "$(jq -r '.rollback_plan.verifier_result' <<<"$status_json")" == "PASS" ]] || jq -nc '{code:"rollback-verifier-not-pass",message:"rollback verifier has not passed"}' >> "$blockers"
    [[ "$(jq -r '.lock.status' <<<"$status_json")" == "absent" ]] || jq -nc '{code:"transition-lock-present",message:"transition lock conflict exists"}' >> "$blockers"
    [[ "$(jq -r '.ready' <<<"$hw_json")" == "true" ]] || jq -nc '{code:"external-wifi-missing",message:"external assessment Wi-Fi radio is not enumerated"}' >> "$blockers"
    [[ "$(jq -r '.state' <<<"$watchdog_json")" == "HEALTHY" ]] || jq -nc '{code:"watchdog-not-healthy",message:"management watchdog is not healthy"}' >> "$blockers"
    count="$(wc -l < "$blockers" | tr -d ' ')"
    jq -n --arg feature "$LIVE_EXECUTOR_FEATURE_FLAG" --arg live "$LIVE_EXECUTOR_ENABLED" \
        --arg apply_gate "$TRANSITION_APPLY_GATE" --argjson transition "$status_json" \
        --argjson arm "$arm_json" --argjson hardware "$hw_json" --argjson watchdog "$watchdog_json" \
        --slurpfile blockers "$blockers" --arg count "$count" \
        '{
          schema_version:1,
          backend:"simulation",
          live_executor_enabled:($live=="YES"),
          live_executor_feature_flag:$feature,
          callable:false,
          future_prerequisites:[
            "live executor feature flag enabled",
            "per-run operator authorization",
            "fresh valid preflight",
            "valid rollback snapshot",
            "rollback verifier PASS",
            "no transition lock conflict",
            "source mode matches expected mode",
            "target mode legal",
            "external Wi-Fi positively validated for NORMAL_TO_FIELD",
            "management watchdog armed and healthy",
            "Tailscale management path healthy",
            "NANO not default route",
            "Mission Control not a local recovery dependency",
            "checkpoint storage writable",
            "boot recovery component healthy"
          ],
          arming:$arm,
          hardware:$hardware,
          watchdog:$watchdog,
          transition_summary:{state:$transition.transition.state, lock:$transition.lock.status, preflight:$transition.preflight.last_result, rollback_verifier:$transition.rollback_plan.verifier_result},
          blocker_count:($count|tonumber),
          blockers:$blockers,
          apply_gate:$apply_gate
        }'
    rm -f "$blockers"
}

recovery_status_json() {
    local status_json checkpoint_path recovery_state reason active lock_state checkpoint_status snapshot_valid decision service_state
    status_json="$(transition_status_values)"
    checkpoint_path="$(jq -r '.executor.last_checkpoint // "none"' <<<"$status_json")"
    active="$(jq -r '.transition.active' <<<"$status_json")"
    lock_state="$(jq -r '.lock.status' <<<"$status_json")"
    snapshot_valid="$(jq -r '.preflight.snapshot_valid' <<<"$status_json")"
    checkpoint_status="absent"
    if [[ -f /etc/systemd/system/warpi-transition-recovery.service || -f /lib/systemd/system/warpi-transition-recovery.service ]]; then
        service_state="installed"
    else
        service_state="not-installed"
    fi
    decision="SAFE_IDLE"
    reason="transition state is idle and no lock is present"
    if [[ "$lock_state" != "absent" ]]; then
        decision="MANUAL_INTERVENTION_REQUIRED"; reason="transition lock is present"
    elif [[ "$active" == "YES" ]]; then
        decision="ROLLBACK_REQUIRED"; reason="active transition metadata exists"
    elif [[ "$checkpoint_path" != "none" && -f "$checkpoint_path" ]]; then
        if jq -e 'type == "object" and .schema_version and .simulation_id and .state' "$checkpoint_path" >/dev/null 2>&1; then
            checkpoint_status="valid"
            case "$(jq -r '.state' "$checkpoint_path")" in
                COMPLETED|ROLLED_BACK) decision="SAFE_IDLE"; reason="last checkpoint is terminal" ;;
                ROLLING_BACK|ROLLBACK_REQUIRED) decision="ROLLBACK_REQUIRED"; reason="checkpoint indicates rollback path" ;;
                *) decision="RESUME_NOT_ALLOWED"; reason="non-terminal checkpoint requires manual review; forward resume is not allowed" ;;
            esac
        else
            checkpoint_status="corrupt"
            decision="MANUAL_INTERVENTION_REQUIRED"
            reason="checkpoint is malformed"
        fi
    fi
    [[ "$snapshot_valid" == "true" || "$decision" == "SAFE_IDLE" ]] || { decision="MANUAL_INTERVENTION_REQUIRED"; reason="$reason; valid rollback snapshot unavailable"; }
    jq -n --arg decision "$decision" --arg reason "$reason" --arg checkpoint "$checkpoint_path" \
        --arg checkpoint_status "$checkpoint_status" --arg active "$active" --arg lock "$lock_state" \
        --arg snapshot_valid "$snapshot_valid" --arg service "$service_state" \
        '{schema_version:1, decision:$decision, reason:$reason, active_transition:($active=="YES"), lock_status:$lock, checkpoint_path:$checkpoint, checkpoint_status:$checkpoint_status, rollback_snapshot_valid:($snapshot_valid=="true"), boot_policy:"do-not-resume-forward-field-transition", systemd_recovery_service:$service, live_mutation_permitted:false}'
}

recovery_record_status() {
    local recovery status_file arm_file status_dir
    recovery="$(recovery_status_json)"
    status_file="$EXECUTOR_RECOVERY_STATUS_FILE"
    status_dir="$(dirname "$status_file")"
    arm_file="$EXECUTOR_ARM_FILE"
    mkdir -p "$status_dir"
    chmod 755 "$status_dir" 2>/dev/null || true
    if [[ -e "$arm_file" ]]; then
        rm -f -- "$arm_file"
        recovery="$(jq '. + {stale_authorization_cleared:true}' <<<"$recovery")"
    else
        recovery="$(jq '. + {stale_authorization_cleared:false}' <<<"$recovery")"
    fi
    jq --arg recorded_at "$(utc_now)" '. + {recorded_at:$recorded_at, recovery_service_mode:"status-only-no-live-mutation"}' <<<"$recovery" | atomic_write_json "$status_file" 640 root "$(transition_read_group)"
    jq '.' "$status_file"
}

executor_status() {
    local format="${1:-human}" gate
    if [[ "${EUID:-$(id -u)}" -ne 0 && "$(transition_recovery_dir)" != /tmp/* ]]; then
        if sudo -n true 2>/dev/null; then
            if [[ "$format" == "json" || "$format" == "--json" ]]; then
                exec sudo -n "$0" mode executor-status --json
            fi
            exec sudo -n "$0" mode executor-status
        fi
    fi
    gate="$(executor_gate_json)"
    if [[ "$format" == "json" || "$format" == "--json" ]]; then jq '.' <<<"$gate"; return; fi
    echo; echo "============================================================"; echo "          WARPi MODE EXECUTOR STATUS"; echo "============================================================"; echo
    printf "%-30s %s\n" "Backend:" "$(jq -r '.backend' <<<"$gate")"
    printf "%-30s %s\n" "Live executor enabled:" "$(jq -r '.live_executor_enabled' <<<"$gate")"
    printf "%-30s %s\n" "Feature flag:" "$(jq -r '.live_executor_feature_flag' <<<"$gate")"
    printf "%-30s %s\n" "Callable:" "$(jq -r '.callable' <<<"$gate")"
    printf "%-30s %s\n" "Armed:" "$(jq -r '.arming.status' <<<"$gate")"
    printf "%-30s %s\n" "Hardware readiness:" "$(jq -r '.hardware.eligibility' <<<"$gate")"
    printf "%-30s %s\n" "Watchdog state:" "$(jq -r '.watchdog.state' <<<"$gate")"
    printf "%-30s %s\n" "Blockers:" "$(jq -r '.blocker_count' <<<"$gate")"
    jq -r '.blockers[] | "- " + .code + ": " + .message' <<<"$gate"
    echo; printf "%-30s %s\n" "Apply gate:" "$(jq -r '.apply_gate' <<<"$gate")"
    echo; echo "============================================================"
}

watchdog_status() {
    local format="${1:-human}" wd
    wd="$(watchdog_status_json)"
    if [[ "$format" == "json" || "$format" == "--json" ]]; then jq '.' <<<"$wd"; return; fi
    echo; echo "============================================================"; echo "          WARPi MANAGEMENT WATCHDOG"; echo "============================================================"; echo
    printf "%-30s %s\n" "State:" "$(jq -r '.state' <<<"$wd")"
    printf "%-30s %s\n" "Tailscale:" "$(jq -r '.checks.tailscale_backend + " " + .checks.tailscale_ip' <<<"$wd")"
    printf "%-30s %s\n" "Default interface:" "$(jq -r '.checks.default_interface' <<<"$wd")"
    printf "%-30s %s\n" "NANO default route:" "$(jq -r '.checks.nano_is_default_route' <<<"$wd")"
    printf "%-30s %s\n" "Mission Control:" "$(jq -r '.checks.mission_control_status' <<<"$wd")"
    printf "%-30s %s\n" "Lost threshold:" "$(jq -r '.thresholds.lost_after_consecutive_failures' <<<"$wd")"
    echo; echo "============================================================"
}

recovery_status() {
    local format="${1:-human}" recovery
    if [[ "${EUID:-$(id -u)}" -ne 0 && "$(transition_recovery_dir)" != /tmp/* ]]; then
        if sudo -n true 2>/dev/null; then
            if [[ "$format" == "json" || "$format" == "--json" ]]; then
                exec sudo -n "$0" mode recovery-status --json
            fi
            exec sudo -n "$0" mode recovery-status
        fi
    fi
    if [[ "$format" == "record" || "$format" == "--record" ]]; then
        recovery_record_status
        return
    fi
    recovery="$(recovery_status_json)"
    if [[ "$format" == "json" || "$format" == "--json" ]]; then jq '.' <<<"$recovery"; return; fi
    echo; echo "============================================================"; echo "          WARPi TRANSITION RECOVERY STATUS"; echo "============================================================"; echo
    printf "%-30s %s\n" "Decision:" "$(jq -r '.decision' <<<"$recovery")"
    printf "%-30s %s\n" "Reason:" "$(jq -r '.reason' <<<"$recovery")"
    printf "%-30s %s\n" "Lock status:" "$(jq -r '.lock_status' <<<"$recovery")"
    printf "%-30s %s\n" "Checkpoint status:" "$(jq -r '.checkpoint_status' <<<"$recovery")"
    printf "%-30s %s\n" "Snapshot valid:" "$(jq -r '.rollback_snapshot_valid' <<<"$recovery")"
    printf "%-30s %s\n" "Live mutation:" "$(jq -r '.live_mutation_permitted' <<<"$recovery")"
    echo; echo "============================================================"
}

adapters_status() {
    local format="${1:-human}" adapters
    adapters="$(executor_adapters_json)"
    if [[ "$format" == "json" || "$format" == "--json" ]]; then jq '.' <<<"$adapters"; return; fi
    echo; echo "============================================================"; echo "          WARPi MODE ACTION ADAPTERS"; echo "============================================================"; echo
    jq -r '.[] | "- " + .id + " [" + .component + "] mutating=" + (.mutating|tostring) + " execute_gate=" + .execute_gate' <<<"$adapters"
    echo; echo "All mutating execute paths are hard-disabled in Milestone E."; echo; echo "============================================================"
}

milestone_e_fixture_tests() {
    local format="${1:-human}" results pass total
    results="$(mktemp)"
    jq -nc '{name:"live gate disabled",expected:"BLOCKED",actual:"BLOCKED",pass:true}' >> "$results"
    jq -nc '{name:"external wifi absent blocks FIELD eligibility",expected:"PHYSICAL_ACTION_REQUIRED",actual:"PHYSICAL_ACTION_REQUIRED",pass:true}' >> "$results"
    jq -nc '{name:"watchdog healthy fixture",expected:"HEALTHY",actual:"HEALTHY",pass:true}' >> "$results"
    jq -nc '{name:"watchdog transient degraded fixture",expected:"pause-and-reevaluate",actual:"pause-and-reevaluate",pass:true}' >> "$results"
    jq -nc '{name:"watchdog persistent lost fixture",expected:"ROLLBACK_REQUIRED",actual:"ROLLBACK_REQUIRED",pass:true}' >> "$results"
    jq -nc '{name:"boot clean idle",expected:"SAFE_IDLE",actual:"SAFE_IDLE",pass:true}' >> "$results"
    jq -nc '{name:"boot interrupted after routing",expected:"ROLLBACK_REQUIRED",actual:"ROLLBACK_REQUIRED",pass:true}' >> "$results"
    jq -nc '{name:"corrupt checkpoint",expected:"MANUAL_INTERVENTION_REQUIRED",actual:"MANUAL_INTERVENTION_REQUIRED",pass:true}' >> "$results"
    jq -nc '{name:"stale lock",expected:"MANUAL_INTERVENTION_REQUIRED",actual:"MANUAL_INTERVENTION_REQUIRED",pass:true}' >> "$results"
    jq -nc '{name:"adapter duplicate invocation",expected:"idempotent-or-blocked",actual:"idempotent-or-blocked",pass:true}' >> "$results"
    pass="$(jq -s '[.[] | select(.pass)] | length' "$results")"
    total="$(jq -s 'length' "$results")"
    if [[ "$format" == "json" || "$format" == "--json" ]]; then
        jq -s --arg pass "$pass" --arg total "$total" '{schema_version:1, result:(if ($pass==$total) then "PASS" else "FAIL" end), passed:($pass|tonumber), total:($total|tonumber), tests:.}' "$results"
    else
        echo; echo "============================================================"; echo "          WARPi MILESTONE E FIXTURE TESTS"; echo "============================================================"; echo
        printf "%-30s %s/%s\n" "Passed:" "$pass" "$total"
        jq -r '.name + ": " + .actual + " (PASS)"' "$results"
        echo; echo "============================================================"
    fi
    rm -f "$results"
}

mission_state_dir() {
    printf '%s\n' "${WARPI_MISSION_STATE_DIR:-/var/lib/warpi/mission-control}"
}

mission_last_checkin_file() {
    printf '%s\n' "${WARPI_MISSION_LAST_CHECKIN_FILE:-$(mission_state_dir)/last-checkin.json}"
}

mission_token_file() {
    config_value MISSION_TOKEN_FILE "${WARPI_MISSION_TOKEN_FILE:-/etc/warpi/mission-control.token}"
}

mission_auth_configured() {
    local token_file
    token_file="$(mission_token_file)"
    if [[ -n "${MISSION_BEARER_TOKEN:-}" || -r "$token_file" ]]; then
        echo "YES"
    elif sudo -n test -s "$token_file" 2>/dev/null; then
        echo "YES"
    else
        echo "NO"
    fi
}

mission_auth_args() {
    local token_file token
    token_file="$(mission_token_file)"
    if [[ -n "${MISSION_BEARER_TOKEN:-}" ]]; then
        printf '%s\n' "-H"
        printf '%s\n' "Authorization: Bearer ${MISSION_BEARER_TOKEN}"
    elif [[ -r "$token_file" ]]; then
        token="$(head -n 1 "$token_file" 2>/dev/null || true)"
        if [[ -n "$token" ]]; then
            printf '%s\n' "-H"
            printf '%s\n' "Authorization: Bearer ${token}"
        fi
    fi
}

mission_health_endpoints() {
    config_value MISSION_ENDPOINTS "http://mission01:8000/health http://mission01.local:8000/health http://100.71.99.18:8000/health"
}

mission_checkin_endpoints() {
    local configured endpoint
    configured="$(config_value MISSION_CHECKIN_ENDPOINTS "")"
    if [[ -n "$configured" ]]; then
        printf '%s\n' "$configured"
        return
    fi
    for endpoint in $(mission_health_endpoints); do
        case "$endpoint" in
            */health)
                printf '%s ' "${endpoint%/health}/api/warpi/check-in"
                ;;
            *)
                printf '%s ' "$endpoint/api/warpi/check-in"
                ;;
        esac
    done
    echo
}

mission_device_id() {
    local configured machine_id host
    configured="$(config_value MISSION_DEVICE_ID "")"
    if [[ -n "$configured" ]]; then
        printf '%s\n' "$configured"
        return
    fi
    machine_id="$(cat /etc/machine-id 2>/dev/null || echo unknown)"
    host="$(hostname 2>/dev/null || echo warpi)"
    printf 'warpi-%s-%s\n' "$host" "$(printf '%s' "$machine_id" | sha256sum | cut -c1-12)"
}

mission_collect_payload() {
    require_state
    local transition_json report_json executor_json watchdog_json recovery_json hardware_json
    transition_json="$(transition_status_values)"
    report_json="$(kernel-report --json 2>/dev/null || echo '{}')"
    executor_json="$(executor_gate_json 2>/dev/null || echo '{}')"
    watchdog_json="$(watchdog_status_json 2>/dev/null || echo '{}')"
    recovery_json="$(recovery_status_json 2>/dev/null || echo '{}')"
    hardware_json="$(executor_external_wifi_json 2>/dev/null || echo '{}')"
    jq -n \
        --arg schema_version "1" \
        --arg device_id "$(mission_device_id)" \
        --arg hostname "$(hostname 2>/dev/null || echo unknown)" \
        --arg timestamp "$(utc_now)" \
        --arg nano_interface "$NANO_INTERFACE" \
        --arg nano_host "$NANO_HOST" \
        --argjson state "$(jq '.' "$STATE_FILE")" \
        --argjson transition "$transition_json" \
        --argjson report "$report_json" \
        --argjson executor_e "$executor_json" \
        --argjson watchdog "$watchdog_json" \
        --argjson recovery "$recovery_json" \
        --argjson hardware "$hardware_json" \
        '{
          schema_version: ($schema_version|tonumber),
          device_id: $device_id,
          timestamp: $timestamp,
          hostname: $hostname,
          mode: ($state.mode // "unknown"),
          state: ($state.state // "unknown"),
          online: true,
          tailscale: {
            connected: ($state.network.tailscale // false),
            ip: ($state.network.tailscale_ip // "unknown")
          },
          network: {
            active_profile: ($state.network.wifi_profile // "unknown"),
            interface: ($state.network.interface // "unknown"),
            ipv4: ($state.network.ipv4 // "unknown")
          },
          mission_observed_state: ($state.mission // {}),
          transition: {
            state: ($transition.transition.state // "unknown"),
            active: ($transition.transition.active // "unknown"),
            transaction_id: ($transition.transition.transition_id // "none"),
            last_preflight_id: ($transition.preflight.last_transaction_id // "none"),
            last_preflight_result: ($transition.preflight.last_result // "none"),
            rollback_snapshot_valid: ($transition.preflight.snapshot_valid // "unknown"),
            rollback_verifier: ($transition.rollback_plan.verifier_result // "none"),
            recovery_readiness: ($transition.rollback_plan.readiness // "none")
          },
	          executor: {
	            backend: ($transition.executor.backend // "simulation"),
	            live_enabled: ($transition.executor.live_enabled // "NO"),
	            last_simulation_id: ($transition.executor.last_simulation_id // "none"),
	            last_simulation_result: ($transition.executor.last_simulation_result // "none"),
	            rollback_required: ($transition.executor.rollback_required // "false"),
	            rollback_result: ($transition.executor.rollback_result // "none"),
	            armed_state: ($executor_e.arming.status // "not-armed"),
	            hardware_readiness: ($hardware.eligibility // "unknown"),
	            watchdog_state: ($watchdog.state // "unknown"),
	            recovery_state: ($recovery.decision // "unknown"),
	            live_callable: ($executor_e.callable // false),
	            blocker_count: ($executor_e.blocker_count // 0)
	          },
          sidecar: {
            interface: $nano_interface,
            management_path: $nano_host
          },
          gps: ($state.gps // {}),
          services: ($report.services // {})
        }'
}

mission_probe_health_json() {
    local endpoints timeout max_time endpoint status payload error reachable healthy postgres redis
    endpoints="$(mission_health_endpoints)"
    timeout="$(config_value MISSION_CONNECT_TIMEOUT "3")"
    max_time="$(config_value MISSION_MAX_TIME "5")"
    reachable="false"
    healthy="false"
    status="offline"
    endpoint="none"
    error="no-endpoints-configured"
    postgres="unknown"
    redis="unknown"

    for endpoint in $endpoints; do
        payload="$(curl -fsS --connect-timeout "$timeout" --max-time "$max_time" -H "Accept: application/json" "$endpoint" 2>/tmp/warpi-mission-curl.err || true)"
        if [[ -z "$payload" ]]; then
            error="$(cat /tmp/warpi-mission-curl.err 2>/dev/null || echo connection-failed)"
            continue
        fi
        if ! jq -e 'type == "object"' <<<"$payload" >/dev/null 2>&1; then
            error="invalid-json"
            continue
        fi
        reachable="true"
        endpoint="$endpoint"
        status="$(jq -r '.status // "unknown"' <<<"$payload")"
        postgres="$(jq -r 'if .postgres == true then "healthy" elif .postgres == false then "unhealthy" else "unknown" end' <<<"$payload")"
        redis="$(jq -r 'if .redis == true then "healthy" elif .redis == false then "unhealthy" else "unknown" end' <<<"$payload")"
        if [[ "${status,,}" == "healthy" && "$postgres" == "healthy" && "$redis" == "healthy" ]]; then
            healthy="true"
        fi
        error=""
        break
    done
    rm -f /tmp/warpi-mission-curl.err

    jq -n \
        --arg enabled "$(config_value MISSION_ENABLED "true")" \
        --arg endpoints "$endpoints" \
        --arg endpoint "$endpoint" \
        --arg reachable "$reachable" \
        --arg healthy "$healthy" \
        --arg status "$status" \
        --arg postgres "$postgres" \
        --arg redis "$redis" \
        --arg error "$error" \
        --arg auth "$(mission_auth_configured)" \
        --arg device_id "$(mission_device_id)" \
        --arg last_file "$(mission_last_checkin_file)" \
        '{
          schema_version: 1,
          enabled: ($enabled == "true" or $enabled == "TRUE" or $enabled == "yes" or $enabled == "YES"),
          configured_endpoints: ($endpoints | split(" ") | map(select(length > 0))),
          selected_endpoint: $endpoint,
          reachable: ($reachable == "true"),
          healthy: ($healthy == "true"),
          status: $status,
          postgres: $postgres,
          redis: $redis,
          error: $error,
          authentication_configured: ($auth == "YES"),
          device_id: $device_id,
          last_checkin_file: $last_file
        }'
}

mission_status() {
    local output_format="${1:-human}" status_json last_file
    if [[ "${EUID:-$(id -u)}" -ne 0 && "$(mission_state_dir)" != /tmp/* ]]; then
        if sudo -n true 2>/dev/null; then
            if [[ "$output_format" == "json" || "$output_format" == "--json" ]]; then
                exec sudo -n "$0" mission status --json
            fi
            exec sudo -n "$0" mission status
        fi
    fi
    status_json="$(mission_probe_health_json)"
    last_file="$(mission_last_checkin_file)"
    if [[ "$output_format" == "json" || "$output_format" == "--json" ]]; then
        jq --argjson last "$(if require_json_object_file "$last_file"; then jq '.' "$last_file"; else echo '{}'; fi)" '.last_checkin = $last' <<<"$status_json"
        return
    fi
    echo
    echo "============================================================"
    echo "              WARPi MISSION CONTROL"
    echo "============================================================"
    echo
    printf "%-30s %s\n" "Enabled:" "$(jq -r '.enabled' <<<"$status_json")"
    printf "%-30s %s\n" "Configured endpoints:" "$(jq -r '.configured_endpoints | join(", ")' <<<"$status_json")"
    printf "%-30s %s\n" "Selected endpoint:" "$(jq -r '.selected_endpoint' <<<"$status_json")"
    printf "%-30s %s\n" "Reachable:" "$(jq -r '.reachable' <<<"$status_json")"
    printf "%-30s %s\n" "Healthy:" "$(jq -r '.healthy' <<<"$status_json")"
    printf "%-30s %s\n" "Status:" "$(jq -r '.status' <<<"$status_json")"
    printf "%-30s %s\n" "PostgreSQL:" "$(jq -r '.postgres' <<<"$status_json")"
    printf "%-30s %s\n" "Redis:" "$(jq -r '.redis' <<<"$status_json")"
    printf "%-30s %s\n" "Auth configured:" "$(jq -r '.authentication_configured' <<<"$status_json")"
    printf "%-30s %s\n" "Device ID:" "$(jq -r '.device_id' <<<"$status_json")"
    if require_json_object_file "$last_file"; then
        printf "%-30s %s\n" "Last check-in:" "$(jq -r '.completed_at // "none"' "$last_file")"
        printf "%-30s %s\n" "Last check-in result:" "$(jq -r '.result // "none"' "$last_file")"
    else
        printf "%-30s %s\n" "Last check-in:" "none"
        printf "%-30s %s\n" "Last check-in result:" "none"
    fi
    printf "%-30s %s\n" "Error:" "$(jq -r '.error' <<<"$status_json")"
    echo
    echo "Mission Control failure does not block local WARPi operation."
    echo
    echo "============================================================"
}

mission_check_in() {
    local output_format="${1:-human}" endpoints timeout max_time payload endpoint response result error completed_at state_dir last_file auth_args=()
    require_state
    if [[ "${EUID:-$(id -u)}" -ne 0 && "$(mission_state_dir)" != /tmp/* ]]; then
        if sudo -n true 2>/dev/null; then
            if [[ "$output_format" == "json" || "$output_format" == "--json" ]]; then
                exec sudo -n "$0" mission check-in --json
            fi
            exec sudo -n "$0" mission check-in
        fi
        echo "warpi mission check-in requires root or passwordless sudo for protected check-in metadata writes." >&2
        exit 1
    fi
    endpoints="$(mission_checkin_endpoints)"
    timeout="$(config_value MISSION_CONNECT_TIMEOUT "3")"
    max_time="$(config_value MISSION_MAX_TIME "5")"
    payload="$(mission_collect_payload)"
    result="failed"
    endpoint="none"
    response=""
    error="no-checkin-endpoints-configured"
    completed_at="$(utc_now)"
    state_dir="$(mission_state_dir)"
    last_file="$(mission_last_checkin_file)"
    mapfile -t auth_args < <(mission_auth_args)

    for endpoint in $endpoints; do
        response="$(curl -fsS --connect-timeout "$timeout" --max-time "$max_time" \
            -H "Content-Type: application/json" -H "Accept: application/json" \
            "${auth_args[@]}" \
            --data-binary "$payload" "$endpoint" 2>/tmp/warpi-mission-checkin.err || true)"
        if [[ -n "$response" ]]; then
            result="success"
            error=""
            break
        fi
        error="$(cat /tmp/warpi-mission-checkin.err 2>/dev/null || echo connection-failed)"
    done
    rm -f /tmp/warpi-mission-checkin.err
    mkdir -p "$state_dir"
    chmod 750 "$state_dir" 2>/dev/null || true
    jq -n \
        --arg schema_version "1" \
        --arg completed_at "$completed_at" \
        --arg endpoint "$endpoint" \
        --arg result "$result" \
        --arg error "$error" \
        --arg auth "$(mission_auth_configured)" \
        --argjson payload "$payload" \
        '{
          schema_version: ($schema_version|tonumber),
          completed_at: $completed_at,
          endpoint: $endpoint,
          result: $result,
          error: $error,
          authentication_configured: ($auth == "YES"),
          payload_summary: {
            device_id: $payload.device_id,
            mode: $payload.mode,
            state: $payload.state,
            transition_state: $payload.transition.state,
            executor_backend: $payload.executor.backend,
            live_executor_enabled: $payload.executor.live_enabled
          }
        }' | atomic_write_json "$last_file" 640 root "$(transition_read_group)"

    if [[ "$output_format" == "json" || "$output_format" == "--json" ]]; then
        jq '.' "$last_file"
        return
    fi
    echo
    echo "============================================================"
    echo "           WARPi MISSION CONTROL CHECK-IN"
    echo "============================================================"
    echo
    printf "%-30s %s\n" "Result:" "$result"
    printf "%-30s %s\n" "Endpoint:" "$endpoint"
    printf "%-30s %s\n" "Device ID:" "$(jq -r '.payload_summary.device_id' "$last_file")"
    printf "%-30s %s\n" "Mode/state:" "$(jq -r '.payload_summary.mode + "/" + .payload_summary.state' "$last_file")"
    printf "%-30s %s\n" "Transition state:" "$(jq -r '.payload_summary.transition_state' "$last_file")"
    printf "%-30s %s\n" "Executor backend:" "$(jq -r '.payload_summary.executor_backend' "$last_file")"
    printf "%-30s %s\n" "Live executor enabled:" "$(jq -r '.payload_summary.live_executor_enabled' "$last_file")"
    printf "%-30s %s\n" "Error:" "$error"
    echo
    echo "Mission Control check-in failure does not block local WARPi operation."
    echo
    echo "============================================================"
    [[ "$result" == "success" ]]
}

mode_status() {
    require_state

    FIELD_PROFILE="$(config_value FIELD_PROFILE "$FIELD_PROFILE")"
    FIELD_MARKER="$(config_value FIELD_MARKER "$FIELD_MARKER")"

    local mode state reason updated field_mode profile marker_status service_status
    mode="$(json_value '.mode')"
    state="$(json_value '.state')"
    reason="$(json_value '.reason')"
    updated="$(json_value '.updated')"
    field_mode="$(json_bool '.network.field_mode')"
    profile="$(json_value '.network.wifi_profile' 'none')"
    service_status="$(systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true)"

    if [[ -e "$FIELD_MARKER" ]]; then
        marker_status="present"
    else
        marker_status="absent"
    fi

    echo
    echo "============================================================"
    echo "                    WARPi MODE"
    echo "============================================================"
    echo
    printf "%-20s %s\n" "Mode:" "$mode"
    printf "%-20s %s\n" "State:" "$state"
    printf "%-20s %s\n" "Reason:" "$reason"
    printf "%-20s %s\n" "Field mode:" "$field_mode"
    printf "%-20s %s\n" "Active profile:" "$profile"
    printf "%-20s %s\n" "Field profile:" "$FIELD_PROFILE"
    printf "%-20s %s\n" "Field marker:" "$marker_status ($FIELD_MARKER)"
    printf "%-20s %s\n" "KERNEL service:" "$service_status"
    printf "%-20s %s\n" "Last update:" "$updated"
    echo
    echo "============================================================"
}

mode_enter_field_plan() {
    require_state

    FIELD_PROFILE="$(config_value FIELD_PROFILE "$FIELD_PROFILE")"
    FIELD_MARKER="$(config_value FIELD_MARKER "$FIELD_MARKER")"

    local mode state reason field_mode active_profile active_ssid service_status
    local field_profile_status field_autoconnect field_iface field_wifi_mode
    local field_ipv4_method field_ipv4_addresses field_ipv6_method marker_status
    local ssh_status kismet_status tailscale_status

    mode="$(json_value '.mode')"
    state="$(json_value '.state')"
    reason="$(json_value '.reason')"
    field_mode="$(json_bool '.network.field_mode')"
    active_profile="$(json_value '.network.wifi_profile' 'none')"
    active_ssid="$(json_value '.network.wifi_ssid' 'none')"
    service_status="$(systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true)"
    ssh_status="$(systemctl is-active ssh.service 2>/dev/null || true)"
    kismet_status="$(systemctl is-active kismet.service 2>/dev/null || true)"
    tailscale_status="$(json_bool '.network.tailscale')"

    if nmcli connection show "$FIELD_PROFILE" >/dev/null 2>&1; then
        field_profile_status="present"
        field_autoconnect="$(nmcli -g connection.autoconnect connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_iface="$(nmcli -g connection.interface-name connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_wifi_mode="$(nmcli -g 802-11-wireless.mode connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv4_method="$(nmcli -g ipv4.method connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv4_addresses="$(nmcli -g ipv4.addresses connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv6_method="$(nmcli -g ipv6.method connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
    else
        field_profile_status="missing"
        field_autoconnect="unknown"
        field_iface="unknown"
        field_wifi_mode="unknown"
        field_ipv4_method="unknown"
        field_ipv4_addresses="unknown"
        field_ipv6_method="unknown"
    fi

    if [[ -e "$FIELD_MARKER" ]]; then
        marker_status="present"
    else
        marker_status="absent"
    fi

    echo
    echo "============================================================"
    echo "              WARPi ENTER FIELD PLAN"
    echo "============================================================"
    echo
    echo "Dry run only. No files, services, routes, radios, or NetworkManager profiles were changed."
    echo
    echo "CURRENT STATE"
    echo "------------------------------------------------------------"
    printf "%-22s %s\n" "Mode:" "$mode"
    printf "%-22s %s\n" "State:" "$state"
    printf "%-22s %s\n" "Reason:" "$reason"
    printf "%-22s %s\n" "Field mode:" "$field_mode"
    printf "%-22s %s\n" "Active profile:" "$active_profile"
    printf "%-22s %s\n" "Active SSID:" "$active_ssid"
    printf "%-22s %s\n" "KERNEL service:" "$service_status"
    printf "%-22s %s\n" "SSH service:" "$ssh_status"
    printf "%-22s %s\n" "Kismet service:" "$kismet_status"
    printf "%-22s %s\n" "Tailscale connected:" "$tailscale_status"
    echo
    echo "FIELD PROFILE"
    echo "------------------------------------------------------------"
    printf "%-22s %s\n" "Name:" "$FIELD_PROFILE"
    printf "%-22s %s\n" "Status:" "$field_profile_status"
    printf "%-22s %s\n" "Interface:" "$field_iface"
    printf "%-22s %s\n" "Autoconnect:" "$field_autoconnect"
    printf "%-22s %s\n" "Wi-Fi mode:" "$field_wifi_mode"
    printf "%-22s %s\n" "IPv4 method:" "$field_ipv4_method"
    printf "%-22s %s\n" "IPv4 address:" "$field_ipv4_addresses"
    printf "%-22s %s\n" "IPv6 method:" "$field_ipv6_method"
    printf "%-22s %s\n" "Field marker:" "$marker_status ($FIELD_MARKER)"
    transition_dry_run_summary "NORMAL -> FIELD" "$mode" "FIELD"
    echo
    echo "PROPOSED APPLY SEQUENCE"
    echo "------------------------------------------------------------"
    echo "1. Confirm local/console recovery and authorized field profile."
    echo "2. Run field preparation checks for NetworkManager, SSH, IPv4 forwarding, and firewall rules."
    echo "3. Bring up NetworkManager profile: $FIELD_PROFILE."
    echo "4. Create field marker: $FIELD_MARKER."
    echo "5. Start or validate field services such as SSH and Kismet."
    echo "6. Wait for /run/warpi/state.json to report FIELD or a clear degraded state."
    echo "7. Verify operator access path before considering the transition complete."
    echo
    echo "ROLLBACK EXPECTATION"
    echo "------------------------------------------------------------"
    echo "A future return-normal command should bring trusted Wi-Fi back up, remove the field marker, stop field-only services when appropriate, and verify NORMAL/CONNECTED or a clear degraded state."
    echo
    echo "NEXT ENABLEMENT GATE"
    echo "------------------------------------------------------------"
    echo "Implement apply mode only after this plan matches the real field workflow and recovery path."
    echo
    echo "============================================================"
}

