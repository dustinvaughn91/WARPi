#!/bin/bash
set -euo pipefail

STATE_FILE="${STATE_FILE:-/run/warpi/state.json}"
CONFIG_FILE="${CONFIG_FILE:-/etc/warpi/kernel.conf}"
KERNEL_SERVICE="${KERNEL_SERVICE:-warpi-kernel.service}"
FIELD_PROFILE="${FIELD_PROFILE:-WARPi-Field}"
FIELD_MARKER="${FIELD_MARKER:-/tmp/warpi_fieldmode}"
NANO_INTERFACE="${NANO_INTERFACE:-eth1}"
NANO_HOST="${NANO_HOST:-172.16.42.1}"
NANO_UI_PORT="${NANO_UI_PORT:-1471}"
TRANSITION_LOCK_FILE="${TRANSITION_LOCK_FILE:-/run/warpi/mode-transition.lock}"
TRANSITION_STATE_FILE="${TRANSITION_STATE_FILE:-/run/warpi/mode-transition-state.json}"
TRANSITION_CURRENT_FILE="${TRANSITION_CURRENT_FILE:-/run/warpi/mode-transition-current.json}"
TRANSITION_RECOVERY_DIR="${TRANSITION_RECOVERY_DIR:-/var/lib/warpi/mode-transitions}"
TRANSITION_ROLLBACK_FILE="${TRANSITION_ROLLBACK_FILE:-/var/lib/warpi/mode-transitions/rollback-plan.json}"
TRANSITION_PENDING_FILE="${TRANSITION_PENDING_FILE:-/var/lib/warpi/mode-transitions/pending-transition.json}"
TRANSITION_APPLY_GATE="apply mode is disabled until transaction execution, rollback, boot recovery, and staged live tests are approved"

config_value() {
    local key="$1"
    local fallback="$2"

    if [[ -r "$CONFIG_FILE" ]]; then
        awk -F= -v key="$key" '
            $1 == key {
                value = $2
                gsub(/^"/, "", value)
                gsub(/"$/, "", value)
                print value
                found = 1
                exit
            }
            END {
                if (!found) {
                    exit 1
                }
            }
        ' "$CONFIG_FILE" 2>/dev/null || printf '%s\n' "$fallback"
    else
        printf '%s\n' "$fallback"
    fi
}

json_value() {
    local expression="$1"
    local fallback="${2:-unknown}"

    jq -r "$expression // \"$fallback\"" "$STATE_FILE"
}

json_bool() {
    local expression="$1"

    if [[ "$(jq -r "$expression // false" "$STATE_FILE")" == "true" ]]; then
        echo "YES"
    else
        echo "NO"
    fi
}

usage() {
    cat <<'EOF'

WARPi command menu

Usage:
  warpi help
  warpi status
  warpi mode status
  warpi mode transition-status
  warpi mode enter-field
  warpi mode return-normal
  warpi wireless status
  warpi field health
  warpi field setup
  warpi report
  warpi docs audit

Commands:
  help              Show this menu.
  status            Show full WARPi K.E.R.N.E.L. status.
  mode status       Show current NORMAL/FIELD mode state.
  mode transition-status
                    Show read-only mode-transition state, lock, and rollback status.
  mode enter-field  Show the Field Mode transition plan without changing state.
  mode return-normal Show the Normal Mode transition plan without changing state.
  wireless status   Show read-only WiFi Pineapple NANO sidecar reachability.
  field health      Show field-mode network and service health.
  field setup       Prepare field-mode networking/firewall support.
  report            Emit kernel-report JSON.
  docs audit        Emit kernel-doc-audit JSON.

Mode switching:
  enter-field and return-normal are dry-run only. Apply mode is intentionally not enabled yet.
  transition-status is read-only and supports --json for machine-readable output.

Wireless:
  wireless status is read-only. It does not start scans, change radios, or modify NANO state.
EOF
}

require_state() {
    if [[ ! -r "$STATE_FILE" ]]; then
        echo "WARPi state is unavailable: $STATE_FILE" >&2
        systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true
        exit 1
    fi
}

transition_lock_file() {
    printf '%s\n' "${WARPI_TRANSITION_LOCK_FILE:-$TRANSITION_LOCK_FILE}"
}

transition_state_file() {
    printf '%s\n' "${WARPI_TRANSITION_STATE_FILE:-$TRANSITION_STATE_FILE}"
}

transition_current_file() {
    printf '%s\n' "${WARPI_TRANSITION_CURRENT_FILE:-$TRANSITION_CURRENT_FILE}"
}

transition_rollback_file() {
    printf '%s\n' "${WARPI_TRANSITION_ROLLBACK_FILE:-$TRANSITION_ROLLBACK_FILE}"
}

transition_pending_file() {
    printf '%s\n' "${WARPI_TRANSITION_PENDING_FILE:-$TRANSITION_PENDING_FILE}"
}

transition_state_allowed() {
    case "$1" in
        IDLE|PREPARING|VALIDATING|READY|APPLYING|VERIFYING|COMPLETED|ROLLING_BACK|ROLLED_BACK|FAILED)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

transition_direction_allowed() {
    case "$1" in
        ""|"none"|"NORMAL_TO_FIELD"|"FIELD_TO_NORMAL"|"NORMAL -> FIELD"|"FIELD -> NORMAL")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

transition_active_state() {
    case "$1" in
        PREPARING|VALIDATING|READY|APPLYING|VERIFYING|ROLLING_BACK)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

transition_file_status() {
    local path="$1"

    if [[ -L "$path" ]]; then
        echo "unsafe-symlink"
    elif [[ -e "$path" ]]; then
        echo "present"
    else
        echo "absent"
    fi
}

transition_json_value() {
    local file="$1"
    local expression="$2"
    local fallback="${3:-none}"

    jq -r "$expression // \"$fallback\"" "$file" 2>/dev/null || printf '%s\n' "$fallback"
}

transition_status_values() {
    require_state

    local lock_file state_file current_file rollback_file pending_file
    local mode state_file_status current_file_status rollback_status pending_status lock_status
    local transition_state transition_active direction transition_id source_mode target_mode
    local started_at updated_at completed_at failure_reason rollback_available
    local last_attempted last_completed last_result last_event validation_status blockers
    local apply_prereqs apply_eligible unsafe_reasons lock_detail

    lock_file="$(transition_lock_file)"
    state_file="$(transition_state_file)"
    current_file="$(transition_current_file)"
    rollback_file="$(transition_rollback_file)"
    pending_file="$(transition_pending_file)"
    mode="$(json_value '.mode')"

    lock_status="$(transition_file_status "$lock_file")"
    state_file_status="$(transition_file_status "$state_file")"
    current_file_status="$(transition_file_status "$current_file")"
    rollback_status="$(transition_file_status "$rollback_file")"
    pending_status="$(transition_file_status "$pending_file")"

    transition_state="IDLE"
    transition_active="NO"
    direction="none"
    transition_id="none"
    source_mode="none"
    target_mode="none"
    started_at="none"
    updated_at="none"
    completed_at="none"
    failure_reason="none"
    rollback_available="NO"
    last_attempted="none"
    last_completed="none"
    last_result="none"
    last_event="none"
    validation_status="clean"
    blockers="none"
    unsafe_reasons=""
    lock_detail="none"

    if [[ "$lock_status" == "unsafe-symlink" ]]; then
        unsafe_reasons="${unsafe_reasons}lock path is a symlink; "
        lock_detail="unsafe symlink"
    elif [[ "$lock_status" == "present" ]]; then
        lock_detail="$(head -n 1 "$lock_file" 2>/dev/null || echo unreadable)"
    fi

    if [[ "$state_file_status" == "unsafe-symlink" || "$current_file_status" == "unsafe-symlink" ]]; then
        unsafe_reasons="${unsafe_reasons}transition metadata path is a symlink; "
    fi

    if [[ "$state_file_status" == "present" ]]; then
        if jq -e . "$state_file" >/dev/null 2>&1; then
            transition_state="$(transition_json_value "$state_file" '.state' 'IDLE')"
            direction="$(transition_json_value "$state_file" '.direction' 'none')"
            transition_id="$(transition_json_value "$state_file" '.transition_id' 'none')"
            source_mode="$(transition_json_value "$state_file" '.source_mode' 'none')"
            target_mode="$(transition_json_value "$state_file" '.target_mode' 'none')"
            started_at="$(transition_json_value "$state_file" '.started_at' 'none')"
            updated_at="$(transition_json_value "$state_file" '.updated_at' 'none')"
            completed_at="$(transition_json_value "$state_file" '.completed_at' 'none')"
            failure_reason="$(transition_json_value "$state_file" '.failure_reason' 'none')"
            rollback_available="$(transition_json_value "$state_file" '.rollback_available' 'false')"
            last_attempted="$(transition_json_value "$state_file" '.last_attempted_transition' "$direction")"
            last_completed="$(transition_json_value "$state_file" '.last_completed_transition' 'none')"
            last_result="$(transition_json_value "$state_file" '.last_result' 'none')"
            last_event="$(transition_json_value "$state_file" '.last_event_at' "$updated_at")"
        else
            unsafe_reasons="${unsafe_reasons}transition state JSON is malformed; "
            transition_state="UNKNOWN"
            validation_status="unsafe"
        fi
    fi

    if [[ "$current_file_status" == "present" ]]; then
        if jq -e . "$current_file" >/dev/null 2>&1; then
            if [[ "$transition_id" == "none" ]]; then
                transition_id="$(transition_json_value "$current_file" '.transition_id' 'none')"
            fi
            if [[ "$direction" == "none" ]]; then
                direction="$(transition_json_value "$current_file" '.direction' 'none')"
            fi
        else
            unsafe_reasons="${unsafe_reasons}current transaction JSON is malformed; "
            validation_status="unsafe"
        fi
    fi

    if ! transition_state_allowed "$transition_state"; then
        unsafe_reasons="${unsafe_reasons}unknown transition state '$transition_state'; "
        validation_status="unsafe"
    fi
    if ! transition_direction_allowed "$direction"; then
        unsafe_reasons="${unsafe_reasons}unknown transition direction '$direction'; "
        validation_status="unsafe"
    fi
    if [[ "$direction" == "NORMAL_TO_FIELD" || "$direction" == "NORMAL -> FIELD" ]]; then
        if [[ "$source_mode" != "none" && "$source_mode" != "NORMAL" ]]; then
            unsafe_reasons="${unsafe_reasons}direction/source mode contradiction; "
            validation_status="unsafe"
        fi
        if [[ "$target_mode" != "none" && "$target_mode" != "FIELD" ]]; then
            unsafe_reasons="${unsafe_reasons}direction/target mode contradiction; "
            validation_status="unsafe"
        fi
    fi
    if [[ "$direction" == "FIELD_TO_NORMAL" || "$direction" == "FIELD -> NORMAL" ]]; then
        if [[ "$source_mode" != "none" && "$source_mode" != "FIELD" ]]; then
            unsafe_reasons="${unsafe_reasons}direction/source mode contradiction; "
            validation_status="unsafe"
        fi
        if [[ "$target_mode" != "none" && "$target_mode" != "NORMAL" ]]; then
            unsafe_reasons="${unsafe_reasons}direction/target mode contradiction; "
            validation_status="unsafe"
        fi
    fi

    if transition_active_state "$transition_state" || [[ "$lock_status" == "present" || "$current_file_status" == "present" || "$pending_status" == "present" ]]; then
        transition_active="YES"
    fi

    case "$rollback_available" in
        true|TRUE|yes|YES)
            rollback_available="YES"
            ;;
        *)
            if [[ "$rollback_status" == "present" ]]; then
                rollback_available="YES"
            else
                rollback_available="NO"
            fi
            ;;
    esac

    if [[ "$lock_status" == "present" ]]; then
        blockers="transition lock exists"
    elif [[ "$validation_status" == "unsafe" ]]; then
        blockers="$unsafe_reasons"
    else
        blockers="apply execution not implemented"
    fi

    apply_prereqs="partial: status, lock, transaction, and rollback metadata framework present; mutating executor and staged recovery tests missing"
    apply_eligible="NO"

    jq -n \
        --arg mode "$mode" \
        --arg state "$transition_state" \
        --arg active "$transition_active" \
        --arg direction "$direction" \
        --arg transition_id "$transition_id" \
        --arg source_mode "$source_mode" \
        --arg target_mode "$target_mode" \
        --arg started_at "$started_at" \
        --arg updated_at "$updated_at" \
        --arg completed_at "$completed_at" \
        --arg failure_reason "$failure_reason" \
        --arg last_attempted "$last_attempted" \
        --arg last_completed "$last_completed" \
        --arg last_result "$last_result" \
        --arg last_event "$last_event" \
        --arg lock_status "$lock_status" \
        --arg lock_detail "$lock_detail" \
        --arg lock_file "$lock_file" \
        --arg state_file "$state_file" \
        --arg current_file "$current_file" \
        --arg rollback_status "$rollback_status" \
        --arg rollback_file "$rollback_file" \
        --arg pending_status "$pending_status" \
        --arg pending_file "$pending_file" \
        --arg rollback_available "$rollback_available" \
        --arg validation_status "$validation_status" \
        --arg blockers "$blockers" \
        --arg apply_gate "$TRANSITION_APPLY_GATE" \
        --arg apply_prereqs "$apply_prereqs" \
        --arg apply_eligible "$apply_eligible" \
        '{
          schema_version: 1,
          mode: $mode,
          transition: {
            state: $state,
            active: $active,
            direction: $direction,
            transition_id: $transition_id,
            source_mode: $source_mode,
            target_mode: $target_mode,
            started_at: $started_at,
            updated_at: $updated_at,
            completed_at: $completed_at,
            failure_reason: $failure_reason,
            last_attempted_transition: $last_attempted,
            last_completed_transition: $last_completed,
            last_result: $last_result,
            last_event_at: $last_event
          },
          lock: {
            status: $lock_status,
            detail: $lock_detail,
            path: $lock_file
          },
          metadata: {
            state_path: $state_file,
            current_transaction_path: $current_file,
            pending_path: $pending_file,
            pending_status: $pending_status
          },
          rollback: {
            available: $rollback_available,
            status: $rollback_status,
            path: $rollback_file
          },
          validation: {
            status: $validation_status,
            blockers: $blockers,
            future_apply_prerequisites: $apply_prereqs,
            future_apply_eligible: $apply_eligible,
            apply_gate: $apply_gate
          }
        }'
}

transition_status_json() {
    transition_status_values
}

transition_status() {
    local status_json="$1"

    echo
    echo "============================================================"
    echo "          WARPi MODE TRANSITION STATUS"
    echo "============================================================"
    echo
    printf "%-32s %s\n" "Current WARPi mode:" "$(jq -r '.mode' <<<"$status_json")"
    printf "%-32s %s\n" "Current transition state:" "$(jq -r '.transition.state' <<<"$status_json")"
    printf "%-32s %s\n" "Transition active:" "$(jq -r '.transition.active' <<<"$status_json")"
    printf "%-32s %s\n" "Direction:" "$(jq -r '.transition.direction' <<<"$status_json")"
    printf "%-32s %s\n" "Transaction ID:" "$(jq -r '.transition.transition_id' <<<"$status_json")"
    printf "%-32s %s\n" "Source mode:" "$(jq -r '.transition.source_mode' <<<"$status_json")"
    printf "%-32s %s\n" "Target mode:" "$(jq -r '.transition.target_mode' <<<"$status_json")"
    printf "%-32s %s\n" "Last attempted:" "$(jq -r '.transition.last_attempted_transition' <<<"$status_json")"
    printf "%-32s %s\n" "Last completed:" "$(jq -r '.transition.last_completed_transition' <<<"$status_json")"
    printf "%-32s %s\n" "Last result:" "$(jq -r '.transition.last_result' <<<"$status_json")"
    printf "%-32s %s\n" "Last event:" "$(jq -r '.transition.last_event_at' <<<"$status_json")"
    echo
    printf "%-32s %s\n" "Lock status:" "$(jq -r '.lock.status' <<<"$status_json")"
    printf "%-32s %s\n" "Lock detail:" "$(jq -r '.lock.detail' <<<"$status_json")"
    printf "%-32s %s\n" "Lock path:" "$(jq -r '.lock.path' <<<"$status_json")"
    printf "%-32s %s\n" "State metadata path:" "$(jq -r '.metadata.state_path' <<<"$status_json")"
    printf "%-32s %s\n" "Current transaction path:" "$(jq -r '.metadata.current_transaction_path' <<<"$status_json")"
    printf "%-32s %s\n" "Pending metadata:" "$(jq -r '.metadata.pending_status' <<<"$status_json")"
    printf "%-32s %s\n" "Pending metadata path:" "$(jq -r '.metadata.pending_path' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback metadata:" "$(jq -r '.rollback.status' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback available:" "$(jq -r '.rollback.available' <<<"$status_json")"
    printf "%-32s %s\n" "Rollback metadata path:" "$(jq -r '.rollback.path' <<<"$status_json")"
    echo
    printf "%-32s %s\n" "Validation status:" "$(jq -r '.validation.status' <<<"$status_json")"
    printf "%-32s %s\n" "Future apply eligible:" "$(jq -r '.validation.future_apply_eligible' <<<"$status_json")"
    printf "%-32s %s\n" "Future apply prerequisites:" "$(jq -r '.validation.future_apply_prerequisites' <<<"$status_json")"
    printf "%-32s %s\n" "Apply gate:" "$(jq -r '.validation.apply_gate' <<<"$status_json")"
    printf "%-32s %s\n" "Blockers:" "$(jq -r '.validation.blockers' <<<"$status_json")"
    echo
    echo "============================================================"
}

transition_dry_run_summary() {
    local direction="$1"
    local source_mode="$2"
    local target_mode="$3"
    local status_json lock_status active validation blockers eligible

    status_json="$(transition_status_values)"
    lock_status="$(jq -r '.lock.status' <<<"$status_json")"
    active="$(jq -r '.transition.active' <<<"$status_json")"
    validation="$(jq -r '.validation.status' <<<"$status_json")"
    blockers="$(jq -r '.validation.blockers' <<<"$status_json")"
    eligible="$(jq -r '.validation.future_apply_eligible' <<<"$status_json")"

    echo
    echo "TRANSITION FRAMEWORK"
    echo "------------------------------------------------------------"
    printf "%-22s %s\n" "Direction:" "$direction"
    printf "%-22s %s\n" "Intended source:" "$source_mode"
    printf "%-22s %s\n" "Intended target:" "$target_mode"
    printf "%-22s %s\n" "Current state:" "$(jq -r '.transition.state' <<<"$status_json")"
    printf "%-22s %s\n" "Transition active:" "$active"
    printf "%-22s %s\n" "Lock status:" "$lock_status"
    printf "%-22s %s\n" "Validation:" "$validation"
    printf "%-22s %s\n" "Future apply:" "$eligible"
    printf "%-22s %s\n" "Blockers:" "$blockers"
    echo "Dry run does not create, update, or clear transition metadata."
}

mode_status() {
    require_state

    FIELD_PROFILE="$(config_value FIELD_PROFILE "$FIELD_PROFILE")"
    FIELD_MARKER="$(config_value FIELD_MARKER "$FIELD_MARKER")"

    local mode state reason updated field_mode profile marker_status service_status
    mode="$(json_value '.mode')"
    state="$(json_value '.state')"
    reason="$(json_value '.reason')"
    updated="$(json_value '.updated')"
    field_mode="$(json_bool '.network.field_mode')"
    profile="$(json_value '.network.wifi_profile' 'none')"
    service_status="$(systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true)"

    if [[ -e "$FIELD_MARKER" ]]; then
        marker_status="present"
    else
        marker_status="absent"
    fi

    echo
    echo "============================================================"
    echo "                    WARPi MODE"
    echo "============================================================"
    echo
    printf "%-20s %s\n" "Mode:" "$mode"
    printf "%-20s %s\n" "State:" "$state"
    printf "%-20s %s\n" "Reason:" "$reason"
    printf "%-20s %s\n" "Field mode:" "$field_mode"
    printf "%-20s %s\n" "Active profile:" "$profile"
    printf "%-20s %s\n" "Field profile:" "$FIELD_PROFILE"
    printf "%-20s %s\n" "Field marker:" "$marker_status ($FIELD_MARKER)"
    printf "%-20s %s\n" "KERNEL service:" "$service_status"
    printf "%-20s %s\n" "Last update:" "$updated"
    echo
    echo "============================================================"
}

mode_enter_field_plan() {
    require_state

    FIELD_PROFILE="$(config_value FIELD_PROFILE "$FIELD_PROFILE")"
    FIELD_MARKER="$(config_value FIELD_MARKER "$FIELD_MARKER")"

    local mode state reason field_mode active_profile active_ssid service_status
    local field_profile_status field_autoconnect field_iface field_wifi_mode
    local field_ipv4_method field_ipv4_addresses field_ipv6_method marker_status
    local ssh_status kismet_status tailscale_status

    mode="$(json_value '.mode')"
    state="$(json_value '.state')"
    reason="$(json_value '.reason')"
    field_mode="$(json_bool '.network.field_mode')"
    active_profile="$(json_value '.network.wifi_profile' 'none')"
    active_ssid="$(json_value '.network.wifi_ssid' 'none')"
    service_status="$(systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true)"
    ssh_status="$(systemctl is-active ssh.service 2>/dev/null || true)"
    kismet_status="$(systemctl is-active kismet.service 2>/dev/null || true)"
    tailscale_status="$(json_bool '.network.tailscale')"

    if nmcli connection show "$FIELD_PROFILE" >/dev/null 2>&1; then
        field_profile_status="present"
        field_autoconnect="$(nmcli -g connection.autoconnect connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_iface="$(nmcli -g connection.interface-name connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_wifi_mode="$(nmcli -g 802-11-wireless.mode connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv4_method="$(nmcli -g ipv4.method connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv4_addresses="$(nmcli -g ipv4.addresses connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv6_method="$(nmcli -g ipv6.method connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
    else
        field_profile_status="missing"
        field_autoconnect="unknown"
        field_iface="unknown"
        field_wifi_mode="unknown"
        field_ipv4_method="unknown"
        field_ipv4_addresses="unknown"
        field_ipv6_method="unknown"
    fi

    if [[ -e "$FIELD_MARKER" ]]; then
        marker_status="present"
    else
        marker_status="absent"
    fi

    echo
    echo "============================================================"
    echo "              WARPi ENTER FIELD PLAN"
    echo "============================================================"
    echo
    echo "Dry run only. No files, services, routes, radios, or NetworkManager profiles were changed."
    echo
    echo "CURRENT STATE"
    echo "------------------------------------------------------------"
    printf "%-22s %s\n" "Mode:" "$mode"
    printf "%-22s %s\n" "State:" "$state"
    printf "%-22s %s\n" "Reason:" "$reason"
    printf "%-22s %s\n" "Field mode:" "$field_mode"
    printf "%-22s %s\n" "Active profile:" "$active_profile"
    printf "%-22s %s\n" "Active SSID:" "$active_ssid"
    printf "%-22s %s\n" "KERNEL service:" "$service_status"
    printf "%-22s %s\n" "SSH service:" "$ssh_status"
    printf "%-22s %s\n" "Kismet service:" "$kismet_status"
    printf "%-22s %s\n" "Tailscale connected:" "$tailscale_status"
    echo
    echo "FIELD PROFILE"
    echo "------------------------------------------------------------"
    printf "%-22s %s\n" "Name:" "$FIELD_PROFILE"
    printf "%-22s %s\n" "Status:" "$field_profile_status"
    printf "%-22s %s\n" "Interface:" "$field_iface"
    printf "%-22s %s\n" "Autoconnect:" "$field_autoconnect"
    printf "%-22s %s\n" "Wi-Fi mode:" "$field_wifi_mode"
    printf "%-22s %s\n" "IPv4 method:" "$field_ipv4_method"
    printf "%-22s %s\n" "IPv4 address:" "$field_ipv4_addresses"
    printf "%-22s %s\n" "IPv6 method:" "$field_ipv6_method"
    printf "%-22s %s\n" "Field marker:" "$marker_status ($FIELD_MARKER)"
    transition_dry_run_summary "NORMAL -> FIELD" "$mode" "FIELD"
    echo
    echo "PROPOSED APPLY SEQUENCE"
    echo "------------------------------------------------------------"
    echo "1. Confirm local/console recovery and authorized field profile."
    echo "2. Run field preparation checks for NetworkManager, SSH, IPv4 forwarding, and firewall rules."
    echo "3. Bring up NetworkManager profile: $FIELD_PROFILE."
    echo "4. Create field marker: $FIELD_MARKER."
    echo "5. Start or validate field services such as SSH and Kismet."
    echo "6. Wait for /run/warpi/state.json to report FIELD or a clear degraded state."
    echo "7. Verify operator access path before considering the transition complete."
    echo
    echo "ROLLBACK EXPECTATION"
    echo "------------------------------------------------------------"
    echo "A future return-normal command should bring trusted Wi-Fi back up, remove the field marker, stop field-only services when appropriate, and verify NORMAL/CONNECTED or a clear degraded state."
    echo
    echo "NEXT ENABLEMENT GATE"
    echo "------------------------------------------------------------"
    echo "Implement apply mode only after this plan matches the real field workflow and recovery path."
    echo
    echo "============================================================"
}

mode_return_normal_plan() {
    require_state

    FIELD_PROFILE="$(config_value FIELD_PROFILE "$FIELD_PROFILE")"
    FIELD_MARKER="$(config_value FIELD_MARKER "$FIELD_MARKER")"

    local mode state reason field_mode active_profile active_ssid service_status
    local field_profile_status field_autoconnect field_iface field_wifi_mode
    local field_ipv4_method field_ipv4_addresses field_ipv6_method marker_status
    local ssh_status kismet_status tailscale_status

    mode="$(json_value '.mode')"
    state="$(json_value '.state')"
    reason="$(json_value '.reason')"
    field_mode="$(json_bool '.network.field_mode')"
    active_profile="$(json_value '.network.wifi_profile' 'none')"
    active_ssid="$(json_value '.network.wifi_ssid' 'none')"
    service_status="$(systemctl is-active "$KERNEL_SERVICE" 2>/dev/null || true)"
    ssh_status="$(systemctl is-active ssh.service 2>/dev/null || true)"
    kismet_status="$(systemctl is-active kismet.service 2>/dev/null || true)"
    tailscale_status="$(json_bool '.network.tailscale')"

    if nmcli connection show "$FIELD_PROFILE" >/dev/null 2>&1; then
        field_profile_status="present"
        field_autoconnect="$(nmcli -g connection.autoconnect connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_iface="$(nmcli -g connection.interface-name connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_wifi_mode="$(nmcli -g 802-11-wireless.mode connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv4_method="$(nmcli -g ipv4.method connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv4_addresses="$(nmcli -g ipv4.addresses connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
        field_ipv6_method="$(nmcli -g ipv6.method connection show "$FIELD_PROFILE" 2>/dev/null || echo unknown)"
    else
        field_profile_status="missing"
        field_autoconnect="unknown"
        field_iface="unknown"
        field_wifi_mode="unknown"
        field_ipv4_method="unknown"
        field_ipv4_addresses="unknown"
        field_ipv6_method="unknown"
    fi

    if [[ -e "$FIELD_MARKER" ]]; then
        marker_status="present"
    else
        marker_status="absent"
    fi

    echo
    echo "============================================================"
    echo "             WARPi RETURN NORMAL PLAN"
    echo "============================================================"
    echo
    echo "Dry run only. No files, services, routes, radios, or NetworkManager profiles were changed."
    echo
    echo "CURRENT STATE"
    echo "------------------------------------------------------------"
    printf "%-22s %s\n" "Mode:" "$mode"
    printf "%-22s %s\n" "State:" "$state"
    printf "%-22s %s\n" "Reason:" "$reason"
    printf "%-22s %s\n" "Field mode:" "$field_mode"
    printf "%-22s %s\n" "Active profile:" "$active_profile"
    printf "%-22s %s\n" "Active SSID:" "$active_ssid"
    printf "%-22s %s\n" "KERNEL service:" "$service_status"
    printf "%-22s %s\n" "SSH service:" "$ssh_status"
    printf "%-22s %s\n" "Kismet service:" "$kismet_status"
    printf "%-22s %s\n" "Tailscale connected:" "$tailscale_status"
    echo
    echo "FIELD PROFILE"
    echo "------------------------------------------------------------"
    printf "%-22s %s\n" "Name:" "$FIELD_PROFILE"
    printf "%-22s %s\n" "Status:" "$field_profile_status"
    printf "%-22s %s\n" "Interface:" "$field_iface"
    printf "%-22s %s\n" "Autoconnect:" "$field_autoconnect"
    printf "%-22s %s\n" "Wi-Fi mode:" "$field_wifi_mode"
    printf "%-22s %s\n" "IPv4 method:" "$field_ipv4_method"
    printf "%-22s %s\n" "IPv4 address:" "$field_ipv4_addresses"
    printf "%-22s %s\n" "IPv6 method:" "$field_ipv6_method"
    printf "%-22s %s\n" "Field marker:" "$marker_status ($FIELD_MARKER)"
    transition_dry_run_summary "FIELD -> NORMAL" "$mode" "NORMAL"
    echo
    echo "PROPOSED RETURN SEQUENCE"
    echo "------------------------------------------------------------"
    echo "1. Confirm local/console recovery and trusted network credentials."
    echo "2. Stop or validate field-only services according to the approved recovery plan."
    echo "3. Bring trusted client networking back up before removing the field access path."
    echo "4. Remove field marker if present: $FIELD_MARKER."
    echo "5. Ensure NetworkManager profile $FIELD_PROFILE is not left autoconnecting."
    echo "6. Wait for /run/warpi/state.json to report NORMAL/CONNECTED or a clear degraded state."
    echo "7. Verify operator access path before considering the return complete."
    echo
    echo "NEXT ENABLEMENT GATE"
    echo "------------------------------------------------------------"
    echo "Implement apply mode only after this return workflow and recovery path are validated."
    echo
    echo "============================================================"
}

wireless_status() {
    local interface="${WARPI_NANO_INTERFACE:-$NANO_INTERFACE}"
    local host="${WARPI_NANO_HOST:-$NANO_HOST}"
    local port="${WARPI_NANO_UI_PORT:-$NANO_UI_PORT}"
    local link_state addr route default_route default_iface default_ok
    local ping_status tcp_status nm_state nm_connection wireless_actions

    link_state="$(ip -br link show "$interface" 2>/dev/null | awk '{print $2}' || true)"
    addr="$(ip -br addr show "$interface" 2>/dev/null | awk '{print $3}' || true)"
    route="$(ip route get "$host" 2>/dev/null | head -n 1 || true)"
    default_route="$(ip route show default 2>/dev/null | head -n 1 || true)"
    default_iface="$(awk '{for (i = 1; i <= NF; i++) if ($i == "dev") print $(i + 1)}' <<<"$default_route" | head -n 1)"
    nm_state="$(nmcli -t -f GENERAL.STATE device show "$interface" 2>/dev/null | cut -d: -f2- || true)"
    nm_connection="$(nmcli -t -f GENERAL.CONNECTION device show "$interface" 2>/dev/null | cut -d: -f2- || true)"
    wireless_actions="disabled"

    if [[ -z "$link_state" ]]; then
        link_state="missing"
    fi
    if [[ -z "$addr" ]]; then
        addr="none"
    fi
    if [[ -z "$route" ]]; then
        route="none"
    fi
    if [[ -z "$default_route" ]]; then
        default_route="none"
    fi
    if [[ -z "$default_iface" ]]; then
        default_iface="unknown"
    fi
    if [[ -z "$nm_state" ]]; then
        nm_state="unknown"
    fi
    if [[ -z "$nm_connection" ]]; then
        nm_connection="unknown"
    fi

    if [[ "$default_iface" == "$interface" ]]; then
        default_ok="NO"
    else
        default_ok="YES"
    fi

    if ping -c 1 -W 2 "$host" >/dev/null 2>&1; then
        ping_status="reachable"
    else
        ping_status="unreachable"
    fi

    if timeout 4 bash -c ":</dev/tcp/$host/$port" >/dev/null 2>&1; then
        tcp_status="open"
    else
        tcp_status="closed-or-unreachable"
    fi

    echo
    echo "============================================================"
    echo "              WARPi WIRELESS SIDECAR"
    echo "============================================================"
    echo
    echo "Read-only status. No scans, radios, routes, services, or NANO settings were changed."
    echo
    printf "%-24s %s\n" "Sidecar target:" "$host:$port"
    printf "%-24s %s\n" "Interface:" "$interface"
    printf "%-24s %s\n" "Link state:" "$link_state"
    printf "%-24s %s\n" "Address:" "$addr"
    printf "%-24s %s\n" "NetworkManager state:" "$nm_state"
    printf "%-24s %s\n" "NetworkManager conn:" "$nm_connection"
    printf "%-24s %s\n" "Route to sidecar:" "$route"
    printf "%-24s %s\n" "Ping:" "$ping_status"
    printf "%-24s %s\n" "UI TCP $port:" "$tcp_status"
    printf "%-24s %s\n" "Default route:" "$default_route"
    printf "%-24s %s\n" "Default avoids sidecar:" "$default_ok"
    printf "%-24s %s\n" "Wireless actions:" "$wireless_actions"
    echo
    echo "============================================================"
}

case "${1:-help}" in
    help|-h|--help)
        usage
        ;;
    status)
        exec warpi-status
        ;;
    mode)
        case "${2:-status}" in
            status)
                mode_status
                ;;
            transition-status)
                case "${3:-}" in
                    ""|--human)
                        transition_status "$(transition_status_values)"
                        ;;
                    --json)
                        transition_status_json
                        ;;
                    *)
                        echo "Unknown transition-status option: $3" >&2
                        echo "Try: warpi mode transition-status" >&2
                        exit 2
                        ;;
                esac
                ;;
            enter-field)
                case "${3:-}" in
                    ""|--plan|--dry-run)
                        mode_enter_field_plan
                        ;;
                    --apply)
                        echo "warpi mode enter-field --apply is not enabled yet; dry-run only." >&2
                        exit 2
                        ;;
                    *)
                        echo "Unknown enter-field option: $3" >&2
                        echo "Try: warpi mode enter-field" >&2
                        exit 2
                        ;;
                esac
                ;;
            help|-h|--help)
                usage
                ;;
            return-normal)
                case "${3:-}" in
                    ""|--plan|--dry-run)
                        mode_return_normal_plan
                        ;;
                    --apply)
                        echo "warpi mode return-normal --apply is not enabled yet; dry-run only." >&2
                        exit 2
                        ;;
                    *)
                        echo "Unknown return-normal option: $3" >&2
                        echo "Try: warpi mode return-normal" >&2
                        exit 2
                        ;;
                esac
                ;;
            *)
                echo "Unknown mode command: ${2:-}" >&2
                echo "Try: warpi mode status" >&2
                exit 2
                ;;
        esac
        ;;
    wireless)
        case "${2:-status}" in
            status)
                wireless_status
                ;;
            help|-h|--help)
                usage
                ;;
            *)
                echo "Unknown wireless command: ${2:-}" >&2
                echo "Try: warpi wireless status" >&2
                exit 2
                ;;
        esac
        ;;
    field)
        case "${2:-health}" in
            health)
                exec warpi-field-health
                ;;
            setup)
                if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
                    exec sudo -n warpi-field-setup
                fi
                exec warpi-field-setup
                ;;
            help|-h|--help)
                usage
                ;;
            *)
                echo "Unknown field command: ${2:-}" >&2
                echo "Try: warpi field health" >&2
                exit 2
                ;;
        esac
        ;;
    report)
        exec kernel-report --json
        ;;
    docs)
        case "${2:-audit}" in
            audit)
                if [[ ! -r /opt/warpi/docs ]] && sudo -n true 2>/dev/null; then
                    exec sudo -n kernel-doc-audit --json
                fi
                exec kernel-doc-audit --json
                ;;
            help|-h|--help)
                usage
                ;;
            *)
                echo "Unknown docs command: ${2:-}" >&2
                echo "Try: warpi docs audit" >&2
                exit 2
                ;;
        esac
        ;;
    *)
        echo "Unknown command: ${1:-}" >&2
        echo "Try: warpi help" >&2
        exit 2
        ;;
esac
