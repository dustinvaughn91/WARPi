#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
SOURCE_DIR="${WARPI_DOC_SOURCE:-$REPO_ROOT/docs}"
DEST_DIR="${WARPI_DOC_DEST:-/opt/warpi/docs}"
OWNER="${WARPI_DOC_OWNER:-root}"
GROUP="${WARPI_DOC_GROUP:-warpi-docs}"
DIR_MODE="${WARPI_DOC_DIR_MODE:-750}"
FILE_MODE="${WARPI_DOC_FILE_MODE:-640}"

usage() {
    cat >&2 <<'USAGE'
Usage: warpi-docs-sync [--source PATH] [--dest PATH]

Synchronize canonical WARPi repository documentation into the live
/opt/warpi/docs view and write .warpi-docs-manifest.sha256 for drift audit.
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --source)
            SOURCE_DIR="${2:-}"
            shift 2
            ;;
        --dest)
            DEST_DIR="${2:-}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 2
            ;;
    esac
done

if [[ -z "$SOURCE_DIR" || -z "$DEST_DIR" || ! -d "$SOURCE_DIR" ]]; then
    echo "warpi-docs-sync: source documentation directory not found" >&2
    exit 1
fi

if [[ "$(id -u)" -ne 0 && ! -w "$(dirname "$DEST_DIR")" ]]; then
    echo "warpi-docs-sync: destination requires root or write permission" >&2
    exit 1
fi

DEST_PARENT="$(dirname "$DEST_DIR")"
DEST_BASE="$(basename "$DEST_DIR")"
TMP_DIR="$(mktemp -d "$DEST_PARENT/.${DEST_BASE}.sync.XXXXXX")"

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

mkdir -p "$TMP_DIR"

(
    cd "$SOURCE_DIR"
    tar --exclude='.warpi-docs-manifest.sha256' -cf - .
) | (
    cd "$TMP_DIR"
    tar -xf -
)

(
    cd "$TMP_DIR"
    find . -type f ! -name '.warpi-docs-manifest.sha256' -print0 |
        sort -z |
        xargs -0 sha256sum |
        sed 's#  ./#  #' > .warpi-docs-manifest.sha256
)

install -d -o "$OWNER" -g "$GROUP" -m "$DIR_MODE" "$DEST_DIR"

find "$DEST_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} +

(
    cd "$TMP_DIR"
    find . -type d -print0 |
        while IFS= read -r -d '' path; do
            target="$DEST_DIR/${path#./}"
            if [[ "$path" != "." ]]; then
                install -d -o "$OWNER" -g "$GROUP" -m "$DIR_MODE" "$target"
            fi
        done

    find . -type f -print0 |
        while IFS= read -r -d '' path; do
            target="$DEST_DIR/${path#./}"
            install -o "$OWNER" -g "$GROUP" -m "$FILE_MODE" "$path" "$target"
        done
)

echo "Synchronized WARPi docs from $SOURCE_DIR to $DEST_DIR"
